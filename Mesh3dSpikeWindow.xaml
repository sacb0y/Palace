<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Palace.Mesh3dSpikeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Palace 3D spike (dev)">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock
            Margin="16,12,16,8"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="Diligent D3D12 · SwapChainPanel · glTF PBR+IBL (dev flag)" />
        <SwapChainPanel
            x:Name="ScpMesh3d"
            Grid.Row="1"
            Margin="16,0,16,8"
            AutomationProperties.AutomationId="ScpMesh3dSpike"
            CompositionScaleChanged="ScpMesh3d_CompositionScaleChanged"
            SizeChanged="ScpMesh3d_SizeChanged" />
        <StackPanel Grid.Row="2" Margin="16,0,16,16" Spacing="4">
            <TextBlock
                x:Name="TxtMesh3dStatus"
                AutomationProperties.AutomationId="TxtMesh3dSpikeStatus"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="WrapWholeWords" />
            <TextBlock
                x:Name="TxtMesh3dProbe"
                AutomationProperties.AutomationId="TxtMesh3dSpikeProbe"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="WrapWholeWords" />
        </StackPanel>
    </Grid>
</Window>
