<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Palace.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Palace"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Palace"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Palace">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Grid Grid.Row="1">
            <Frame x:Name="RootFrame" />
            <StackPanel
                x:Name="StartupPane"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressBar
                    x:Name="PrgStartup"
                    Width="240"
                    Height="4"
                    AutomationProperties.AutomationId="PrgStartup"
                    AutomationProperties.Name="Starting Palace"
                    IsIndeterminate="True"
                    ShowPaused="False" />
                <TextBlock
                    x:Name="TxtStartup"
                    AutomationProperties.AutomationId="TxtStartup"
                    Text="Loading…" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
