<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Palace.Controls.ViewerDetailsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Palace.Controls"
    xmlns:helpers="using:Palace.Helpers"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:models="using:Palace.Models"
    x:Name="Root"
    Width="270"
    HorizontalAlignment="Left"
    VerticalAlignment="Top"
    RequestedTheme="Dark"
    IsTabStop="False">
    <UserControl.Resources>
        <Style x:Key="ViewerDetailsExpanderStyle" TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0,0,0,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="ViewerDetailsSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ViewerDetailsInlineStatStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="ViewerDetailsIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
    </UserControl.Resources>
    <!--
      Host must stay hit-testable. IsHitTestVisible=False on GrdCardHost made every
      child (footer, copy icons, close, expander toggles) ignore pointer input — WinUI
      does not let a child True override a parent False. The 0.2.0 floating stretch
      host used False for click-through; in-flow left dock is only panel-wide, so
      True is correct.
    -->
    <Grid
        x:Name="GrdCardHost"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top"
        IsHitTestVisible="True"
        SizeChanged="GrdCardHost_SizeChanged">
        <Border
            x:Name="BrdDetailsCard"
            Width="270"
            MinWidth="240"
            MaxWidth="320"
            Margin="0"
            Padding="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            AutomationProperties.AutomationId="BrdViewerDetailsCard"
            Background="{ThemeResource ViewerDetailsSurfaceBrush}"
            BorderBrush="{ThemeResource ViewerDetailsBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            IsHitTestVisible="True"
            Opacity="0"
            PointerEntered="BrdDetailsCard_PointerEntered"
            PointerExited="BrdDetailsCard_PointerExited"
            Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title + copy name + close (filename once) -->
                <Grid Padding="8,4,4,2" ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="TxtDetailsTitle"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="TxtViewerDetailsTitle"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{x:Bind Gallery.InfoFileNameEllipsis, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Gallery.InfoFileName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <Button
                        Grid.Column="1"
                        Style="{StaticResource ViewerDetailsIconButtonStyle}"
                        AutomationProperties.AutomationId="BtnViewerDetailsCopyName"
                        AutomationProperties.Name="Copy file name"
                        Command="{x:Bind Gallery.CopyFileNameCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="Copy file name">
                        <ic:FluentIcon Icon="Copy" IconSize="Size16" IconVariant="Regular" />
                    </Button>
                    <Button
                        x:Name="BtnDetailsClose"
                        Grid.Column="2"
                        Style="{StaticResource ViewerDetailsIconButtonStyle}"
                        AutomationProperties.AutomationId="BtnViewerDetailsClose"
                        AutomationProperties.Name="Close details"
                        Click="BtnDetailsClose_Click"
                        ToolTipService.ToolTip="Close (Esc)">
                        <ic:FluentIcon Icon="Dismiss" IconSize="Size16" IconVariant="Regular" />
                    </Button>
                </Grid>

                <ScrollViewer
                    x:Name="ScrDetails"
                    Grid.Row="1"
                    AutomationProperties.AutomationId="ScrViewerDetails"
                    HorizontalScrollBarVisibility="Disabled"
                    PointerWheelChanged="ScrDetails_PointerWheelChanged"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Enabled">
                    <StackPanel x:Name="PnlSections" Padding="8,0,8,4" Spacing="0">
                        <!-- FILE: path+icons; meta line (name lives in title) -->
                        <Expander
                            x:Name="ExpFile"
                            Style="{StaticResource ViewerDetailsExpanderStyle}"
                            AutomationProperties.AutomationId="ExpDetailsFile"
                            ExpandDirection="Down"
                            IsExpanded="True"
                            Tag="file">
                            <Expander.Header>
                                <TextBlock Style="{StaticResource ViewerDetailsSectionHeaderStyle}" Text="File" />
                            </Expander.Header>
                            <StackPanel Spacing="2">
                                <Grid ColumnSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="TxtViewerDetailsPath"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        FontSize="11"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Gallery.InfoPathEllipsis, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind Gallery.InfoPath, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoPath), Mode=OneWay}" />
                                    <Button
                                        Grid.Column="1"
                                        Style="{StaticResource ViewerDetailsIconButtonStyle}"
                                        AutomationProperties.AutomationId="BtnViewerDetailsCopyPath"
                                        AutomationProperties.Name="Copy path"
                                        Command="{x:Bind Gallery.CopyPathCommand, Mode=OneWay}"
                                        ToolTipService.ToolTip="Copy path"
                                        Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoPath), Mode=OneWay}">
                                        <ic:FluentIcon Icon="Copy" IconSize="Size16" IconVariant="Regular" />
                                    </Button>
                                    <Button
                                        Grid.Column="2"
                                        Style="{StaticResource ViewerDetailsIconButtonStyle}"
                                        AutomationProperties.AutomationId="BtnViewerDetailsShowFolder"
                                        AutomationProperties.Name="Show in Explorer"
                                        Command="{x:Bind Gallery.OpenInExplorerCommand, Mode=OneWay}"
                                        ToolTipService.ToolTip="Show in Explorer"
                                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(Gallery.CanOpenInExplorer), Mode=OneWay}">
                                        <ic:FluentIcon Icon="FolderOpen" IconSize="Size16" IconVariant="Regular" />
                                    </Button>
                                </Grid>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    FontSize="11"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Gallery.InfoFileMetaLine, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoFileMetaLine), Mode=OneWay}" />
                            </StackPanel>
                        </Expander>

                        <!-- COLOR & HDR — inline label+value, 2-col, no empty rows -->
                        <Expander
                            x:Name="ExpColorHdr"
                            Style="{StaticResource ViewerDetailsExpanderStyle}"
                            AutomationProperties.AutomationId="ExpDetailsColorHdr"
                            ExpandDirection="Down"
                            IsExpanded="True"
                            Tag="colorhdr"
                            Visibility="Collapsed">
                            <Expander.Header>
                                <TextBlock Style="{StaticResource ViewerDetailsSectionHeaderStyle}" Text="Color &amp; HDR" />
                            </Expander.Header>
                            <Grid ColumnSpacing="6" RowSpacing="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoColor), Mode=OneWay}">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource ViewerDetailsInlineStatStyle}" Text="Color" />
                                    <TextBlock FontWeight="Bold" Style="{StaticResource ViewerDetailsInlineStatStyle}" Text="{x:Bind Gallery.InfoColor, Mode=OneWay}" />
                                </StackPanel>
                                <!-- Full-width HDR row so "OpenEXR · tonemap SDR 80 nits" is not truncated. -->
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    ToolTipService.ToolTip="{x:Bind Gallery.InfoHdrStatus, Mode=OneWay}"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoHdrStatus), Mode=OneWay}">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource ViewerDetailsInlineStatStyle}" Text="HDR" />
                                    <TextBlock
                                        FontWeight="Bold"
                                        Style="{StaticResource ViewerDetailsInlineStatStyle}"
                                        Text="{x:Bind Gallery.InfoHdrStatus, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="2"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoMaxCll), Mode=OneWay}">
                                    <!-- scRGB channel peak (1.0 = 80 nits), not cLLi metadata nits — matches ImageInfoText "MaxCLL (scRGB)". -->
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource ViewerDetailsInlineStatStyle}" Text="MaxCLL (scRGB)" />
                                    <TextBlock FontWeight="Bold" Style="{StaticResource ViewerDetailsInlineStatStyle}" Text="{x:Bind Gallery.InfoMaxCll, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoFall), Mode=OneWay}">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource ViewerDetailsInlineStatStyle}" Text="FALL" />
                                    <TextBlock FontWeight="Bold" Style="{StaticResource ViewerDetailsInlineStatStyle}" Text="{x:Bind Gallery.InfoFall, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="3"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoMaxLum), Mode=OneWay}">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource ViewerDetailsInlineStatStyle}" Text="Max" />
                                    <TextBlock FontWeight="Bold" Style="{StaticResource ViewerDetailsInlineStatStyle}" Text="{x:Bind Gallery.InfoMaxLum, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoAvgLum), Mode=OneWay}">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource ViewerDetailsInlineStatStyle}" Text="Avg" />
                                    <TextBlock FontWeight="Bold" Style="{StaticResource ViewerDetailsInlineStatStyle}" Text="{x:Bind Gallery.InfoAvgLum, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="4"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoMinLum), Mode=OneWay}">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource ViewerDetailsInlineStatStyle}" Text="Min" />
                                    <TextBlock FontWeight="Bold" Style="{StaticResource ViewerDetailsInlineStatStyle}" Text="{x:Bind Gallery.InfoMinLum, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoP99), Mode=OneWay}">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource ViewerDetailsInlineStatStyle}" Text="P99" />
                                    <TextBlock FontWeight="Bold" Style="{StaticResource ViewerDetailsInlineStatStyle}" Text="{x:Bind Gallery.InfoP99, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="5"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoAboveSdr), Mode=OneWay}">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource ViewerDetailsInlineStatStyle}" Text="Above SDR" />
                                    <TextBlock FontWeight="Bold" Style="{StaticResource ViewerDetailsInlineStatStyle}" Text="{x:Bind Gallery.InfoAboveSdr, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoDisplayLum), Mode=OneWay}">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource ViewerDetailsInlineStatStyle}" Text="Display" />
                                    <TextBlock FontWeight="Bold" Style="{StaticResource ViewerDetailsInlineStatStyle}" Text="{x:Bind Gallery.InfoDisplayLum, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </Expander>

                        <!-- HISTOGRAM — compact ~90px -->
                        <Expander
                            x:Name="ExpHistogram"
                            Style="{StaticResource ViewerDetailsExpanderStyle}"
                            AutomationProperties.AutomationId="ExpDetailsHistogram"
                            ExpandDirection="Down"
                            IsExpanded="True"
                            Tag="histogram"
                            Visibility="Collapsed">
                            <Expander.Header>
                                <TextBlock Style="{StaticResource ViewerDetailsSectionHeaderStyle}" Text="Histogram" />
                            </Expander.Header>
                            <Border Padding="0" Background="{ThemeResource ViewerDetailsPlotBrush}" CornerRadius="4">
                                <controls:GalleryHistogramChart
                                    Compact="True"
                                    IdPrefix="ViewerDetails"
                                    Bins="{x:Bind Gallery.Histogram, Mode=OneWay}"
                                    Details="{x:Bind Gallery.DetailsRows, Mode=OneWay}"
                                    Heatmap="{x:Bind Gallery.HeatmapActive, Mode=OneWay}"
                                    ShowLuma="{x:Bind Gallery.HistogramShowLuma, Mode=TwoWay}"
                                    ShowRgb="{x:Bind Gallery.HistogramShowRgb, Mode=TwoWay}"
                                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(Gallery.ShowHistogram), Mode=OneWay}" />
                            </Border>
                        </Expander>

                        <Expander
                            x:Name="ExpGamut"
                            Style="{StaticResource ViewerDetailsExpanderStyle}"
                            AutomationProperties.AutomationId="ExpDetailsGamut"
                            ExpandDirection="Down"
                            IsExpanded="True"
                            Tag="gamut"
                            Visibility="Collapsed">
                            <Expander.Header>
                                <TextBlock Style="{StaticResource ViewerDetailsSectionHeaderStyle}" Text="Gamut · CIE 1931 xy" />
                            </Expander.Header>
                            <Border Padding="0" Background="{ThemeResource ViewerDetailsPlotBrush}" CornerRadius="4">
                                <controls:GalleryGamutChart
                                    Analysis="{x:Bind Gallery.Analysis, Mode=OneWay}"
                                    Compact="True"
                                    IdPrefix="ViewerDetails"
                                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(Gallery.ShowGamut), Mode=OneWay}" />
                            </Border>
                        </Expander>

                        <Expander
                            x:Name="ExpVideo"
                            Style="{StaticResource ViewerDetailsExpanderStyle}"
                            AutomationProperties.AutomationId="ExpDetailsVideo"
                            ExpandDirection="Down"
                            IsExpanded="True"
                            Tag="video"
                            Visibility="Collapsed">
                            <Expander.Header>
                                <TextBlock Style="{StaticResource ViewerDetailsSectionHeaderStyle}" Text="Media" />
                            </Expander.Header>
                            <StackPanel Spacing="2">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoVideoDuration), Mode=OneWay}">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource ViewerDetailsInlineStatStyle}" Text="Duration" />
                                    <TextBlock FontWeight="Bold" Style="{StaticResource ViewerDetailsInlineStatStyle}" Text="{x:Bind Gallery.InfoVideoDuration, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoVideoSize), Mode=OneWay}">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource ViewerDetailsInlineStatStyle}" Text="Size" />
                                    <TextBlock FontWeight="Bold" Style="{StaticResource ViewerDetailsInlineStatStyle}" Text="{x:Bind Gallery.InfoVideoSize, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock
                                    AutomationProperties.AutomationId="TxtViewerVideoDetails"
                                    FontSize="11"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Gallery.DetailsText, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.DetailsText), Mode=OneWay}" />
                            </StackPanel>
                        </Expander>

                        <Expander
                            x:Name="ExpTags"
                            Style="{StaticResource ViewerDetailsExpanderStyle}"
                            AutomationProperties.AutomationId="ExpDetailsTags"
                            ExpandDirection="Down"
                            IsExpanded="True"
                            Tag="tags">
                            <Expander.Header>
                                <TextBlock Style="{StaticResource ViewerDetailsSectionHeaderStyle}" Text="Tags" />
                            </Expander.Header>
                            <ItemsRepeater
                                x:Name="LstDetailsTags"
                                AutomationProperties.AutomationId="LstViewerDetailsTags"
                                AutomationProperties.Name="Tags"
                                ItemsSource="{x:Bind Gallery.Tags, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <helpers:ChipWrapLayout HorizontalSpacing="4" VerticalSpacing="2" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:AssignedTagItem">
                                        <Border
                                            MinWidth="0"
                                            Padding="4,1"
                                            HorizontalAlignment="Left"
                                            Background="{x:Bind helpers:TagColor.ChipFill(EffectiveColor), Mode=OneWay}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            Opacity="{x:Bind ChromeOpacity, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ChipTooltip, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{x:Bind helpers:TagColor.ChipInk(EffectiveColor), Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind TagName, Mode=OneWay}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{x:Bind helpers:TagColor.ChipInk(EffectiveColor), Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind CountLabel, Mode=OneWay}"
                                                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsPartial), Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Expander>

                        <Expander
                            x:Name="ExpGeneration"
                            Style="{StaticResource ViewerDetailsExpanderStyle}"
                            AutomationProperties.AutomationId="ExpDetailsGeneration"
                            ExpandDirection="Down"
                            IsExpanded="False"
                            Tag="generation"
                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(Gallery.ShowGeneration), Mode=OneWay}">
                            <Expander.Header>
                                <TextBlock Style="{StaticResource ViewerDetailsSectionHeaderStyle}" Text="Generation" />
                            </Expander.Header>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    AutomationProperties.AutomationId="TxtViewerDetailsModel"
                                    FontSize="11"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind helpers:BindHelpers.OrDash(Gallery.PreviewModel), Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Prompt" />
                                <TextBlock
                                    AutomationProperties.AutomationId="TxtViewerDetailsPrompt"
                                    FontSize="11"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind helpers:BindHelpers.OrDash(Gallery.PreviewPrompt), Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Negative" />
                                <TextBlock
                                    FontSize="11"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind helpers:BindHelpers.OrDash(Gallery.PreviewNegative), Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Seed" />
                                <TextBlock
                                    FontSize="11"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind helpers:BindHelpers.OrDash(Gallery.PreviewSeed), Mode=OneWay}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer ~28px: icon + short labels -->
                <Grid
                    Grid.Row="2"
                    Height="28"
                    Padding="4,0"
                    ColumnSpacing="2"
                    BorderBrush="{ThemeResource ViewerDetailsBorderBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Padding="2,0"
                        AutomationProperties.AutomationId="BtnViewerDetailsFooterCopyPath"
                        AutomationProperties.Name="Copy path"
                        Command="{x:Bind Gallery.CopyPathCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="Copy path">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                            <ic:FluentIcon Icon="Copy" IconSize="Size16" IconVariant="Regular" />
                            <TextBlock VerticalAlignment="Center" FontSize="11" Text="Copy" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Padding="2,0"
                        AutomationProperties.AutomationId="BtnViewerDetailsFooterExplorer"
                        AutomationProperties.Name="Show in Explorer"
                        Command="{x:Bind Gallery.OpenInExplorerCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind Gallery.CanOpenInExplorer, Mode=OneWay}"
                        ToolTipService.ToolTip="Show in Explorer">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                            <ic:FluentIcon Icon="FolderOpen" IconSize="Size16" IconVariant="Regular" />
                            <TextBlock VerticalAlignment="Center" FontSize="11" Text="Explorer" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Padding="2,0"
                        AutomationProperties.AutomationId="BtnViewerDetailsFooterOpenWith"
                        AutomationProperties.Name="Open with"
                        Command="{x:Bind Gallery.OpenWithCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind Gallery.CanOpenInExplorer, Mode=OneWay}"
                        ToolTipService.ToolTip="Open with default app">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                            <ic:FluentIcon Icon="Open" IconSize="Size16" IconVariant="Regular" />
                            <TextBlock VerticalAlignment="Center" FontSize="11" Text="Open" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
