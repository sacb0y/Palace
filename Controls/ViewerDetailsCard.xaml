<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Palace.Controls.ViewerDetailsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Palace.Controls"
    xmlns:helpers="using:Palace.Helpers"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:models="using:Palace.Models"
    x:Name="Root"
    RequestedTheme="Dark"
    IsTabStop="False">
    <UserControl.Resources>
        <!-- Compact section headers: shrink default Expander chrome. -->
        <Style x:Key="ViewerDetailsExpanderStyle" TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0,2,0,4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="ViewerDetailsSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ViewerDetailsStatLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="ViewerDetailsStatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Resources>
    <Grid
        x:Name="GrdCardHost"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        IsHitTestVisible="False"
        SizeChanged="GrdCardHost_SizeChanged">
        <Border
            x:Name="BrdDetailsCard"
            Width="270"
            MinWidth="240"
            MaxWidth="320"
            Margin="16,56,16,16"
            Padding="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            AutomationProperties.AutomationId="BrdViewerDetailsCard"
            Background="{ThemeResource ViewerDetailsSurfaceBrush}"
            BorderBrush="{ThemeResource ViewerDetailsBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            IsHitTestVisible="True"
            Opacity="0"
            PointerEntered="BrdDetailsCard_PointerEntered"
            PointerExited="BrdDetailsCard_PointerExited"
            Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: title + close -->
                <Grid Padding="8,6,4,4" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="TxtDetailsTitle"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="TxtViewerDetailsTitle"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Gallery.InfoFileNameEllipsis, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Gallery.InfoFileName, Mode=OneWay}"
                        TextWrapping="NoWrap" />
                    <Button
                        x:Name="BtnDetailsClose"
                        Grid.Column="1"
                        Width="28"
                        Height="28"
                        Padding="0"
                        AutomationProperties.AutomationId="BtnViewerDetailsClose"
                        AutomationProperties.Name="Close details"
                        Click="BtnDetailsClose_Click"
                        ToolTipService.ToolTip="Close (Esc)">
                        <ic:FluentIcon Icon="Dismiss" IconSize="Size16" IconVariant="Regular" />
                    </Button>
                </Grid>

                <ScrollViewer
                    x:Name="ScrDetails"
                    Grid.Row="1"
                    AutomationProperties.AutomationId="ScrViewerDetails"
                    HorizontalScrollBarVisibility="Disabled"
                    PointerWheelChanged="ScrDetails_PointerWheelChanged"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Enabled">
                    <StackPanel x:Name="PnlSections" Padding="8,0,8,6" Spacing="0">
                        <!-- FILE — three lines: name; path+icons; size · res | format · frame -->
                        <Expander
                            x:Name="ExpFile"
                            Style="{StaticResource ViewerDetailsExpanderStyle}"
                            AutomationProperties.AutomationId="ExpDetailsFile"
                            ExpandDirection="Down"
                            IsExpanded="True"
                            Tag="file">
                            <Expander.Header>
                                <TextBlock Style="{StaticResource ViewerDetailsSectionHeaderStyle}" Text="File" />
                            </Expander.Header>
                            <StackPanel Spacing="4">
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Gallery.InfoFileNameEllipsis, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind Gallery.InfoFileName, Mode=OneWay}"
                                        TextWrapping="NoWrap" />
                                    <Button
                                        Grid.Column="1"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        AutomationProperties.AutomationId="BtnViewerDetailsCopyName"
                                        AutomationProperties.Name="Copy file name"
                                        Command="{x:Bind Gallery.CopyFileNameCommand, Mode=OneWay}"
                                        ToolTipService.ToolTip="Copy file name">
                                        <ic:FluentIcon Icon="Copy" IconSize="Size16" IconVariant="Regular" />
                                    </Button>
                                </Grid>
                                <Grid ColumnSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="TxtViewerDetailsPath"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Gallery.InfoPathEllipsis, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind Gallery.InfoPath, Mode=OneWay}"
                                        TextWrapping="NoWrap"
                                        Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoPath), Mode=OneWay}" />
                                    <Button
                                        Grid.Column="1"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        AutomationProperties.AutomationId="BtnViewerDetailsCopyPath"
                                        AutomationProperties.Name="Copy path"
                                        Command="{x:Bind Gallery.CopyPathCommand, Mode=OneWay}"
                                        ToolTipService.ToolTip="Copy path"
                                        Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoPath), Mode=OneWay}">
                                        <ic:FluentIcon Icon="Copy" IconSize="Size16" IconVariant="Regular" />
                                    </Button>
                                    <Button
                                        Grid.Column="2"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        AutomationProperties.AutomationId="BtnViewerDetailsShowFolder"
                                        AutomationProperties.Name="Show in Explorer"
                                        Command="{x:Bind Gallery.OpenInExplorerCommand, Mode=OneWay}"
                                        ToolTipService.ToolTip="Show in Explorer"
                                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(Gallery.CanOpenInExplorer), Mode=OneWay}">
                                        <ic:FluentIcon Icon="FolderOpen" IconSize="Size16" IconVariant="Regular" />
                                    </Button>
                                </Grid>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Gallery.InfoFileMetaLine, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoFileMetaLine), Mode=OneWay}" />
                            </StackPanel>
                        </Expander>

                        <!-- COLOR & HDR — 2-col, bold values, no empty rows -->
                        <Expander
                            x:Name="ExpColorHdr"
                            Style="{StaticResource ViewerDetailsExpanderStyle}"
                            AutomationProperties.AutomationId="ExpDetailsColorHdr"
                            ExpandDirection="Down"
                            IsExpanded="True"
                            Tag="colorhdr"
                            Visibility="Collapsed">
                            <Expander.Header>
                                <TextBlock Style="{StaticResource ViewerDetailsSectionHeaderStyle}" Text="Color &amp; HDR" />
                            </Expander.Header>
                            <Grid ColumnSpacing="8" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoColor), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource ViewerDetailsStatLabelStyle}" Text="Color" />
                                    <TextBlock Style="{StaticResource ViewerDetailsStatValueStyle}" Text="{x:Bind Gallery.InfoColor, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoHdrStatus), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource ViewerDetailsStatLabelStyle}" Text="HDR" />
                                    <TextBlock Style="{StaticResource ViewerDetailsStatValueStyle}" Text="{x:Bind Gallery.InfoHdrStatus, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="1"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoMaxCll), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource ViewerDetailsStatLabelStyle}" Text="MaxCLL" />
                                    <TextBlock Style="{StaticResource ViewerDetailsStatValueStyle}" Text="{x:Bind Gallery.InfoMaxCll, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoFall), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource ViewerDetailsStatLabelStyle}" Text="FALL" />
                                    <TextBlock Style="{StaticResource ViewerDetailsStatValueStyle}" Text="{x:Bind Gallery.InfoFall, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="2"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoMaxLum), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource ViewerDetailsStatLabelStyle}" Text="Max" />
                                    <TextBlock Style="{StaticResource ViewerDetailsStatValueStyle}" Text="{x:Bind Gallery.InfoMaxLum, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoAvgLum), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource ViewerDetailsStatLabelStyle}" Text="Avg" />
                                    <TextBlock Style="{StaticResource ViewerDetailsStatValueStyle}" Text="{x:Bind Gallery.InfoAvgLum, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="3"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoMinLum), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource ViewerDetailsStatLabelStyle}" Text="Min" />
                                    <TextBlock Style="{StaticResource ViewerDetailsStatValueStyle}" Text="{x:Bind Gallery.InfoMinLum, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoP99), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource ViewerDetailsStatLabelStyle}" Text="P99" />
                                    <TextBlock Style="{StaticResource ViewerDetailsStatValueStyle}" Text="{x:Bind Gallery.InfoP99, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="4"
                                    Grid.ColumnSpan="2"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoAboveSdr), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource ViewerDetailsStatLabelStyle}" Text="Above SDR white" />
                                    <TextBlock Style="{StaticResource ViewerDetailsStatValueStyle}" Text="{x:Bind Gallery.InfoAboveSdr, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="5"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoDisplayLum), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource ViewerDetailsStatLabelStyle}" Text="Display luminance" />
                                    <TextBlock Style="{StaticResource ViewerDetailsStatValueStyle}" Text="{x:Bind Gallery.InfoDisplayLum, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoDisplayProbe), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource ViewerDetailsStatLabelStyle}" Text="Display" />
                                    <TextBlock Style="{StaticResource ViewerDetailsStatValueStyle}" Text="{x:Bind Gallery.InfoDisplayProbe, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Expander>

                        <!-- HISTOGRAM -->
                        <Expander
                            x:Name="ExpHistogram"
                            Style="{StaticResource ViewerDetailsExpanderStyle}"
                            AutomationProperties.AutomationId="ExpDetailsHistogram"
                            ExpandDirection="Down"
                            IsExpanded="True"
                            Tag="histogram"
                            Visibility="Collapsed">
                            <Expander.Header>
                                <TextBlock Style="{StaticResource ViewerDetailsSectionHeaderStyle}" Text="Histogram" />
                            </Expander.Header>
                            <Border
                                Padding="0"
                                Background="{ThemeResource ViewerDetailsPlotBrush}"
                                CornerRadius="4">
                                <controls:GalleryHistogramChart
                                    Compact="True"
                                    IdPrefix="ViewerDetails"
                                    Bins="{x:Bind Gallery.Histogram, Mode=OneWay}"
                                    Details="{x:Bind Gallery.DetailsRows, Mode=OneWay}"
                                    Heatmap="{x:Bind Gallery.HeatmapActive, Mode=OneWay}"
                                    ShowLuma="{x:Bind Gallery.HistogramShowLuma, Mode=TwoWay}"
                                    ShowRgb="{x:Bind Gallery.HistogramShowRgb, Mode=TwoWay}"
                                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(Gallery.ShowHistogram), Mode=OneWay}" />
                            </Border>
                        </Expander>

                        <!-- GAMUT -->
                        <Expander
                            x:Name="ExpGamut"
                            Style="{StaticResource ViewerDetailsExpanderStyle}"
                            AutomationProperties.AutomationId="ExpDetailsGamut"
                            ExpandDirection="Down"
                            IsExpanded="True"
                            Tag="gamut"
                            Visibility="Collapsed">
                            <Expander.Header>
                                <TextBlock Style="{StaticResource ViewerDetailsSectionHeaderStyle}" Text="Gamut · CIE 1931 xy" />
                            </Expander.Header>
                            <Border
                                Padding="0"
                                Background="{ThemeResource ViewerDetailsPlotBrush}"
                                CornerRadius="4">
                                <controls:GalleryGamutChart
                                    Analysis="{x:Bind Gallery.Analysis, Mode=OneWay}"
                                    Compact="True"
                                    IdPrefix="ViewerDetails"
                                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(Gallery.ShowGamut), Mode=OneWay}" />
                            </Border>
                        </Expander>

                        <!-- MEDIA (video) -->
                        <Expander
                            x:Name="ExpVideo"
                            Style="{StaticResource ViewerDetailsExpanderStyle}"
                            AutomationProperties.AutomationId="ExpDetailsVideo"
                            ExpandDirection="Down"
                            IsExpanded="True"
                            Tag="video"
                            Visibility="Collapsed">
                            <Expander.Header>
                                <TextBlock Style="{StaticResource ViewerDetailsSectionHeaderStyle}" Text="Media" />
                            </Expander.Header>
                            <StackPanel Spacing="4">
                                <StackPanel Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoVideoDuration), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource ViewerDetailsStatLabelStyle}" Text="Duration" />
                                    <TextBlock Style="{StaticResource ViewerDetailsStatValueStyle}" Text="{x:Bind Gallery.InfoVideoDuration, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.InfoVideoSize), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource ViewerDetailsStatLabelStyle}" Text="Size" />
                                    <TextBlock Style="{StaticResource ViewerDetailsStatValueStyle}" Text="{x:Bind Gallery.InfoVideoSize, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock
                                    AutomationProperties.AutomationId="TxtViewerVideoDetails"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Gallery.DetailsText, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.DetailsText), Mode=OneWay}" />
                            </StackPanel>
                        </Expander>

                        <!-- TAGS -->
                        <Expander
                            x:Name="ExpTags"
                            Style="{StaticResource ViewerDetailsExpanderStyle}"
                            AutomationProperties.AutomationId="ExpDetailsTags"
                            ExpandDirection="Down"
                            IsExpanded="True"
                            Tag="tags">
                            <Expander.Header>
                                <TextBlock Style="{StaticResource ViewerDetailsSectionHeaderStyle}" Text="Tags" />
                            </Expander.Header>
                            <ItemsRepeater
                                x:Name="LstDetailsTags"
                                AutomationProperties.AutomationId="LstViewerDetailsTags"
                                AutomationProperties.Name="Tags"
                                ItemsSource="{x:Bind Gallery.Tags, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <helpers:ChipWrapLayout HorizontalSpacing="4" VerticalSpacing="4" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:AssignedTagItem">
                                        <Border
                                            MinWidth="0"
                                            Padding="6,2"
                                            HorizontalAlignment="Left"
                                            Background="{x:Bind helpers:TagColor.ChipFill(EffectiveColor), Mode=OneWay}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            Opacity="{x:Bind ChromeOpacity, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ChipTooltip, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock
                                                    Foreground="{x:Bind helpers:TagColor.ChipInk(EffectiveColor), Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind TagName, Mode=OneWay}" />
                                                <TextBlock
                                                    Foreground="{x:Bind helpers:TagColor.ChipInk(EffectiveColor), Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind CountLabel, Mode=OneWay}"
                                                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsPartial), Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Expander>

                        <!-- GENERATION -->
                        <Expander
                            x:Name="ExpGeneration"
                            Style="{StaticResource ViewerDetailsExpanderStyle}"
                            AutomationProperties.AutomationId="ExpDetailsGeneration"
                            ExpandDirection="Down"
                            IsExpanded="False"
                            Tag="generation"
                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(Gallery.ShowGeneration), Mode=OneWay}">
                            <Expander.Header>
                                <TextBlock Style="{StaticResource ViewerDetailsSectionHeaderStyle}" Text="Generation" />
                            </Expander.Header>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    AutomationProperties.AutomationId="TxtViewerDetailsModel"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind helpers:BindHelpers.OrDash(Gallery.PreviewModel), Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource ViewerDetailsStatLabelStyle}" Text="Prompt" />
                                <TextBlock
                                    AutomationProperties.AutomationId="TxtViewerDetailsPrompt"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind helpers:BindHelpers.OrDash(Gallery.PreviewPrompt), Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource ViewerDetailsStatLabelStyle}" Text="Negative" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind helpers:BindHelpers.OrDash(Gallery.PreviewNegative), Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource ViewerDetailsStatLabelStyle}" Text="Seed" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind helpers:BindHelpers.OrDash(Gallery.PreviewSeed), Mode=OneWay}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer actions -->
                <Grid
                    Grid.Row="2"
                    Padding="8,4,8,6"
                    ColumnSpacing="4"
                    BorderBrush="{ThemeResource ViewerDetailsBorderBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        HorizontalAlignment="Stretch"
                        Padding="2,4"
                        AutomationProperties.AutomationId="BtnViewerDetailsFooterCopyPath"
                        AutomationProperties.Name="Copy path"
                        Command="{x:Bind Gallery.CopyPathCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="Copy path">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Copy path"
                            TextWrapping="WrapWholeWords" />
                    </Button>
                    <Button
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Padding="2,4"
                        AutomationProperties.AutomationId="BtnViewerDetailsFooterExplorer"
                        AutomationProperties.Name="Show in Explorer"
                        Command="{x:Bind Gallery.OpenInExplorerCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind Gallery.CanOpenInExplorer, Mode=OneWay}"
                        ToolTipService.ToolTip="Show in Explorer">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Show in Explorer"
                            TextWrapping="WrapWholeWords" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        Padding="2,4"
                        AutomationProperties.AutomationId="BtnViewerDetailsFooterOpenWith"
                        AutomationProperties.Name="Open with"
                        Command="{x:Bind Gallery.OpenWithCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind Gallery.CanOpenInExplorer, Mode=OneWay}"
                        ToolTipService.ToolTip="Open with default app">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Open with"
                            TextWrapping="WrapWholeWords" />
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
