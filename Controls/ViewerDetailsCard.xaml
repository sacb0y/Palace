<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Palace.Controls.ViewerDetailsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Palace.Controls"
    xmlns:helpers="using:Palace.Helpers"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:models="using:Palace.Models"
    x:Name="Root"
    RequestedTheme="Dark"
    IsTabStop="False">
    <Grid
        x:Name="GrdCardHost"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        IsHitTestVisible="False"
        SizeChanged="GrdCardHost_SizeChanged">
        <Border
            x:Name="BrdDetailsCard"
            Width="340"
            MinWidth="300"
            Margin="0,64,16,16"
            Padding="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            AutomationProperties.AutomationId="BrdViewerDetailsCard"
            Background="{ThemeResource ViewerDetailsSurfaceBrush}"
            BorderBrush="{ThemeResource ViewerDetailsBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            IsHitTestVisible="True"
            Opacity="0"
            PointerEntered="BrdDetailsCard_PointerEntered"
            PointerExited="BrdDetailsCard_PointerExited"
            Visibility="Collapsed">
            <Grid>
                <ScrollViewer
                    x:Name="ScrDetails"
                    AutomationProperties.AutomationId="ScrViewerDetails"
                    HorizontalScrollBarVisibility="Disabled"
                    PointerWheelChanged="ScrDetails_PointerWheelChanged"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PnlSections" Padding="12,10" Spacing="8">
                        <Expander
                            x:Name="ExpFile"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="ExpDetailsFile"
                            ExpandDirection="Down"
                            IsExpanded="True"
                            Collapsed="Section_Collapsed"
                            Expanded="Section_Expanded"
                            Tag="file">
                            <Expander.Header>
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="File" />
                            </Expander.Header>
                            <StackPanel Spacing="6">
                                <TextBlock
                                    x:Name="TxtDetailsTitle"
                                    AutomationProperties.AutomationId="TxtViewerDetailsTitle"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Gallery.Title, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    AutomationProperties.AutomationId="TxtViewerDetailsPosition"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Gallery.PositionLabel, Mode=OneWay}" />
                                <TextBlock
                                    AutomationProperties.AutomationId="TxtViewerDetailsLine"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Gallery.DetailsText, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.DetailsText), Mode=OneWay}" />
                                <TextBlock
                                    AutomationProperties.AutomationId="TxtViewerDetailsHdr"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Gallery.HdrStatus, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.HdrStatus), Mode=OneWay}" />
                                <TextBlock
                                    AutomationProperties.AutomationId="TxtViewerDetailsPreviewStatus"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Gallery.PreviewStatus, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(Gallery.PreviewStatus), Mode=OneWay}" />
                            </StackPanel>
                        </Expander>

                        <Expander
                            x:Name="ExpTags"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="ExpDetailsTags"
                            ExpandDirection="Down"
                            IsExpanded="True"
                            Collapsed="Section_Collapsed"
                            Expanded="Section_Expanded"
                            Tag="tags">
                            <Expander.Header>
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Tags" />
                            </Expander.Header>
                            <ItemsRepeater
                                x:Name="LstDetailsTags"
                                AutomationProperties.AutomationId="LstViewerDetailsTags"
                                AutomationProperties.Name="Tags"
                                ItemsSource="{x:Bind Gallery.Tags, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <helpers:ChipWrapLayout HorizontalSpacing="6" VerticalSpacing="4" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:AssignedTagItem">
                                        <Border
                                            MinWidth="0"
                                            Padding="6,2"
                                            HorizontalAlignment="Left"
                                            Background="{x:Bind helpers:TagColor.ChipFill(EffectiveColor), Mode=OneWay}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            Opacity="{x:Bind ChromeOpacity, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ChipTooltip, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock
                                                    Foreground="{x:Bind helpers:TagColor.ChipInk(EffectiveColor), Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind TagName, Mode=OneWay}" />
                                                <TextBlock
                                                    Foreground="{x:Bind helpers:TagColor.ChipInk(EffectiveColor), Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind CountLabel, Mode=OneWay}"
                                                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsPartial), Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Expander>

                        <Expander
                            x:Name="ExpImage"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="ExpDetailsImage"
                            ExpandDirection="Down"
                            IsExpanded="True"
                            Collapsed="Section_Collapsed"
                            Expanded="Section_Expanded"
                            Tag="image"
                            Visibility="Collapsed">
                            <Expander.Header>
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Image" />
                            </Expander.Header>
                            <StackPanel Spacing="8">
                                <TextBlock
                                    AutomationProperties.AutomationId="TxtViewerImageInfo"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Gallery.ImageInfoText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <Border
                                    Padding="8"
                                    Background="{ThemeResource ViewerDetailsPlotBrush}"
                                    CornerRadius="4">
                                    <controls:GalleryHistogramChart
                                        Compact="False"
                                        IdPrefix="ViewerDetails"
                                        Bins="{x:Bind Gallery.Histogram, Mode=OneWay}"
                                        Details="{x:Bind Gallery.DetailsRows, Mode=OneWay}"
                                        Heatmap="{x:Bind Gallery.HeatmapActive, Mode=OneWay}"
                                        ShowLuma="{x:Bind Gallery.HistogramShowLuma, Mode=TwoWay}"
                                        ShowRgb="{x:Bind Gallery.HistogramShowRgb, Mode=TwoWay}"
                                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(Gallery.ShowHistogram), Mode=OneWay}" />
                                </Border>
                                <Border
                                    Padding="8"
                                    Background="{ThemeResource ViewerDetailsPlotBrush}"
                                    CornerRadius="4">
                                    <controls:GalleryGamutChart
                                        Analysis="{x:Bind Gallery.Analysis, Mode=OneWay}"
                                        Compact="False"
                                        IdPrefix="ViewerDetails"
                                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(Gallery.ShowGamut), Mode=OneWay}" />
                                </Border>
                            </StackPanel>
                        </Expander>

                        <Expander
                            x:Name="ExpVideo"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="ExpDetailsVideo"
                            ExpandDirection="Down"
                            IsExpanded="True"
                            Collapsed="Section_Collapsed"
                            Expanded="Section_Expanded"
                            Tag="video"
                            Visibility="Collapsed">
                            <Expander.Header>
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Video" />
                            </Expander.Header>
                            <StackPanel Spacing="6">
                                <TextBlock
                                    AutomationProperties.AutomationId="TxtViewerVideoDetails"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Gallery.DetailsText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Loop and Set thumb live in the viewer chrome."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>

                        <Expander
                            x:Name="ExpGeneration"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="ExpDetailsGeneration"
                            ExpandDirection="Down"
                            IsExpanded="False"
                            Collapsed="Section_Collapsed"
                            Expanded="Section_Expanded"
                            Tag="generation"
                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(Gallery.ShowGeneration), Mode=OneWay}">
                            <Expander.Header>
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Generation" />
                            </Expander.Header>
                            <StackPanel Spacing="6">
                                <TextBlock
                                    AutomationProperties.AutomationId="TxtViewerDetailsModel"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind helpers:BindHelpers.OrDash(Gallery.PreviewModel), Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Prompt" />
                                <TextBlock
                                    AutomationProperties.AutomationId="TxtViewerDetailsPrompt"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind helpers:BindHelpers.OrDash(Gallery.PreviewPrompt), Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Negative" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind helpers:BindHelpers.OrDash(Gallery.PreviewNegative), Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Seed" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind helpers:BindHelpers.OrDash(Gallery.PreviewSeed), Mode=OneWay}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
