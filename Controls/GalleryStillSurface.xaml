<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Palace.Controls.GalleryStillSurface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!--
      Visual pager (docs/specs/swipe-nav.md): current + ±1 neighbors with 16 px gap.
      Custom — not FlipView. Neighbors are hit-test invisible; drag drives Translation.

      Manipulation stays on GrdStillContent (image path) — ScrStill ManipulationMode=None
      so ScrollViewer DirectManipulation does not eat on-image swipes. Fit at 1× sizes
      GrdStillContent to the viewport (transparent) with the image letterboxed inside,
      so letterbox / near-chrome swipes hit the same panel as the image.
    -->
    <Grid
        x:Name="GrdStillHost"
        Background="Transparent"
        SizeChanged="GrdStillHost_SizeChanged">
        <Image
            x:Name="ImgNeighborPrev"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AutomationProperties.AccessibilityView="Raw"
            IsHitTestVisible="False"
            Opacity="0"
            Stretch="Uniform">
            <Image.RenderTransform>
                <TranslateTransform x:Name="XfNeighborPrev" />
            </Image.RenderTransform>
        </Image>
        <Image
            x:Name="ImgNeighborNext"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AutomationProperties.AccessibilityView="Raw"
            IsHitTestVisible="False"
            Opacity="0"
            Stretch="Uniform">
            <Image.RenderTransform>
                <TranslateTransform x:Name="XfNeighborNext" />
            </Image.RenderTransform>
        </Image>
        <ScrollViewer
            x:Name="ScrStill"
            Background="Transparent"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Enabled"
            ManipulationMode="None"
            PointerCaptureLost="ScrStill_PointerCaptureLost"
            PointerMoved="ScrStill_PointerMoved"
            PointerPressed="ScrStill_PointerPressed"
            PointerReleased="ScrStill_PointerReleased"
            VerticalScrollBarVisibility="Hidden"
            VerticalScrollMode="Enabled"
            ZoomMode="Disabled">
            <ScrollViewer.RenderTransform>
                <TransformGroup>
                    <RotateTransform x:Name="XfReviewTilt" />
                    <TranslateTransform x:Name="XfCurrent" />
                </TransformGroup>
            </ScrollViewer.RenderTransform>
            <Grid
                x:Name="GrdStillContent"
                Background="Transparent"
                DoubleTapped="GrdStillContent_DoubleTapped"
                IsDoubleTapEnabled="True"
                ManipulationCompleted="GrdStillContent_ManipulationCompleted"
                ManipulationDelta="GrdStillContent_ManipulationDelta"
                ManipulationMode="TranslateX,TranslateY,Scale">
                <Image
                    x:Name="ImgStill"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ImageOpened="ImgStill_ImageOpened"
                    Stretch="Uniform" />
                <SwapChainPanel
                    x:Name="ScpHdr"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Visibility="Collapsed" />
                <Border
                    x:Name="BrdReviewTint"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsHitTestVisible="False"
                    Opacity="0" />
            </Grid>
        </ScrollViewer>
        <Border
            x:Name="BrdEdgeGlowLeft"
            Width="28"
            HorizontalAlignment="Left"
            AutomationProperties.AccessibilityView="Raw"
            IsHitTestVisible="False"
            Opacity="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Offset="0" Color="#66ED9FBC" />
                    <GradientStop Offset="1" Color="#00ED9FBC" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border
            x:Name="BrdEdgeGlowRight"
            Width="28"
            HorizontalAlignment="Right"
            AutomationProperties.AccessibilityView="Raw"
            IsHitTestVisible="False"
            Opacity="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="1,0.5" EndPoint="0,0.5">
                    <GradientStop Offset="0" Color="#66ED9FBC" />
                    <GradientStop Offset="1" Color="#00ED9FBC" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <TextBlock
            x:Name="TxtEdgeHint"
            Margin="0,0,0,56"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            AutomationProperties.AccessibilityView="Raw"
            IsHitTestVisible="False"
            Opacity="0"
            Style="{StaticResource CaptionTextBlockStyle}" />
    </Grid>
</UserControl>
