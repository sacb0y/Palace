<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Palace.Controls.GalleryStillSurface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!--
      Visual pager (docs/specs/swipe-nav.md): current + ±1 neighbors with 16 px gap.
      Custom — not FlipView. Neighbors are hit-test invisible; drag drives Translation.
    -->
    <!--
      Transparent host + ScrStill fill the viewer so letterbox / beside-chrome
      swipes hit-test. Overlay chrome (Info, nav, Details card) stays above and
      keeps its own hit targets — only real buttons/cards steal the gesture.
      Manipulation is on ScrStill (full viewport), not the letterboxed image panel.
    -->
    <Grid
        x:Name="GrdStillHost"
        Background="Transparent"
        SizeChanged="GrdStillHost_SizeChanged">
        <Image
            x:Name="ImgNeighborPrev"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AutomationProperties.AccessibilityView="Raw"
            IsHitTestVisible="False"
            Opacity="0"
            Stretch="Uniform">
            <Image.RenderTransform>
                <TranslateTransform x:Name="XfNeighborPrev" />
            </Image.RenderTransform>
        </Image>
        <Image
            x:Name="ImgNeighborNext"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AutomationProperties.AccessibilityView="Raw"
            IsHitTestVisible="False"
            Opacity="0"
            Stretch="Uniform">
            <Image.RenderTransform>
                <TranslateTransform x:Name="XfNeighborNext" />
            </Image.RenderTransform>
        </Image>
        <ScrollViewer
            x:Name="ScrStill"
            Background="Transparent"
            DoubleTapped="ScrStill_DoubleTapped"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Enabled"
            IsDoubleTapEnabled="True"
            ManipulationCompleted="ScrStill_ManipulationCompleted"
            ManipulationDelta="ScrStill_ManipulationDelta"
            ManipulationMode="TranslateX,TranslateY,Scale"
            PointerCaptureLost="ScrStill_PointerCaptureLost"
            PointerMoved="ScrStill_PointerMoved"
            PointerPressed="ScrStill_PointerPressed"
            PointerReleased="ScrStill_PointerReleased"
            VerticalScrollBarVisibility="Hidden"
            VerticalScrollMode="Enabled"
            ZoomMode="Disabled">
            <ScrollViewer.RenderTransform>
                <TransformGroup>
                    <RotateTransform x:Name="XfReviewTilt" />
                    <TranslateTransform x:Name="XfCurrent" />
                </TransformGroup>
            </ScrollViewer.RenderTransform>
            <!-- Image-sized panel only — Fit letterbox margins live outside this grid. -->
            <Grid x:Name="GrdStillContent" ManipulationMode="None">
                <Image
                    x:Name="ImgStill"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ImageOpened="ImgStill_ImageOpened"
                    Stretch="Uniform" />
                <SwapChainPanel
                    x:Name="ScpHdr"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Visibility="Collapsed" />
                <Border
                    x:Name="BrdReviewTint"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsHitTestVisible="False"
                    Opacity="0" />
            </Grid>
        </ScrollViewer>
        <Border
            x:Name="BrdEdgeGlowLeft"
            Width="28"
            HorizontalAlignment="Left"
            AutomationProperties.AccessibilityView="Raw"
            IsHitTestVisible="False"
            Opacity="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Offset="0" Color="#66ED9FBC" />
                    <GradientStop Offset="1" Color="#00ED9FBC" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border
            x:Name="BrdEdgeGlowRight"
            Width="28"
            HorizontalAlignment="Right"
            AutomationProperties.AccessibilityView="Raw"
            IsHitTestVisible="False"
            Opacity="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="1,0.5" EndPoint="0,0.5">
                    <GradientStop Offset="0" Color="#66ED9FBC" />
                    <GradientStop Offset="1" Color="#00ED9FBC" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <TextBlock
            x:Name="TxtEdgeHint"
            Margin="0,0,0,56"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            AutomationProperties.AccessibilityView="Raw"
            IsHitTestVisible="False"
            Opacity="0"
            Style="{StaticResource CaptionTextBlockStyle}" />
    </Grid>
</UserControl>
