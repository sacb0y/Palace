                                Height="92"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                RenderTransformOrigin="0.5,0.5"
                                Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.HasMultiSelectThumb1), Mode=OneWay}">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="{x:Bind ViewModel.MultiSelectThumb1Angle, Mode=OneWay}" />
                                </Border.RenderTransform>
                                <Image
                                    Stretch="UniformToFill"
                                    Source="{x:Bind helpers:BindHelpers.AssetThumb(ViewModel.MultiSelectThumb1), Mode=OneWay}" />
