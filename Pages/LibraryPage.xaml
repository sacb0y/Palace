<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Palace.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Palace.Helpers"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Palace.Controls"
    xmlns:models="using:Palace.Models"
    xmlns:pages="using:Palace.Pages"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
    <Grid
        Padding="12,8,12,8"
        ColumnSpacing="12"
        IsHitTestVisible="{x:Bind helpers:BindHelpers.Not(ViewModel.IsGalleryOverlayOpen), Mode=OneWay}"
        RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="3" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    AutomationProperties.AutomationId="BtnAddFolder"
                    AutomationProperties.Name="Add folder"
                    Command="{x:Bind ViewModel.AddFolderCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="FolderAdd" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock VerticalAlignment="Center" Text="Add folder" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.AutomationId="BtnScan"
                    Command="{x:Bind ViewModel.ScanCommand}"
                    IsEnabled="{x:Bind helpers:BindHelpers.Not(ViewModel.IsBusy), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="ArrowSync" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock VerticalAlignment="Center" Text="Scan" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.AutomationId="BtnOrganize"
                    Command="{x:Bind ViewModel.PreviewOrganizeCommand}"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="FolderArrowRight" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock VerticalAlignment="Center" Text="Organize" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.AutomationId="BtnUndoOrganize"
                    Command="{x:Bind ViewModel.UndoOrganizeCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="ArrowUndo" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock VerticalAlignment="Center" Text="Undo last organize" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.AutomationId="BtnAddToRoom"
                    Command="{x:Bind ViewModel.AddSelectionToRoomCommand}"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="Door" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock VerticalAlignment="Center" Text="Add to room" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <ProgressBar
                x:Name="PrgLibrary"
                Grid.Row="1"
                Height="4"
                AutomationProperties.AutomationId="PrgLibrary"
                AutomationProperties.Name="Library loading"
                IsIndeterminate="True"
                ShowPaused="False"
                Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.IsBusy), Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <SelectorBar
                x:Name="SelBrowseMode"
                AutomationProperties.AutomationId="SelBrowseMode"
                AutomationProperties.Name="Browse by"
                SelectionChanged="SelBrowseMode_SelectionChanged">
                <SelectorBarItem
                    x:Name="SelFolders"
                    AutomationProperties.AutomationId="SelFolders"
                    IsSelected="True"
                    Text="Folders" />
                <SelectorBarItem
                    x:Name="SelTags"
                    AutomationProperties.AutomationId="SelTags"
                    Text="Tags" />
            </SelectorBar>
            <SelectorBar
                x:Name="SelTagMatch"
                Grid.Row="1"
                AutomationProperties.AutomationId="SelTagMatch"
                AutomationProperties.Name="Tag match"
                SelectionChanged="SelTagMatch_SelectionChanged"
                Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.IsTagBrowse), Mode=OneWay}">
                <SelectorBarItem
                    x:Name="SelTagMatchAll"
                    AutomationProperties.AutomationId="SelTagMatchAll"
                    IsSelected="True"
                    Text="All" />
                <SelectorBarItem
                    x:Name="SelTagMatchAny"
                    AutomationProperties.AutomationId="SelTagMatchAny"
                    Text="Any" />
                <SelectorBarItem
                    x:Name="SelTagMatchNone"
                    AutomationProperties.AutomationId="SelTagMatchNone"
                    Text="None" />
            </SelectorBar>
            <ItemsRepeater
                x:Name="LstTagFilters"
                Grid.Row="2"
                AutomationProperties.AutomationId="LstTagFilters"
                AutomationProperties.Name="Selected tags"
                ItemsSource="{x:Bind ViewModel.SelectedFilterTags, Mode=OneWay}"
                Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowTagFilterChips), Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <WrapLayout HorizontalSpacing="6" VerticalSpacing="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:TagChipItem">
                        <Button
                            MinWidth="0"
                            Padding="8,4"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
                            Command="{x:Bind pages:LibraryPage.GetRemoveFilterTagCommand()}"
                            CommandParameter="{x:Bind}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border
                                    Width="10"
                                    Height="10"
                                    Background="{x:Bind helpers:TagColor.ChipFill(EffectiveColor), Mode=OneWay}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind Name, Mode=OneWay}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Remove" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <TreeView
                x:Name="TreFolders"
                Grid.Row="3"
                AutomationProperties.AutomationId="TreFolders"
                AutomationProperties.Name="Source folders"
                ItemInvoked="TreFolders_ItemInvoked"
                ItemsSource="{x:Bind ViewModel.FolderTree, Mode=OneWay}"
                Visibility="{x:Bind helpers:BindHelpers.InvertBoolToVisibility(ViewModel.IsTagBrowse), Mode=OneWay}">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="models:FolderNode">
                        <TreeViewItem
                            Content="{x:Bind Name, Mode=OneWay}"
                            IsExpanded="True"
                            ItemsSource="{x:Bind Children, Mode=OneWay}" />
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <ScrollViewer
                x:Name="TreTagsBrowse"
                Grid.Row="3"
                AutomationProperties.AutomationId="TreTagsBrowse"
                AutomationProperties.Name="Tags"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.IsTagBrowse), Mode=OneWay}">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.BrowseTags, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <WrapLayout HorizontalSpacing="6" VerticalSpacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:TagChipItem">
                            <Button
                                MinWidth="0"
                                Padding="8,4"
                                HorizontalAlignment="Left"
                                HorizontalContentAlignment="Left"
                                AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                Command="{x:Bind pages:LibraryPage.GetToggleFilterChipCommand()}"
                                CommandParameter="{x:Bind}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border
                                        Width="10"
                                        Height="10"
                                        VerticalAlignment="Center"
                                        Background="{x:Bind helpers:TagColor.ChipFill(EffectiveColor), Mode=OneWay}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2" />
                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Name, Mode=OneWay}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="On"
                                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsFilterSelected), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <Grid
            Grid.Row="1"
            Grid.Column="1"
            RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <ToggleButton
                    x:Name="TglSelectMode"
                    AutomationProperties.AutomationId="TglSelectMode"
                    AutomationProperties.Name="Select"
                    Checked="TglSelectMode_Changed"
                    IsChecked="{x:Bind ViewModel.IsSelectMode, Mode=TwoWay}"
                    Unchecked="TglSelectMode_Changed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="Multiselect" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock VerticalAlignment="Center" Text="Select" />
                    </StackPanel>
                </ToggleButton>
                <ic:FluentIcon
                    VerticalAlignment="Center"
                    Icon="ArrowSort"
                    IconSize="Size16"
                    IconVariant="Regular" />
                <TextBlock VerticalAlignment="Center" Text="Sort" />
                <ComboBox
                    x:Name="CmbMosaicSort"
                    MinWidth="168"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="CmbMosaicSort"
                    AutomationProperties.Name="Sort"
                    ItemsSource="{x:Bind ViewModel.SortLabels, Mode=OneWay}"
                    SelectedIndex="{x:Bind ViewModel.MosaicSortIndex, Mode=OneWay}"
                    SelectionChanged="CmbMosaicSort_SelectionChanged" />
                <TextBlock
                    x:Name="TxtSelectionCount"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="TxtSelectionCount"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" />
                <Button
                    x:Name="BtnTagSelected"
                    AutomationProperties.AutomationId="BtnTagSelected"
                    AutomationProperties.Name="Tag selected"
                    Click="BtnTagSelected_Click"
                    Style="{ThemeResource AccentButtonStyle}"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowTagSelectedCta), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="Tag" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock VerticalAlignment="Center" Text="Tag selected…" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <BreadcrumbBar
                x:Name="BcrPath"
                Grid.Row="1"
                AutomationProperties.AutomationId="BcrPath"
                ItemClicked="BcrPath_ItemClicked"
                ItemsSource="{x:Bind ViewModel.Breadcrumbs, Mode=OneWay}">
                <BreadcrumbBar.ItemTemplate>
                    <DataTemplate x:DataType="models:PathCrumb">
                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                    </DataTemplate>
                </BreadcrumbBar.ItemTemplate>
            </BreadcrumbBar>
            <AutoSuggestBox
                x:Name="AsbSearch"
                Grid.Row="2"
                AutomationProperties.AutomationId="AsbSearch"
                PlaceholderText="Search filename, tags, prompt, model"
                QueryIcon="Find"
                QuerySubmitted="AsbSearch_QuerySubmitted"
                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ItemsView
                x:Name="GrdAssets"
                Grid.Row="3"
                AutomationProperties.AutomationId="GrdAssets"
                AutomationProperties.Name="Assets"
                DoubleTapped="GrdAssets_DoubleTapped"
                IsItemInvokedEnabled="False"
                IsHoldingEnabled="True"
                IsTabStop="True"
                ItemsSource="{x:Bind ViewModel.Assets, Mode=OneWay}"
                PreviewKeyDown="GrdAssets_PreviewKeyDown"
                SelectionChanged="GrdAssets_SelectionChanged"
                SelectionMode="Single">
                <ItemsView.Layout>
                    <helpers:JustifiedMosaicLayout
                        x:Name="MosaicLayout"
                        CaptionHeight="0"
                        HeaderHeight="28"
                        ItemSpacing="8"
                        RowHeight="{x:Bind ViewModel.MosaicRowHeight, Mode=OneWay}" />
                </ItemsView.Layout>
                <ItemsView.ItemTemplate>
                    <DataTemplate x:DataType="models:AssetItem">
                        <ItemContainer
                            AutomationProperties.Name="{x:Bind MosaicItemName, Mode=OneWay}"
                            ContextRequested="AssetItem_ContextRequested"
                            DoubleTapped="AssetItem_DoubleTapped"
                            IsDoubleTapEnabled="True"
                            IsHoldingEnabled="True"
                            IsTabStop="{x:Bind helpers:BindHelpers.Not(IsFolderHeader), Mode=OneWay}"
                            ManipulationMode="None"
                            Tag="{x:Bind MosaicTag, Mode=OneWay}">
                            <ItemContainer.ContextFlyout>
                                <MenuFlyout Opening="AssetMenu_Opening">
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="MnuOpen"
                                        Command="{x:Bind pages:LibraryPage.GetOpenOverlayCommand()}"
                                        CommandParameter="{x:Bind}"
                                        Text="Open">
                                        <MenuFlyoutItem.Icon>
                                            <ic:FluentIcon Icon="Open" IconSize="Size16" IconVariant="Regular" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="MnuOpenInNewWindow"
                                        Command="{x:Bind pages:LibraryPage.GetOpenInNewWindowCommand()}"
                                        CommandParameter="{x:Bind}"
                                        Text="Open in new window">
                                        <MenuFlyoutItem.Icon>
                                            <ic:FluentIcon Icon="WindowNew" IconSize="Size16" IconVariant="Regular" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="MnuShowInExplorer"
                                        Command="{x:Bind pages:LibraryPage.GetShowInExplorerCommand()}"
                                        Text="Show in File Explorer">
                                        <MenuFlyoutItem.Icon>
                                            <ic:FluentIcon Icon="FolderOpen" IconSize="Size16" IconVariant="Regular" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="MnuCopy"
                                        Command="{x:Bind pages:LibraryPage.GetCopyFilesCommand()}"
                                        Text="Copy">
                                        <MenuFlyoutItem.Icon>
                                            <ic:FluentIcon Icon="Copy" IconSize="Size16" IconVariant="Regular" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="MnuCopyPath"
                                        Command="{x:Bind pages:LibraryPage.GetCopyPathCommand()}"
                                        Text="Copy path">
                                        <MenuFlyoutItem.Icon>
                                            <ic:FluentIcon Icon="DocumentCopy" IconSize="Size16" IconVariant="Regular" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="MnuMoveToFolder"
                                        Command="{x:Bind pages:LibraryPage.GetMoveToFolderCommand()}"
                                        Text="Move to folder…">
                                        <MenuFlyoutItem.Icon>
                                            <ic:FluentIcon Icon="FolderArrowRight" IconSize="Size16" IconVariant="Regular" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="MnuAddToRoom"
                                        Command="{x:Bind pages:LibraryPage.GetAddSelectionToRoomCommand()}"
                                        Text="Add to room">
                                        <MenuFlyoutItem.Icon>
                                            <ic:FluentIcon Icon="Door" IconSize="Size16" IconVariant="Regular" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="MnuAddTag"
                                        Command="{x:Bind pages:LibraryPage.GetFocusAssignTagCommand()}"
                                        Text="Add tag…">
                                        <MenuFlyoutItem.Icon>
                                            <ic:FluentIcon Icon="Tag" IconSize="Size16" IconVariant="Regular" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="MnuDelete"
                                        Command="{x:Bind pages:LibraryPage.GetDeleteFilesCommand()}"
                                        Text="Delete">
                                        <MenuFlyoutItem.Icon>
                                            <ic:FluentIcon Icon="Delete" IconSize="Size16" IconVariant="Regular" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </ItemContainer.ContextFlyout>
                            <Grid>
                                <Button
                                    Padding="4,2"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{x:Bind pages:LibraryPage.GetActivateFolderHeaderCommand()}"
                                    CommandParameter="{x:Bind}"
                                    IsTabStop="False"
                                    PointerPressed="FolderGroupHeader_PointerPressed"
                                    Tag="{x:Bind MosaicTag, Mode=OneWay}"
                                    Tapped="FolderGroupHeader_Tapped"
                                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsFolderHeader), Mode=OneWay}">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <ic:FluentIcon
                                            Icon="Folder"
                                            IconSize="Size16"
                                            IconVariant="Regular" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="{x:Bind FolderGroupAutomationId, Mode=OneWay}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Tag="{x:Bind MosaicTag, Mode=OneWay}"
                                            Text="{x:Bind FolderGroupTitle, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <Grid
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    DoubleTapped="AssetItem_DoubleTapped"
                                    IsDoubleTapEnabled="True"
                                    ManipulationMode="None"
                                    RightTapped="AssetItem_RightTapped"
                                    Visibility="{x:Bind helpers:BindHelpers.InvertBoolToVisibility(IsFolderHeader), Mode=OneWay}">
                                    <Image
                                        DataContextChanged="TileImage_DataContextChanged"
                                        DoubleTapped="AssetItem_DoubleTapped"
                                        IsDoubleTapEnabled="True"
                                        Loaded="TileImage_Loaded"
                                        ManipulationMode="None"
                                        Source="{x:Bind ThumbImage, Mode=OneWay}"
                                        Stretch="UniformToFill"
                                        Tag="{x:Bind Id, Mode=OneWay}"
                                        Unloaded="TileImage_Unloaded" />
                                    <TextBlock
                                        Margin="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsHitTestVisible="False"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Missing"
                                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsOrphan), Mode=OneWay}" />
                                    <StackPanel
                                        Margin="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Spacing="4"
                                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ShowCloudTile), Mode=OneWay}">
                                        <ic:FluentIcon
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Icon="{x:Bind helpers:FluentGlyph.Placeholder(Kind), Mode=OneWay}"
                                            IconSize="Size32"
                                            IconVariant="Regular" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="Online" />
                                    </StackPanel>
                                    <StackPanel
                                        Margin="6"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        IsHitTestVisible="False"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                        <Border
                                            Padding="4"
                                            AutomationProperties.AutomationId="{x:Bind VideoBadgeAutomationId, Mode=OneWay}"
                                            AutomationProperties.Name="Video"
                                            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ShowVideoBadge), Mode=OneWay}">
                                            <ic:FluentIcon
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                Icon="Video"
                                                IconSize="Size16"
                                                IconVariant="Regular" />
                                        </Border>
                                        <Border
                                            Padding="4"
                                            AutomationProperties.AutomationId="{x:Bind GifBadgeAutomationId, Mode=OneWay}"
                                            AutomationProperties.Name="GIF"
                                            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ShowGifBadge), Mode=OneWay}">
                                            <ic:FluentIcon
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                Icon="Gif"
                                                IconSize="Size16"
                                                IconVariant="Regular" />
                                        </Border>
                                        <Border
                                            Padding="8,5"
                                            AutomationProperties.AutomationId="{x:Bind HdrBadgeAutomationId, Mode=OneWay}"
                                            AutomationProperties.Name="HDR"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="4"
                                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ShowHdrBadge), Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <ic:FluentIcon
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Icon="Hdr"
                                                    IconSize="Size24"
                                                    IconVariant="Regular" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="HDR" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <Border
                                        Margin="6"
                                        Padding="4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        AutomationProperties.AutomationId="{x:Bind CloudBadgeAutomationId, Mode=OneWay}"
                                        AutomationProperties.Name="Cloud"
                                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        IsHitTestVisible="False"
                                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ShowCloudBadge), Mode=OneWay}">
                                        <ic:FluentIcon
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            Icon="Cloud"
                                            IconSize="Size16"
                                            IconVariant="Regular" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </ItemContainer>
                    </DataTemplate>
                </ItemsView.ItemTemplate>
            </ItemsView>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Grid.Column="2"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Preview" />
                <Border
                    MinHeight="200"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <Grid>
                        <Image
                            x:Name="ImgPreview"
                            AutomationProperties.AutomationId="ImgPreview"
                            Stretch="Uniform"
                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.IsImagePreview), Mode=OneWay}" />
                        <MediaPlayerElement
                            x:Name="MpePreview"
                            AreTransportControlsEnabled="True"
                            AutoPlay="False"
                            AutomationProperties.AutomationId="MpePreview"
                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.IsVideoPreview), Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Select an asset"
                            Visibility="{x:Bind helpers:BindHelpers.InvertBoolToVisibility(ViewModel.HasSelection), Mode=OneWay}" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowPreviewPlaceholder), Mode=OneWay}">
                            <ic:FluentIcon
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Icon="{x:Bind helpers:FluentGlyph.Placeholder(ViewModel.PreviewPlaceholderKind), Mode=OneWay}"
                                IconSize="Size32"
                                IconVariant="Regular" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Online" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.PreviewFileName), Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />

                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Tags" />
                <TextBlock
                    x:Name="TxtAssignedTags"
                    AutomationProperties.AutomationId="TxtAssignedTags"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.AssignedTagsSummary, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <ItemsControl
                    x:Name="LstTags"
                    AutomationProperties.AutomationId="LstTags"
                    AutomationProperties.Name="Assigned"
                    ItemsSource="{x:Bind ViewModel.AssignedTags, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VariableSizedWrapGrid
                                ItemHeight="36"
                                MaximumRowsOrColumns="0"
                                Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:AssignedTagItem">
                            <Border
                                Margin="0,0,8,8"
                                Padding="8,4"
                                AutomationProperties.Name="{x:Bind ChipAutomationName, Mode=OneWay}"
                                Background="{x:Bind helpers:TagColor.ChipFill(EffectiveColor), Mode=OneWay}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Opacity="{x:Bind ChromeOpacity, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ChipTooltip, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{x:Bind helpers:TagColor.ChipInk(EffectiveColor), Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind TagName, Mode=OneWay}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{x:Bind helpers:TagColor.ChipInk(EffectiveColor), Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind CountLabel, Mode=OneWay}"
                                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsPartial), Mode=OneWay}" />
                                    <Button
                                        Width="24"
                                        Height="24"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="{x:Bind RemoveAutomationId, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind RemoveAutomationName, Mode=OneWay}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{x:Bind pages:LibraryPage.GetRemoveTagCommand()}"
                                        CommandParameter="{x:Bind}">
                                        <ic:FluentIcon
                                            Foreground="{x:Bind helpers:TagColor.ChipInk(EffectiveColor), Mode=OneWay}"
                                            Icon="Dismiss"
                                            IconSize="Size12"
                                            IconVariant="Regular" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button
                    x:Name="BtnBrowseTags"
                    AutomationProperties.AutomationId="BtnBrowseTags"
                    Click="BtnBrowseTags_Click"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="Add" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock VerticalAlignment="Center" Text="Add tag" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout
                            x:Name="FlyAssignTags"
                            AutomationProperties.AutomationId="FlyAssignTags"
                            Opening="FlyAssignTags_Opening">
                            <ScrollViewer
                                MaxWidth="420"
                                MaxHeight="480"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel Width="400" Spacing="12">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Starred" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.StarredAssignTags, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:TagChipItem">
                                                <Button
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
                                                    Command="{x:Bind pages:LibraryPage.GetToggleAssignChipCommand()}"
                                                    CommandParameter="{x:Bind}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border
                                                            Width="12"
                                                            Height="12"
                                                            Background="{x:Bind helpers:TagColor.ChipFill(EffectiveColor), Mode=OneWay}"
                                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="2" />
                                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="On"
                                                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsAssigned), Mode=OneWay}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Recent" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.RecentAssignTags, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:TagChipItem">
                                                <Button
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
                                                    Command="{x:Bind pages:LibraryPage.GetToggleAssignChipCommand()}"
                                                    CommandParameter="{x:Bind}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border
                                                            Width="12"
                                                            Height="12"
                                                            Background="{x:Bind helpers:TagColor.ChipFill(EffectiveColor), Mode=OneWay}"
                                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="2" />
                                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="On"
                                                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsAssigned), Mode=OneWay}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Recommended" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.RecommendedAssignTags, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:TagChipItem">
                                                <Button
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
                                                    Command="{x:Bind pages:LibraryPage.GetToggleAssignChipCommand()}"
                                                    CommandParameter="{x:Bind}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border
                                                            Width="12"
                                                            Height="12"
                                                            Background="{x:Bind helpers:TagColor.ChipFill(EffectiveColor), Mode=OneWay}"
                                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="2" />
                                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.AssignGroups, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:TagBoardGroup">
                                                <Expander
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
                                                    AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                                    Header="{x:Bind Name, Mode=OneWay}"
                                                    IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                                                    <ItemsControl ItemsSource="{x:Bind Chips, Mode=OneWay}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Spacing="4" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:TagChipItem">
                                                                <Button
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Left"
                                                                    AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
                                                                    Command="{x:Bind pages:LibraryPage.GetToggleAssignChipCommand()}"
                                                                    CommandParameter="{x:Bind}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <Border
                                                                            Width="12"
                                                                            Height="12"
                                                                            Background="{x:Bind helpers:TagColor.ChipFill(EffectiveColor), Mode=OneWay}"
                                                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="2" />
                                                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                                                                        <TextBlock
                                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                            Text="On"
                                                                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsAssigned), Mode=OneWay}" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <StackPanel
                    AutomationProperties.AutomationId="PnlGeneration"
                    Spacing="12"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowGeneration), Mode=OneWay}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Generation" />
                    <TextBlock
                        AutomationProperties.AutomationId="TxtModel"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.PreviewModel), Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Prompt" />
                    <ScrollViewer
                        AutomationProperties.AutomationId="ScrPrompt"
                        MaxHeight="180"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            AutomationProperties.AutomationId="TxtPrompt"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.PreviewPrompt), Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Negative" />
                    <ScrollViewer
                        AutomationProperties.AutomationId="ScrNegative"
                        MaxHeight="120"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.PreviewNegative), Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Seed" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.PreviewSeed), Mode=OneWay}" />
                </StackPanel>

                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Notes and rating" />
                <RatingControl
                    AutomationProperties.AutomationId="RtgAsset"
                    Caption="Rating"
                    IsEnabled="{x:Bind ViewModel.CanEditNotes, Mode=OneWay}"
                    PlaceholderValue="0"
                    Value="{x:Bind ViewModel.PreviewRating, Mode=TwoWay}" />
                <TextBox
                    AutomationProperties.AutomationId="TxtNotes"
                    AcceptsReturn="True"
                    Header="Notes"
                    IsEnabled="{x:Bind ViewModel.CanEditNotes, Mode=OneWay}"
                    Text="{x:Bind ViewModel.PreviewNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Assign" />
                <AutoSuggestBox
                    x:Name="AsbAssignTag"
                    AutomationProperties.AutomationId="AsbAssignTag"
                    AutomationProperties.Name="Tag to assign"
                    ItemsSource="{x:Bind ViewModel.TagSuggestions, Mode=OneWay}"
                    PlaceholderText="Name, or several, comma-separated"
                    QueryIcon="Find"
                    QuerySubmitted="AsbAssignTag_QuerySubmitted"
                    SuggestionChosen="AsbAssignTag_SuggestionChosen"
                    TextChanged="AsbAssignTag_TextChanged"
                    Text="{x:Bind ViewModel.TagQuery, Mode=OneWay}"
                    TextMemberPath="Display"
                    UpdateTextOnSelect="True">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="models:TagPickItem">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="12"
                                    Height="12"
                                    VerticalAlignment="Center"
                                    Background="{x:Bind helpers:TagColor.ChipFill(EffectiveColor), Mode=OneWay}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Display, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
                <TextBlock
                    AutomationProperties.AutomationId="TxtTagSuggestions"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.TagSuggestionsSummary, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <Button
                    AutomationProperties.AutomationId="BtnAssignTag"
                    Click="BtnAssignTag_Click"
                    Content="Assign tag"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                <TextBox
                    AutomationProperties.AutomationId="TxtNewTag"
                    AcceptsReturn="True"
                    Header="Quick new tag (ungrouped)"
                    PlaceholderText="Name, or several, comma or newline"
                    Text="{x:Bind ViewModel.NewTagName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
                <Button
                    AutomationProperties.AutomationId="BtnCreateTag"
                    Command="{x:Bind ViewModel.CreateAndAssignTagCommand}"
                    Content="Create and assign"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />

                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Prompt suggestions"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowGeneration), Mode=OneWay}" />
                <ListView
                    x:Name="LstSuggestions"
                    AutomationProperties.AutomationId="LstSuggestions"
                    ItemsSource="{x:Bind ViewModel.Suggestions, Mode=OneWay}"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowGeneration), Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PromptSuggestion">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind Token, Mode=OneWay}" />
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.Name="Accept suggestion"
                                    Command="{x:Bind pages:LibraryPage.GetAcceptSuggestionCommand()}"
                                    CommandParameter="{x:Bind}"
                                    Content="Add" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    Spacing="8"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowOrganizePanel), Mode=OneWay}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Organize preview" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="From" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="To" />
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Status" />
                    </Grid>
                    <ListView
                        x:Name="LstOrganizePreview"
                        MaxHeight="240"
                        AutomationProperties.AutomationId="LstOrganizePreview"
                        ItemsSource="{x:Bind ViewModel.OrganizePreview, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:OrganizePreviewItem">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind OldPath, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind NewPath, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Status, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button
                        AutomationProperties.AutomationId="BtnApplyOrganize"
                        Command="{x:Bind ViewModel.ApplyOrganizeCommand}"
                        Content="Apply organize" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <InfoBar
            Grid.Row="2"
            Grid.ColumnSpan="3"
            AutomationProperties.AutomationId="InfStatus"
            IsOpen="{x:Bind ViewModel.ShowInfo, Mode=TwoWay}"
            Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}"
            Severity="Informational" />
        <Grid
            Grid.Row="3"
            Grid.ColumnSpan="3"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TxtStatus"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="TxtStatus"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <ic:FluentIcon Icon="RowTriple" IconSize="Size16" IconVariant="Regular" />
                <TextBlock VerticalAlignment="Center" Text="Row height" />
                <Slider
                    x:Name="SldRowHeight"
                    Width="160"
                    MinWidth="120"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="SldRowHeight"
                    AutomationProperties.Name="Mosaic row height"
                    Maximum="280"
                    Minimum="96"
                    StepFrequency="4"
                    TickFrequency="20"
                    TickPlacement="None"
                    Value="{x:Bind ViewModel.MosaicRowHeight, Mode=TwoWay}" />
            </StackPanel>
        </Grid>
    </Grid>

        <Grid
            x:Name="GrdGalleryOverlay"
            AutomationProperties.AutomationId="GrdGalleryOverlay"
            AutomationProperties.Name="Gallery overlay"
            Canvas.ZIndex="1"
            IsTabStop="True"
            PreviewKeyDown="GalleryOverlay_PreviewKeyDown"
            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.IsGalleryOverlayOpen), Mode=OneWay}">
            <Grid
                x:Name="GrdGalleryBackdrop"
                AutomationProperties.AutomationId="GrdGalleryBackdrop"
                PointerPressed="GalleryOverlay_BackdropPressed">
                <Grid Background="{StaticResource GalleryOverlayBackdropBrush}" />
                <Border
                    Background="{ThemeResource SmokeFillColorDefaultBrush}"
                    IsHitTestVisible="False"
                    Opacity="0.28" />
            </Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <controls:GalleryStillSurface
                        x:Name="SrfOverlayStill"
                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.IsImage), Mode=OneWay, FallbackValue=Collapsed}" />
                    <MediaPlayerElement
                        x:Name="MpeOverlay"
                        AreTransportControlsEnabled="True"
                        AutoPlay="False"
                        AutomationProperties.AutomationId="MpeGalleryOverlay"
                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.IsVideo), Mode=OneWay, FallbackValue=Collapsed}" />
                    <Button
                        x:Name="BtnGalleryPlay"
                        MinWidth="72"
                        MinHeight="72"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="BtnGalleryPlay"
                        AutomationProperties.Name="Play"
                        Click="BtnGalleryPlay_Click"
                        ToolTipService.ToolTip="Play"
                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.IsVideo), Mode=OneWay, FallbackValue=Collapsed}">
                        <ic:FluentIcon Icon="Play" IconSize="Size32" IconVariant="Regular" />
                    </Button>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Missing"
                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.IsMissing), Mode=OneWay, FallbackValue=Collapsed}" />

                    <StackPanel
                        Margin="16,16,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ToggleButton
                                x:Name="BtnGalleryImageInfo"
                                Padding="8,4"
                                AutomationProperties.AutomationId="BtnGalleryImageInfo"
                                AutomationProperties.Name="Image information"
                                IsChecked="{x:Bind ViewModel.OverlayGallery.ShowImageInfo, Mode=TwoWay, FallbackValue=False}"
                                ToolTipService.ToolTip="Image information (Ctrl+D)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:FluentIcon Icon="Info" IconSize="Size16" IconVariant="Regular" />
                                    <TextBlock VerticalAlignment="Center" Text="Info" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton
                                x:Name="BtnGalleryDetails"
                                Padding="8,4"
                                AutomationProperties.AutomationId="BtnGalleryDetails"
                                AutomationProperties.Name="Details"
                                IsChecked="{x:Bind ViewModel.OverlayGallery.ShowDetails, Mode=TwoWay, FallbackValue=False}"
                                ToolTipService.ToolTip="Details (Ctrl+I)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:FluentIcon Icon="TextDescription" IconSize="Size16" IconVariant="Regular" />
                                    <TextBlock VerticalAlignment="Center" Text="Details" />
                                </StackPanel>
                            </ToggleButton>
                            <Button
                                x:Name="BtnGalleryScaleActual"
                                Padding="8,4"
                                AutomationProperties.AutomationId="BtnGalleryScaleActual"
                                AutomationProperties.Name="Actual size"
                                Command="{x:Bind ViewModel.OverlayGallery.SetScaleActualCommand, Mode=OneWay, FallbackValue={x:Null}}"
                                IsEnabled="{x:Bind ViewModel.OverlayGallery.CanScale, Mode=OneWay, FallbackValue=True}"
                                ToolTipService.ToolTip="1:1 (Ctrl+1)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:FluentIcon Icon="RatioOneToOne" IconSize="Size16" IconVariant="Regular" />
                                    <TextBlock VerticalAlignment="Center" Text="1:1" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="BtnGalleryScaleFit"
                                Padding="8,4"
                                AutomationProperties.AutomationId="BtnGalleryScaleFit"
                                AutomationProperties.Name="Fit"
                                Command="{x:Bind ViewModel.OverlayGallery.SetScaleFitCommand, Mode=OneWay, FallbackValue={x:Null}}"
                                IsEnabled="{x:Bind ViewModel.OverlayGallery.CanScale, Mode=OneWay, FallbackValue=True}"
                                ToolTipService.ToolTip="Fit (Ctrl+2)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:FluentIcon Icon="ArrowFit" IconSize="Size16" IconVariant="Regular" />
                                    <TextBlock VerticalAlignment="Center" Text="Fit" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="BtnGalleryScaleFill"
                                Padding="8,4"
                                AutomationProperties.AutomationId="BtnGalleryScaleFill"
                                AutomationProperties.Name="Fill"
                                Command="{x:Bind ViewModel.OverlayGallery.SetScaleFillCommand, Mode=OneWay, FallbackValue={x:Null}}"
                                IsEnabled="{x:Bind ViewModel.OverlayGallery.CanScale, Mode=OneWay, FallbackValue=True}"
                                ToolTipService.ToolTip="Fill (Ctrl+3)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:FluentIcon Icon="ArrowMaximize" IconSize="Size16" IconVariant="Regular" />
                                    <TextBlock VerticalAlignment="Center" Text="Fill" />
                                </StackPanel>
                            </Button>
<Border
                                Padding="8,5"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="IcnGalleryOverlayHdr"
                                AutomationProperties.Name="HDR"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="4"
                                IsHitTestVisible="False"
                                Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.ShowHdrBadge), Mode=OneWay, FallbackValue=Collapsed}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ic:FluentIcon
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Icon="Hdr"
                                        IconSize="Size24"
                                        IconVariant="Regular" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="HDR" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Border
                            x:Name="BrdGalleryImageInfo"
                            MaxWidth="360"
                            Padding="10,6"
                            AutomationProperties.AutomationId="BrdGalleryImageInfo"
                            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource OverlayCornerRadius}"
                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.ShowImageInfo), Mode=OneWay, FallbackValue=Collapsed}">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    AutomationProperties.AutomationId="TxtGalleryImageInfo"
                                    AutomationProperties.Name="Image information"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.OverlayGallery.ImageInfoText, Mode=OneWay, FallbackValue=''}"
                                    TextWrapping="Wrap" />
                                <controls:GalleryHistogramChart
                                    Compact="True"
                                    IdPrefix="GalleryOverlay"
                                    Bins="{x:Bind ViewModel.OverlayGallery.Histogram, Mode=OneWay, FallbackValue={x:Null}}"
                                    ShowRgb="{x:Bind ViewModel.OverlayGallery.HistogramShowRgb, Mode=OneWay, FallbackValue=True}"
                                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.ShowHistogram), Mode=OneWay, FallbackValue=Collapsed}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Button
                        x:Name="BtnGalleryPrev"
                        MinWidth="48"
                        MinHeight="48"
                        Margin="16,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="BtnGalleryPrev"
                        AutomationProperties.Name="Previous"
                        Command="{x:Bind ViewModel.OverlayGallery.GoPreviousCommand, Mode=OneWay, FallbackValue={x:Null}}"
                        IsEnabled="{x:Bind ViewModel.OverlayGallery.CanGoPrevious, Mode=OneWay, FallbackValue=False}"
                        ToolTipService.ToolTip="Previous">
                        <ic:FluentIcon Icon="ChevronLeft" IconSize="Size20" IconVariant="Regular" />
                    </Button>
                    <Button
                        x:Name="BtnGalleryNext"
                        MinWidth="48"
                        MinHeight="48"
                        Margin="0,0,16,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="BtnGalleryNext"
                        AutomationProperties.Name="Next"
                        Command="{x:Bind ViewModel.OverlayGallery.GoNextCommand, Mode=OneWay, FallbackValue={x:Null}}"
                        IsEnabled="{x:Bind ViewModel.OverlayGallery.CanGoNext, Mode=OneWay, FallbackValue=False}"
                        ToolTipService.ToolTip="Next">
                        <ic:FluentIcon Icon="ChevronRight" IconSize="Size20" IconVariant="Regular" />
                    </Button>
                    <Button
                        x:Name="BtnGalleryClose"
                        MinWidth="48"
                        MinHeight="48"
                        Margin="0,16,16,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="BtnGalleryClose"
                        AutomationProperties.Name="Close"
                        Command="{x:Bind ViewModel.CloseOverlayCommand}"
                        ToolTipService.ToolTip="Close">
                        <ic:FluentIcon Icon="Dismiss" IconSize="Size20" IconVariant="Regular" />
                    </Button>
                </Grid>

                <Border
                    x:Name="BrdGifScrub"
                    Grid.Row="1"
                    MaxWidth="640"
                    MinWidth="280"
                    Margin="16,8,16,0"
                    Padding="10,6"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="BrdGifScrub"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.CanScrubGif), Mode=OneWay, FallbackValue=Collapsed}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="BtnGifPause"
                            Padding="8,4"
                            AutomationProperties.AutomationId="BtnGifPause"
                            AutomationProperties.Name="Pause GIF"
                            Command="{x:Bind ViewModel.OverlayGallery.ToggleGifPlayCommand, Mode=OneWay, FallbackValue={x:Null}}"
                            ToolTipService.ToolTip="Pause"
                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.GifPlaying), Mode=OneWay, FallbackValue=Collapsed}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="Pause" IconSize="Size16" IconVariant="Regular" />
                                <TextBlock VerticalAlignment="Center" Text="Pause" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="BtnGifPlay"
                            Padding="8,4"
                            AutomationProperties.AutomationId="BtnGifPlay"
                            AutomationProperties.Name="Play GIF"
                            Command="{x:Bind ViewModel.OverlayGallery.ToggleGifPlayCommand, Mode=OneWay, FallbackValue={x:Null}}"
                            ToolTipService.ToolTip="Play"
                            Visibility="{x:Bind helpers:BindHelpers.InvertBoolToVisibility(ViewModel.OverlayGallery.GifPlaying), Mode=OneWay, FallbackValue=Collapsed}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="Play" IconSize="Size16" IconVariant="Regular" />
                                <TextBlock VerticalAlignment="Center" Text="Play" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="BtnGifPrevFrame"
                            Grid.Column="1"
                            Padding="8,4"
                            AutomationProperties.AutomationId="BtnGifPrevFrame"
                            AutomationProperties.Name="Previous frame"
                            Command="{x:Bind ViewModel.OverlayGallery.GifPreviousFrameCommand, Mode=OneWay, FallbackValue={x:Null}}"
                            ToolTipService.ToolTip="Previous frame">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="PreviousFrame" IconSize="Size16" IconVariant="Regular" />
                                <TextBlock VerticalAlignment="Center" Text="Prev frame" />
                            </StackPanel>
                        </Button>
                        <Slider
                            x:Name="SldGifFrame"
                            Grid.Column="2"
                            MinWidth="120"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="SldGifFrame"
                            AutomationProperties.Name="GIF frame"
                            Maximum="{x:Bind ViewModel.OverlayGallery.GifFrameMaximum, Mode=OneWay, FallbackValue=0}"
                            Minimum="0"
                            SnapsTo="StepValues"
                            StepFrequency="1"
                            TickPlacement="None"
                            Value="{x:Bind ViewModel.OverlayGallery.GifFrameIndex, Mode=TwoWay, FallbackValue=0}" />
                        <Button
                            x:Name="BtnGifNextFrame"
                            Grid.Column="3"
                            Padding="8,4"
                            AutomationProperties.AutomationId="BtnGifNextFrame"
                            AutomationProperties.Name="Next frame"
                            Command="{x:Bind ViewModel.OverlayGallery.GifNextFrameCommand, Mode=OneWay, FallbackValue={x:Null}}"
                            ToolTipService.ToolTip="Next frame">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="NextFrame" IconSize="Size16" IconVariant="Regular" />
                                <TextBlock VerticalAlignment="Center" Text="Next frame" />
                            </StackPanel>
                        </Button>
                        <TextBlock
                            x:Name="TxtGifFrame"
                            Grid.Column="4"
                            MinWidth="48"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="TxtGifFrame"
                            AutomationProperties.Name="GIF frame"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.OverlayGallery.GifFrameLabel, Mode=OneWay, FallbackValue=''}" />
                    </Grid>
                </Border>

                <Border
                    x:Name="BrdGalleryOverlayInfo"
                    Grid.Row="2"
                    MaxWidth="920"
                    MinWidth="280"
                    Margin="16,8,16,12"
                    Padding="10,6"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="BrdGalleryOverlayInfo"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.ShowDetails), Mode=OneWay, FallbackValue=Collapsed}">
                    <StackPanel Spacing="4">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            MaxWidth="280"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="TxtGalleryOverlayTitle"
                            AutomationProperties.Name="Gallery title"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.OverlayGallery.Title, Mode=OneWay, FallbackValue=''}"
                            TextTrimming="CharacterEllipsis" />
                        <ItemsControl
                            x:Name="LstGalleryOverlayTags"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="LstGalleryOverlayTags"
                            AutomationProperties.Name="Tags"
                            ItemsSource="{x:Bind ViewModel.OverlayGallery.Tags, Mode=OneWay, FallbackValue={x:Null}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid
                                        ItemHeight="28"
                                        MaximumRowsOrColumns="0"
                                        Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AssignedTagItem">
                                    <Border
                                        Padding="6,2"
                                        Background="{x:Bind helpers:TagColor.ChipFill(EffectiveColor), Mode=OneWay}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                        Opacity="{x:Bind ChromeOpacity, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ChipTooltip, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock
                                                Foreground="{x:Bind helpers:TagColor.ChipInk(EffectiveColor), Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind TagName, Mode=OneWay}" />
                                            <TextBlock
                                                Foreground="{x:Bind helpers:TagColor.ChipInk(EffectiveColor), Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind CountLabel, Mode=OneWay}"
                                                Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsPartial), Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            AutomationProperties.AutomationId="TxtGalleryOverlayPosition"
                            AutomationProperties.Name="Gallery position"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.OverlayGallery.PositionLabel, Mode=OneWay, FallbackValue=''}" />
                        <TextBlock
                            AutomationProperties.AutomationId="TxtGalleryOverlayDetails"
                            AutomationProperties.Name="Image details"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.OverlayGallery.DetailsText, Mode=OneWay, FallbackValue=''}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(ViewModel.OverlayGallery.DetailsText), Mode=OneWay, FallbackValue=Collapsed}" />
                        <TextBlock
                            AutomationProperties.AutomationId="TxtGalleryOverlayHdr"
                            AutomationProperties.Name="HDR status"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.OverlayGallery.HdrStatus, Mode=OneWay, FallbackValue=''}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(ViewModel.OverlayGallery.HdrStatus), Mode=OneWay, FallbackValue=Collapsed}" />
                    </StackPanel>
                    <StackPanel
                        AutomationProperties.AutomationId="PnlOverlayGeneration"
                        Spacing="4"
                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.ShowGeneration), Mode=OneWay, FallbackValue=Collapsed}">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Generation" />
                        <TextBlock
                            AutomationProperties.AutomationId="TxtOverlayModel"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.OverlayGallery.PreviewModel), Mode=OneWay, FallbackValue=''}"
                            TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Prompt" />
                        <ScrollViewer
                            AutomationProperties.AutomationId="ScrOverlayPrompt"
                            MaxHeight="120"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                AutomationProperties.AutomationId="TxtOverlayPrompt"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.OverlayGallery.PreviewPrompt), Mode=OneWay, FallbackValue=''}"
                                TextWrapping="Wrap" />
                        </ScrollViewer>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Negative" />
                        <ScrollViewer
                            AutomationProperties.AutomationId="ScrOverlayNegative"
                            MaxHeight="80"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.OverlayGallery.PreviewNegative), Mode=OneWay, FallbackValue=''}"
                                TextWrapping="Wrap" />
                        </ScrollViewer>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Seed" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.OverlayGallery.PreviewSeed), Mode=OneWay, FallbackValue=''}" />
                    </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
