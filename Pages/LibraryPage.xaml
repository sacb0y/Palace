                                IsEnabled="{x:Bind ViewModel.OverlayGallery.CanScale, Mode=OneWay, FallbackValue=True}"
                                ToolTipService.ToolTip="Fit (Ctrl+2)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:FluentIcon Icon="ScaleFit" IconSize="Size20" IconVariant="Regular" />
                                    <TextBlock VerticalAlignment="Center" Text="Fit" />
