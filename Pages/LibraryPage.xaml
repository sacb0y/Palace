                                    </StackPanel>
                                    <StackPanel
                                        Margin="6"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        IsHitTestVisible="False"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                        <Border
                                            Padding="4"
                                            AutomationProperties.AutomationId="{x:Bind VideoBadgeAutomationId, Mode=OneWay}"
                                            AutomationProperties.Name="Video"
                                            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ShowVideoBadge), Mode=OneWay}">
                                            <ic:FluentIcon
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                Icon="Video"
                                                IconSize="Size16"
                                                IconVariant="Regular" />
                                        </Border>
                                        <Border
                                            Padding="4"
                                            AutomationProperties.AutomationId="{x:Bind GifBadgeAutomationId, Mode=OneWay}"
                                            AutomationProperties.Name="GIF"
                                            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ShowGifBadge), Mode=OneWay}">
                                            <ic:FluentIcon
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                Icon="Gif"
                                                IconSize="Size16"
                                                IconVariant="Regular" />
                                        </Border>
                                        <Border
                                            Padding="8,5"
                                            AutomationProperties.AutomationId="{x:Bind HdrBadgeAutomationId, Mode=OneWay}"
                                            AutomationProperties.Name="HDR"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="4"
                                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ShowHdrBadge), Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <ic:FluentIcon
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Icon="Hdr"
                                                    IconSize="Size24"
                                                    IconVariant="Regular" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="HDR" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <Border
                                        Margin="6"
                                        Padding="4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        AutomationProperties.AutomationId="{x:Bind CloudBadgeAutomationId, Mode=OneWay}"
                                        AutomationProperties.Name="Cloud"
                                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        IsHitTestVisible="False"
                                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ShowCloudBadge), Mode=OneWay}">
                                        <ic:FluentIcon
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            Icon="Cloud"
                                            IconSize="Size16"
                                            IconVariant="Regular" />
                                    </Border>
                                    <!-- Context menu: "…" / right-click (not touch long-press). -->
                                    <Button
                                        Width="28"
                                        Height="28"
                                        Margin="4"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.AutomationId="BtnAssetMore"
                                        AutomationProperties.Name="More"
                                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                        BorderThickness="0"
                                        Click="AssetMore_Click"
                                        CornerRadius="14"
                                        ToolTipService.ToolTip="More">
                                        <ic:FluentIcon Icon="MoreVertical" IconSize="Size16" IconVariant="Regular" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </ItemContainer>
                    </DataTemplate>
                    </ItemsView.ItemTemplate>
                </ItemsView>
                <Border
                    x:Name="BrdStickyFolderHeader"
                    Height="34"
                    Padding="8,4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="BtnStickyCollapse"
                            Padding="2"
                            AutomationProperties.AutomationId="BtnStickyCollapse"
                            AutomationProperties.Name="Collapse section"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="BtnStickyCollapse_Click"
                            IsTabStop="False">
                            <ic:FluentIcon
                                x:Name="IcnStickyCollapse"
                                Icon="ChevronDown"
                                IconSize="Size16"
                                IconVariant="Regular" />
                        </Button>
                        <Button
                            Grid.Column="1"
                            Padding="2,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            AutomationProperties.AutomationId="BtnStickyFolderOpen"
                            AutomationProperties.Name="Open folder"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="BtnStickyFolderOpen_Click"
                            IsTabStop="False">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="Folder" IconSize="Size16" IconVariant="Regular" />
                                <TextBlock
                                    x:Name="TxtStickyFolderTitle"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis" />
                                <Border
                                    x:Name="BrdStickyFolderCount"
                                    Padding="6,1"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="8">
                                    <TextBlock
                                        x:Name="TxtStickyFolderCount"
                                        FontSize="11"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="2"
                            Padding="4,2"
                            AutomationProperties.AutomationId="BtnStickyOpenArrow"
                            AutomationProperties.Name="Open folder"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="BtnStickyFolderOpen_Click"
                            IsTabStop="False"
                            ToolTipService.ToolTip="Open folder">
                            <ic:FluentIcon Icon="Open" IconSize="Size16" IconVariant="Regular" />
                        </Button>
                        <ToggleButton
                            x:Name="TglStickyFlatten"
                            Grid.Column="3"
                            Padding="6,2"
                            AutomationProperties.AutomationId="TglStickyFlatten"
                            AutomationProperties.Name="Flatten subfolders"
                            Checked="TglStickyFlatten_Changed"
                            Unchecked="TglStickyFlatten_Changed">
                            <TextBlock FontSize="11" Text="Flatten" />
                        </ToggleButton>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <ScrollViewer
            x:Name="ScrPreviewPane"
            Grid.Row="1"
            Grid.Column="2"
            AutomationProperties.AutomationId="ScrPreviewPane"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Preview" />
                <Border
                    MinHeight="200"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <Grid>
                        <Image
                            x:Name="ImgPreview"
                            AutomationProperties.AutomationId="ImgPreview"
                            Stretch="Uniform"
                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.IsImagePreview), Mode=OneWay}" />
                        <MediaPlayerElement
                            x:Name="MpePreview"
                            AreTransportControlsEnabled="True"
                            AutoPlay="False"
                            AutomationProperties.AutomationId="MpePreview"
                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.IsVideoPreview), Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Select an asset"
                            Visibility="{x:Bind helpers:BindHelpers.InvertBoolToVisibility(ViewModel.HasSelection), Mode=OneWay}" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowPreviewPlaceholder), Mode=OneWay}">
                            <ic:FluentIcon
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Icon="{x:Bind helpers:FluentGlyph.Placeholder(ViewModel.PreviewPlaceholderKind), Mode=OneWay}"
                                IconSize="Size32"
                                IconVariant="Regular" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Online" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock
                    x:Name="TxtPreviewFileName"
                    AutomationProperties.AutomationId="TxtPreviewFileName"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.PreviewFileName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.HasSelection), Mode=OneWay}" />

                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Tags" />
                <TextBlock
                    x:Name="TxtAssignedTags"
                    AutomationProperties.AutomationId="TxtAssignedTags"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.AssignedTagsSummary, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowAssignedTagsSummary), Mode=OneWay}" />
                <ItemsRepeater
                    x:Name="LstTags"
                    AutomationProperties.AutomationId="LstTags"
                    AutomationProperties.HelpText="{x:Bind ViewModel.AssignedTagsSummary, Mode=OneWay}"
                    AutomationProperties.Name="Assigned"
                    ItemsSource="{x:Bind ViewModel.AssignedTags, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <helpers:ChipWrapLayout HorizontalSpacing="8" VerticalSpacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:AssignedTagItem">
                            <Border
                                MinWidth="0"
                                Padding="8,4"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="{x:Bind ChipAutomationName, Mode=OneWay}"
                                Background="{x:Bind helpers:TagColor.ChipFill(EffectiveColor), Mode=OneWay}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Opacity="{x:Bind ChromeOpacity, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{x:Bind helpers:TagColor.ChipInk(EffectiveColor), Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind TagName, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ChipTooltip, Mode=OneWay}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{x:Bind helpers:TagColor.ChipInk(EffectiveColor), Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind CountLabel, Mode=OneWay}"
                                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsPartial), Mode=OneWay}" />
                                    <Button
                                        Width="24"
                                        Height="24"
                                        Margin="-4,-4,-6,-4"
                                        Padding="4"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="{x:Bind RemoveAutomationId, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind RemoveAutomationName, Mode=OneWay}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{x:Bind pages:LibraryPage.GetRemoveTagCommand()}"
                                        CommandParameter="{x:Bind}"
                                        ToolTipService.ToolTip="{x:Bind RemoveAutomationName, Mode=OneWay}">
                                        <ic:FluentIcon
                                            Foreground="{x:Bind helpers:TagColor.ChipInk(EffectiveColor), Mode=OneWay}"
                                            Icon="Dismiss"
                                            IconSize="Size12"
                                            IconVariant="Regular" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <Button
                    x:Name="BtnBrowseTags"
                    AutomationProperties.AutomationId="BtnBrowseTags"
                    AutomationProperties.Name="Add tag"
                    Click="BtnBrowseTags_Click"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="Add" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock VerticalAlignment="Center" Text="Add tag" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout
                            x:Name="FlyAssignTags"
                            AutomationProperties.AutomationId="FlyAssignTags"
                            Opening="FlyAssignTags_Opening">
                            <ScrollViewer
                                MaxWidth="420"
                                MaxHeight="480"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel Width="400" Spacing="12">
                                    <AutoSuggestBox
                                        x:Name="AsbAssignTag"
                                        AutomationProperties.AutomationId="AsbAssignTag"
                                        AutomationProperties.Name="Find or create a tag"
                                        ItemsSource="{x:Bind ViewModel.TagSuggestions, Mode=OneWay}"
                                        PlaceholderText="Find or create a tag"
                                        QueryIcon="Find"
                                        QuerySubmitted="AsbAssignTag_QuerySubmitted"
                                        SuggestionChosen="AsbAssignTag_SuggestionChosen"
                                        TextChanged="AsbAssignTag_TextChanged"
                                        Text="{x:Bind ViewModel.TagQuery, Mode=OneWay}"
                                        TextMemberPath="Display"
                                        UpdateTextOnSelect="True">
                                        <AutoSuggestBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:TagPickItem">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse
                                                        Width="10"
                                                        Height="10"
                                                        VerticalAlignment="Center"
                                                        Fill="{x:Bind helpers:TagColor.ChipFill(EffectiveColor), Mode=OneTime}"
                                                        Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                        StrokeThickness="1"
                                                        Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(EffectiveColor), Mode=OneTime}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Text="{x:Bind Display, Mode=OneTime}" />
                                                </Grid>
                                            </DataTemplate>
                                        </AutoSuggestBox.ItemTemplate>
                                    </AutoSuggestBox>
                                    <TextBlock
                                        x:Name="TxtAssignChipLegend"
                                        AutomationProperties.AutomationId="TxtAssignChipLegend"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="✓ all selected · – some" />
                                    <Button
                                        AutomationProperties.AutomationId="BtnAssignTag"
                                        Click="BtnAssignTag_Click"
                                        Content="Assign tag"
                                        IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                                    <TextBlock
                                        x:Name="TxtAssignAnnouncement"
                                        AutomationProperties.LiveSetting="Assertive"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.AssignAnnouncement, Mode=OneWay}" />
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="Starred"
                                        Visibility="{x:Bind helpers:BindHelpers.CountToVisibility(ViewModel.StarredAssignTags.Count), Mode=OneWay}" />
                                    <ItemsRepeater
                                        ItemsSource="{x:Bind ViewModel.StarredAssignTags, Mode=OneWay}"
                                        Visibility="{x:Bind helpers:BindHelpers.CountToVisibility(ViewModel.StarredAssignTags.Count), Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <helpers:ChipWrapLayout HorizontalSpacing="6" VerticalSpacing="6" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:TagChipItem">
                                                <controls:TagChip
                                                    ApplyState="{x:Bind ApplyState, Mode=OneWay}"
                                                    ChipAutomationId="{x:Bind AutomationId, Mode=OneWay}"
                                                    Command="{x:Bind pages:LibraryPage.GetToggleAssignChipCommand()}"
                                                    CommandParameter="{x:Bind}"
                                                    Compact="True"
                                                    IsStarred="{x:Bind IsStarred, Mode=OneWay}"
                                                    Label="{x:Bind Name, Mode=OneWay}"
                                                    PartialCount="{x:Bind PartialCount, Mode=OneWay}"
                                                    SelectionTotal="{x:Bind SelectionTotal, Mode=OneWay}"
                                                    ShowStar="True"
                                                    TagColor="{x:Bind EffectiveColor, Mode=OneWay}" />
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="Recent"
                                        Visibility="{x:Bind helpers:BindHelpers.CountToVisibility(ViewModel.RecentAssignTags.Count), Mode=OneWay}" />
                                    <ItemsRepeater
                                        ItemsSource="{x:Bind ViewModel.RecentAssignTags, Mode=OneWay}"
                                        Visibility="{x:Bind helpers:BindHelpers.CountToVisibility(ViewModel.RecentAssignTags.Count), Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <helpers:ChipWrapLayout HorizontalSpacing="6" VerticalSpacing="6" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:TagChipItem">
                                                <controls:TagChip
                                                    ApplyState="{x:Bind ApplyState, Mode=OneWay}"
                                                    ChipAutomationId="{x:Bind AutomationId, Mode=OneWay}"
                                                    Command="{x:Bind pages:LibraryPage.GetToggleAssignChipCommand()}"
                                                    CommandParameter="{x:Bind}"
                                                    Compact="True"
                                                    IsStarred="{x:Bind IsStarred, Mode=OneWay}"
                                                    Label="{x:Bind Name, Mode=OneWay}"
                                                    PartialCount="{x:Bind PartialCount, Mode=OneWay}"
                                                    SelectionTotal="{x:Bind SelectionTotal, Mode=OneWay}"
                                                    ShowStar="True"
                                                    TagColor="{x:Bind EffectiveColor, Mode=OneWay}" />
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="Suggested"
                                        Visibility="{x:Bind helpers:BindHelpers.CountToVisibility(ViewModel.RecommendedAssignTags.Count), Mode=OneWay}" />
                                    <ItemsRepeater
                                        ItemsSource="{x:Bind ViewModel.RecommendedAssignTags, Mode=OneWay}"
                                        Visibility="{x:Bind helpers:BindHelpers.CountToVisibility(ViewModel.RecommendedAssignTags.Count), Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <helpers:ChipWrapLayout HorizontalSpacing="6" VerticalSpacing="6" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:TagChipItem">
                                                <controls:TagChip
                                                    ApplyState="{x:Bind ApplyState, Mode=OneWay}"
                                                    ChipAutomationId="{x:Bind AutomationId, Mode=OneWay}"
                                                    Command="{x:Bind pages:LibraryPage.GetToggleAssignChipCommand()}"
                                                    CommandParameter="{x:Bind}"
                                                    Compact="True"
                                                    IsStarred="{x:Bind IsStarred, Mode=OneWay}"
                                                    Label="{x:Bind Name, Mode=OneWay}"
                                                    PartialCount="{x:Bind PartialCount, Mode=OneWay}"
                                                    SelectionTotal="{x:Bind SelectionTotal, Mode=OneWay}"
                                                    ShowStar="True"
                                                    TagColor="{x:Bind EffectiveColor, Mode=OneWay}" />
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="All tags"
                                        Visibility="{x:Bind helpers:BindHelpers.CountToVisibility(ViewModel.AssignGroups.Count), Mode=OneWay}" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.AssignGroups, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:TagBoardGroup">
                                                <Expander
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
                                                    AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                                    Header="{x:Bind Name, Mode=OneWay}"
                                                    IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                                                    <ItemsRepeater ItemsSource="{x:Bind Chips, Mode=OneWay}">
                                                        <ItemsRepeater.Layout>
                                                            <helpers:ChipWrapLayout HorizontalSpacing="6" VerticalSpacing="6" />
                                                        </ItemsRepeater.Layout>
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="models:TagChipItem">
                                                                <controls:TagChip
                                                                    ApplyState="{x:Bind ApplyState, Mode=OneWay}"
                                                                    ChipAutomationId="{x:Bind AutomationId, Mode=OneWay}"
                                                                    Command="{x:Bind pages:LibraryPage.GetToggleAssignChipCommand()}"
                                                                    CommandParameter="{x:Bind}"
                                                                    Compact="True"
                                                                    IsStarred="{x:Bind IsStarred, Mode=OneWay}"
                                                                    Label="{x:Bind Name, Mode=OneWay}"
                                                                    PartialCount="{x:Bind PartialCount, Mode=OneWay}"
                                                                    SelectionTotal="{x:Bind SelectionTotal, Mode=OneWay}"
                                                                    ShowStar="True"
                                                                    TagColor="{x:Bind EffectiveColor, Mode=OneWay}" />
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <StackPanel
                    AutomationProperties.AutomationId="PnlGeneration"
                    Spacing="12"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowGeneration), Mode=OneWay}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Generation" />
                    <TextBlock
                        AutomationProperties.AutomationId="TxtModel"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.PreviewModel), Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Prompt" />
                    <ScrollViewer
                        AutomationProperties.AutomationId="ScrPrompt"
                        MaxHeight="180"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            AutomationProperties.AutomationId="TxtPrompt"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.PreviewPrompt), Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Negative" />
                    <ScrollViewer
                        AutomationProperties.AutomationId="ScrNegative"
                        MaxHeight="120"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.PreviewNegative), Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Seed" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.PreviewSeed), Mode=OneWay}" />
                </StackPanel>

                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Notes and rating" />
                <RatingControl
                    AutomationProperties.AutomationId="RtgAsset"
                    Caption="Rating"
                    IsEnabled="{x:Bind ViewModel.CanEditNotes, Mode=OneWay}"
                    PlaceholderValue="0"
                    Value="{x:Bind ViewModel.PreviewRating, Mode=TwoWay}" />
                <TextBox
                    AutomationProperties.AutomationId="TxtNotes"
                    AcceptsReturn="True"
                    Header="Notes"
                    IsEnabled="{x:Bind ViewModel.CanEditNotes, Mode=OneWay}"
                    Text="{x:Bind ViewModel.PreviewNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Prompt suggestions"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowGeneration), Mode=OneWay}" />
                <ListView
                    x:Name="LstSuggestions"
                    AutomationProperties.AutomationId="LstSuggestions"
                    ItemsSource="{x:Bind ViewModel.Suggestions, Mode=OneWay}"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowGeneration), Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PromptSuggestion">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind Token, Mode=OneTime}" />
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.Name="Accept suggestion"
                                    Command="{x:Bind pages:LibraryPage.GetAcceptSuggestionCommand()}"
                                    CommandParameter="{x:Bind}"
                                    Content="Add" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    Spacing="8"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowOrganizePanel), Mode=OneWay}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Organize preview" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="From" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="To" />
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Status" />
                    </Grid>
