                <TextBlock
                    x:Name="TxtAssignedTags"
                    AutomationProperties.AutomationId="TxtAssignedTags"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.AssignedTagsSummary, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowAssignedTagsSummary), Mode=OneWay}" />
                <ItemsRepeater
                    x:Name="LstTags"
                    AutomationProperties.AutomationId="LstTags"
                    AutomationProperties.HelpText="{x:Bind ViewModel.AssignedTagsSummary, Mode=OneWay}"
                    AutomationProperties.Name="Assigned"
                    ItemsSource="{x:Bind ViewModel.AssignedTags, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <helpers:ChipWrapLayout HorizontalSpacing="8" VerticalSpacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:AssignedTagItem">
                            <controls:TagChip
                                HorizontalAlignment="Left"
                                ApplyState="{x:Bind ApplyState, Mode=OneWay}"
                                ChipAutomationName="{x:Bind ChipAutomationName, Mode=OneWay}"
                                ChipTooltip="{x:Bind ChipTooltip, Mode=OneWay}"
                                Command="{x:Bind pages:LibraryPage.GetToggleAssignedChipCommand()}"
                                CommandParameter="{x:Bind}"
                                IsRecentlyCreated="{x:Bind IsRecentlyCreated, Mode=OneWay}"
                                IsSelected="{x:Bind IsChipSelected, Mode=OneWay}"
                                Label="{x:Bind TagName, Mode=OneWay}"
                                PartialCount="{x:Bind AppliedCount, Mode=OneWay}"
                                RemoveAutomationId="{x:Bind RemoveAutomationId, Mode=OneWay}"
                                RemoveAutomationName="{x:Bind RemoveAutomationName, Mode=OneWay}"
                                RemoveCommand="{x:Bind pages:LibraryPage.GetRemoveTagCommand()}"
                                RemoveCommandParameter="{x:Bind}"
                                SelectionTotal="{x:Bind SelectionTotal, Mode=OneWay}"
                                ShowAppliedCheck="{x:Bind ShowOnAllCheck, Mode=OneWay}"
                                ShowRemove="{x:Bind ShowRemove, Mode=OneWay}"
                                ShowTrailingLink="{x:Bind ShowAlsoImpliedLink, Mode=OneWay}"
                                TagColor="{x:Bind DotColor, Mode=OneWay}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <!-- T8 Option A: Implied by tag rules (own subsection; no ×). -->
                <StackPanel
                    Spacing="6"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.HasImpliedAssignedTags), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:FluentIcon
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Icon="Link"
                            IconSize="Size16"
                            IconVariant="Regular" />
                        <TextBlock
                            x:Name="TxtImpliedByRules"
                            AutomationProperties.AutomationId="TxtImpliedByRules"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.ImpliedSectionTitle, Mode=OneWay}" />
                    </StackPanel>
                    <ItemsRepeater
                        x:Name="LstImpliedTags"
                        AutomationProperties.AutomationId="LstImpliedTags"
                        AutomationProperties.Name="{x:Bind ViewModel.ImpliedSectionTitle, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.ImpliedAssignedTags, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <helpers:ChipWrapLayout HorizontalSpacing="8" VerticalSpacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:AssignedTagItem">
                                <controls:TagChip
                                    HorizontalAlignment="Left"
                                    ApplyState="Off"
                                    ChipAutomationName="{x:Bind ChipAutomationName, Mode=OneWay}"
                                    ChipTooltip="{x:Bind ChipTooltip, Mode=OneWay}"
                                    DotOpacity="0.55"
                                    IsTabStop="True"
                                    Label="{x:Bind TagName, Mode=OneWay}"
                                    ShowLeadingLink="True"
                                    Tag="{x:Bind}"
                                    TagColor="{x:Bind DotColor, Mode=OneWay}">
                                    <controls:TagChip.ContextFlyout>
                                        <MenuFlyout Opening="ImpliedChipMenu_Opening">
                                            <MenuFlyoutItem
                                                AutomationProperties.AutomationId="MnuImpliedByHeader"
                                                IsEnabled="False"
                                                Text="Implied by tag rules"
                                                Tag="header">
                                                <MenuFlyoutItem.Icon>
                                                    <ic:FluentIcon Icon="Link" IconSize="Size16" IconVariant="Regular" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem
                                                AutomationProperties.AutomationId="MnuImpliedEditRule"
                                                Command="{x:Bind pages:LibraryPage.GetEditImpliedRuleCommand()}"
                                                CommandParameter="{x:Bind}"
                                                Tag="edit"
                                                Text="Edit implication rule…">
                                                <MenuFlyoutItem.Icon>
                                                    <ic:FluentIcon Icon="Edit" IconSize="Size16" IconVariant="Regular" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem
                                                AutomationProperties.AutomationId="MnuImpliedFilterTag"
                                                Command="{x:Bind pages:LibraryPage.GetFilterByImpliedTagCommand()}"
                                                CommandParameter="{x:Bind}"
                                                Text="Filter by tag"
                                                Tag="filter">
                                                <MenuFlyoutItem.Icon>
                                                    <ic:FluentIcon Icon="Filter" IconSize="Size16" IconVariant="Regular" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem
                                                AutomationProperties.AutomationId="MnuImpliedAddManual"
                                                Command="{x:Bind pages:LibraryPage.GetAddImpliedAsManualCommand()}"
                                                CommandParameter="{x:Bind}"
                                                Text="Add as manual tag">
                                                <MenuFlyoutItem.Icon>
                                                    <ic:FluentIcon Icon="Add" IconSize="Size16" IconVariant="Regular" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem
                                                AutomationProperties.AutomationId="MnuImpliedGoToTag"
                                                Command="{x:Bind pages:LibraryPage.GetGoToImpliedTagCommand()}"
                                                CommandParameter="{x:Bind}"
                                                Text="Go to tag">
                                                <MenuFlyoutItem.Icon>
                                                    <ic:FluentIcon Icon="Tag" IconSize="Size16" IconVariant="Regular" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </controls:TagChip.ContextFlyout>
                                </controls:TagChip>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
                <Border
                    Padding="12,6,6,6"
                    Background="{ThemeResource AccentFillColorTertiaryBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowRemoveFromAllBar), Mode=OneWay}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.RemoveFromAllSummary, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="BtnRemoveFromAll"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="BtnRemoveFromAll"
                            AutomationProperties.Name="Remove from all"
                            Command="{x:Bind ViewModel.RemoveSelectedAssignedTagsCommand}"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon
                                    VerticalAlignment="Center"
                                    Icon="Delete"
                                    IconSize="Size16"
                                    IconVariant="Regular" />
                                <TextBlock VerticalAlignment="Center" Text="Remove from all" />
                                <Border
                                    Padding="5,0"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Del" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- T2 merged Add tags box (shortcut T). Keeps AsbAssignTag / BtnAssignTag AutomationIds. -->
                <StackPanel
                    x:Name="PnlAddTags"
                    Spacing="8"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.HasSelection), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Add tags" />
                        <Border
                            Padding="5,0"
                            VerticalAlignment="Center"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="11"
                                Text="T" />
                        </Border>
                    </StackPanel>
                    <!-- One accent-underlined field; AutoSuggestBox border cleared (no box-in-box). -->
                    <Border
                        MinHeight="40"
                        Padding="6,4"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="1,1,1,2"
                        CornerRadius="4">
                        <StackPanel Spacing="6">
                            <ItemsRepeater
                                x:Name="RepPendingTags"
                                AutomationProperties.AutomationId="RepPendingTags"
                                ItemsSource="{x:Bind ViewModel.PendingTags, Mode=OneWay}"
                                Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.HasPendingTags), Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <helpers:ChipWrapLayout HorizontalSpacing="5" VerticalSpacing="5" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:PendingTagChip">
                                        <controls:TagChip
                                            HorizontalAlignment="Left"
                                            ApplyState="Off"
                                            Compact="True"
                                            Label="{x:Bind FaceLabel, Mode=OneWay}"
                                            RemoveAutomationId="{x:Bind AutomationId, Mode=OneWay}"
                                            RemoveAutomationName="{x:Bind RemoveAutomationName, Mode=OneWay}"
                                            RemoveCommand="{x:Bind pages:LibraryPage.GetRemovePendingTagCommand()}"
                                            RemoveCommandParameter="{x:Bind}"
                                            ShowNewBadge="{x:Bind IsNew, Mode=OneWay}"
                                            ShowRemove="True"
                                            TagColor="{x:Bind DotColor, Mode=OneWay}" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <!-- Typing only: ASB popup reverses items when it opens above the box
                                 (preview pane), which put Create first on screen. Owned list below. -->
                            <AutoSuggestBox
                                x:Name="AsbAssignTag"
                                AutomationProperties.AutomationId="AsbAssignTag"
                                AutomationProperties.Name="Add tags"
                                Background="Transparent"
                                BorderThickness="0"
                                PlaceholderText="Add tags — type, or paste a list"
                                PreviewKeyDown="AsbAssignTag_PreviewKeyDown"
                                QuerySubmitted="AsbAssignTag_QuerySubmitted"
                                TextChanged="AsbAssignTag_TextChanged"
                                Text="{x:Bind ViewModel.TagQuery, Mode=OneWay}" />
                            <!-- t2-02 rows: Create always last (no ASB popup reorder). -->
                            <StackPanel
                                Spacing="2"
                                Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowTagSuggestions), Mode=OneWay}">
                                <ListView
                                    x:Name="LstTagSuggestions"
                                    MaxHeight="280"
                                    AutomationProperties.AutomationId="LstTagSuggestions"
                                    AutomationProperties.Name="Tag suggestions"
                                    IsItemClickEnabled="True"
                                    ItemClick="LstTagSuggestions_ItemClick"
                                    ItemsSource="{x:Bind ViewModel.TagSuggestions, Mode=OneWay}"
                                    KeyDown="LstTagSuggestions_KeyDown"
                                    SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:TagPickItem">
                                            <Grid MinHeight="36" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="34" />
                                                </Grid.ColumnDefinitions>
                                                <Grid
                                                    Grid.ColumnSpan="4"
                                                    ColumnSpacing="8"
                                                    Visibility="{x:Bind helpers:BindHelpers.InvertBoolToVisibility(IsCreateRow), Mode=OneTime}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="34" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse
                                                        Width="8"
                                                        Height="8"
                                                        VerticalAlignment="Center"
                                                        Fill="{x:Bind helpers:TagColor.ChipFill(EffectiveColor), Mode=OneTime}"
                                                        Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                        StrokeThickness="1" />
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        VerticalAlignment="Center">
                                                        <TextBlock VerticalAlignment="Center">
                                                            <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind MatchBefore, Mode=OneTime}" />
                                                            <Run FontWeight="SemiBold" Text="{x:Bind MatchText, Mode=OneTime}" />
                                                            <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind MatchAfter, Mode=OneTime}" />
                                                        </TextBlock>
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="›"
                                                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsAliasHit), Mode=OneTime}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Text="{x:Bind AliasCanonicalName, Mode=OneTime}"
                                                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsAliasHit), Mode=OneTime}" />
                                                        <Border
                                                            Padding="4,0"
                                                            VerticalAlignment="Center"
                                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsAliasHit), Mode=OneTime}">
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{x:Bind helpers:TagAddInput.AliasPillLabel}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind GroupName, Mode=OneTime}" />
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind UseCountText, Mode=OneTime}"
                                                        TextAlignment="Right" />
                                                </Grid>
                                                <StackPanel
                                                    Grid.ColumnSpan="4"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsCreateRow), Mode=OneTime}">
                                                    <ic:FluentIcon
                                                        VerticalAlignment="Center"
                                                        Icon="Add"
                                                        IconSize="Size16"
                                                        IconVariant="Regular" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Display, Mode=OneTime}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock
                                    x:Name="TxtTagSuggestions"
                                    AutomationProperties.AutomationId="TxtTagSuggestions"
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.TagSuggestionsSummary, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="TxtTagSuggestionHints"
                                    AutomationProperties.AutomationId="TxtTagSuggestionHints"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    FontSize="11"
                                    Text="{x:Bind helpers:TagAddInput.SuggestionHints}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock
                        x:Name="TxtPendingSummary"
                        AutomationProperties.AutomationId="TxtPendingSummary"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.PendingSummary, Mode=OneWay}"
                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowPendingSummary), Mode=OneWay}" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.HasPendingTags), Mode=OneWay}">
                        <Button
                            x:Name="BtnAssignTag"
                            AutomationProperties.AutomationId="BtnAssignTag"
                            AutomationProperties.Name="Apply tags"
                            Click="BtnAssignTag_Click"
                            Content="{x:Bind ViewModel.ApplyPendingLabel, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanApplyPendingTags, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="BtnClearPendingTags"
                            AutomationProperties.AutomationId="BtnClearPendingTags"
                            Command="{x:Bind ViewModel.ClearPendingTagsCommand}"
                            Content="Clear" />
                    </StackPanel>
                    <TextBlock
                        x:Name="TxtApplyPendingHint"
                        AutomationProperties.AutomationId="TxtApplyPendingHint"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.ApplyPendingHint, Mode=OneWay}"
                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.HasPendingTags), Mode=OneWay}" />
                    <!-- UIA live region only — status bar owns the visible confirmation (t2-03a). -->
                    <TextBlock
                        x:Name="TxtAssignAnnouncement"
                        Width="1"
                        Height="1"
                        Margin="0"
                        Padding="0"
                        AutomationProperties.LiveSetting="Assertive"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        IsHitTestVisible="False"
                        Opacity="0"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.AssignAnnouncement, Mode=OneWay}" />
                </StackPanel>

                <!-- Audit (k): From-prompt suggestion chips (replaces LstSuggestions ListView). -->
                <StackPanel
                    x:Name="PnlPromptSuggestions"
                    Spacing="8"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowPromptSuggestions), Mode=OneWay}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:FluentIcon
                                VerticalAlignment="Center"
                                Icon="Star"
                                IconSize="Size16"
                                IconVariant="Regular" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.PromptSuggestionsHeader, Mode=OneWay}" />
                            <TextBlock
                                x:Name="TxtPromptSuggestionsCount"
                                AutomationProperties.AutomationId="TxtPromptSuggestionsCount"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.PromptSuggestionsCountLabel, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                x:Name="BtnAcceptAllPrompt"
                                AutomationProperties.AutomationId="BtnAcceptAllPrompt"
                                AutomationProperties.Name="{x:Bind ViewModel.AcceptAllPromptLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.AcceptAllPromptSuggestionsCommand}"
                                Content="{x:Bind ViewModel.AcceptAllPromptLabel, Mode=OneWay}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowAcceptAllPrompt), Mode=OneWay}" />
                            <Button
                                x:Name="BtnDismissAllPrompt"
                                AutomationProperties.AutomationId="BtnDismissAllPrompt"
                                AutomationProperties.Name="Dismiss all prompt suggestions"
                                Command="{x:Bind ViewModel.DismissAllPromptSuggestionsCommand}"
                                Content="Dismiss all"
                                Style="{StaticResource SubtleButtonStyle}" />
                        </StackPanel>
                    </Grid>
                    <ItemsRepeater
                        x:Name="RepPromptSuggestions"
                        AutomationProperties.AutomationId="RepPromptSuggestions"
                        AutomationProperties.Name="From prompt suggestions"
                        ItemsSource="{x:Bind ViewModel.Suggestions, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <helpers:ChipWrapLayout HorizontalSpacing="5" VerticalSpacing="5" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:PromptSuggestion">
                                <controls:TagChip
                                    HorizontalAlignment="Left"
                                    ApplyState="Off"
                                    ChipAutomationId="{x:Bind AutomationId, Mode=OneWay}"
                                    ChipAutomationName="{x:Bind ChipAutomationName, Mode=OneWay}"
                                    ChipTooltip="{x:Bind ChipTooltip, Mode=OneWay}"
                                    Command="{x:Bind pages:LibraryPage.GetAcceptPromptSuggestionCommand()}"
                                    CommandParameter="{x:Bind}"
                                    Compact="True"
                                    IsPromptSuggestion="True"
                                    Label="{x:Bind FaceLabel, Mode=OneWay}"
                                    PartialCount="{x:Bind MatchCount, Mode=OneWay}"
                                    RemoveAutomationId="{x:Bind RemoveAutomationId, Mode=OneWay}"
                                    RemoveAutomationName="{x:Bind RemoveAutomationName, Mode=OneWay}"
                                    RemoveCommand="{x:Bind pages:LibraryPage.GetDismissPromptSuggestionCommand()}"
                                    RemoveCommandParameter="{x:Bind}"
                                    SelectionTotal="{x:Bind SelectionTotal, Mode=OneWay}"
                                    ShowNewBadge="{x:Bind IsNew, Mode=OneWay}"
                                    ShowRemove="True"
                                    TagColor="{x:Bind DotColor, Mode=OneWay}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock
                        x:Name="TxtPromptIgnored"
                        AutomationProperties.AutomationId="TxtPromptIgnored"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.PromptIgnoredCaption, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowPromptIgnoredCaption), Mode=OneWay}" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6"
                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowPromptAutoTaggerPlaceholder), Mode=OneWay}">
                        <ic:FluentIcon
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Icon="ChevronRight"
                            IconSize="Size12"
                            IconVariant="Regular" />
                        <TextBlock
                            x:Name="TxtPromptAutoTaggerLater"
                            AutomationProperties.AutomationId="TxtPromptAutoTaggerLater"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="From auto-tagger" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="later (T9)" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    AutomationProperties.AutomationId="PnlGeneration"
                    Spacing="12"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowGeneration), Mode=OneWay}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Generation" />
                    <TextBlock
                        AutomationProperties.AutomationId="TxtModel"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.PreviewModel), Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Prompt" />
                    <ScrollViewer
                        AutomationProperties.AutomationId="ScrPrompt"
                        MaxHeight="180"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            AutomationProperties.AutomationId="TxtPrompt"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.PreviewPrompt), Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Negative" />
                    <ScrollViewer
                        AutomationProperties.AutomationId="ScrNegative"
                        MaxHeight="120"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.PreviewNegative), Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Seed" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.PreviewSeed), Mode=OneWay}" />
                </StackPanel>

                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Notes and rating" />
                <RatingControl
                    AutomationProperties.AutomationId="RtgAsset"
                    Caption="{x:Bind ViewModel.RatingCaption, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanEditRating, Mode=OneWay}"
                    PlaceholderValue="0"
                    Value="{x:Bind ViewModel.PreviewRating, Mode=TwoWay}" />
                <TextBox
                    AutomationProperties.AutomationId="TxtNotes"
                    AcceptsReturn="True"
                    Header="Notes"
                    IsEnabled="{x:Bind ViewModel.CanEditNotes, Mode=OneWay}"
                    Text="{x:Bind ViewModel.PreviewNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <StackPanel
                    Spacing="8"
