        <!-- Real ColPreview slot. Stay Visibility=Visible; hide via Opacity=0 + column width 0
             (Collapsed→Visible after the first show left the pane over the folder tree — #177).
             Opaque base fill so mosaic never shows through Tags / Notes / empty state. -->
        <Grid
            x:Name="GrdPreviewDockHost"
            Grid.Row="1"
            Grid.Column="2"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Opacity="0"
            IsHitTestVisible="False"
