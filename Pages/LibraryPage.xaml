                                ToolTipService.ToolTip="Loop video"
                                Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.IsVideo), Mode=OneWay, FallbackValue=Collapsed}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:FluentIcon Icon="ArrowRepeatAll" IconSize="Size16" IconVariant="Regular" />
                                    <TextBlock VerticalAlignment="Center" Text="Loop" />
                                </StackPanel>
