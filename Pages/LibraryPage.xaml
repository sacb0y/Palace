                                            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ShowGifBadge), Mode=OneWay}">
                                            <ic:FluentIcon
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                Icon="Gif"
                                                IconSize="Size16"
                                                IconVariant="Regular" />
                                        </Border>
                                        <Border
                                            Padding="8,5"
                                            AutomationProperties.AutomationId="{x:Bind HdrBadgeAutomationId, Mode=OneWay}"
