                    BorderThickness="0"
                    Command="{x:Bind ViewModel.UndoFileOpCommand}"
                    Content="Undo"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowStatusUndo), Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Ctrl+Z"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowStatusUndo), Mode=OneWay}" />
                <HyperlinkButton
                    x:Name="BtnStatusDetails"
                    Padding="4,0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="BtnStatusDetails"
                    AutomationProperties.Name="{x:Bind ViewModel.StatusDetailsLinkLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ShowStatusDetailsCommand}"
                    Content="{x:Bind ViewModel.StatusDetailsLinkLabel, Mode=OneWay}"
                    FontSize="12"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.HasStatusDetails), Mode=OneWay}" />
                <Button
                    x:Name="BtnStatusShowFailures"
                    Padding="10,2"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="BtnStatusShowFailures"
