<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Palace.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Palace.Helpers"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Palace.Controls"
    xmlns:models="using:Palace.Models"
    xmlns:pages="using:Palace.Pages"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <DataTemplate x:Key="MoveDestinationTemplate" x:DataType="models:MoveDestinationItem">
            <StackPanel
                AutomationProperties.Name="{x:Bind Display}"
                Orientation="Horizontal"
                Spacing="8">
                <ic:FluentIcon
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource AccentTextFillColorSecondaryBrush}"
                    Icon="{x:Bind helpers:FluentGlyph.MoveDestinationIcon(IsRecent)}"
                    IconSize="Size16"
                    IconVariant="Regular" />
                <TextBlock VerticalAlignment="Center" Text="{x:Bind Display}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="MoveDestinationHeaderTemplate" x:DataType="pages:MoveDestinationHeader">
            <TextBlock
                Margin="0,8,0,4"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Title}" />
        </DataTemplate>
    </Page.Resources>

    <Grid PreviewKeyDown="LibraryRoot_PreviewKeyDown">
    <Grid
        x:Name="GrdLibraryColumns"
        Padding="12,8,12,8"
        ColumnSpacing="12"
        IsHitTestVisible="{x:Bind helpers:BindHelpers.Not(ViewModel.IsGalleryOverlayOpen), Mode=OneWay}"
        RowSpacing="8"
        SizeChanged="GrdLibraryColumns_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Fixed widths from LibraryColumnLayout.Allocate (no Star / no mosaic MinWidth
                 floor — that pinned DesiredSize after Preview show and froze resize). -->
            <ColumnDefinition
                x:Name="ColFolderTree"
                Width="260"
                MinWidth="0" />
            <ColumnDefinition
                x:Name="ColMosaic"
                Width="560"
                MinWidth="0" />
            <ColumnDefinition
                x:Name="ColPreview"
                Width="340"
                MinWidth="0" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="3" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Narrow widths: New folder / Undo / Add to room move into BtnLibraryToolbarMore. -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    AutomationProperties.AutomationId="BtnAddFolder"
                    AutomationProperties.Name="Add folder"
                    Command="{x:Bind ViewModel.AddFolderCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="FolderAdd" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock VerticalAlignment="Center" Text="Add folder" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.AutomationId="BtnScan"
                    AutomationProperties.Name="Scan"
                    Command="{x:Bind ViewModel.ScanCommand}"
                    IsEnabled="{x:Bind helpers:BindHelpers.Not(ViewModel.IsBusy), Mode=OneWay}"
                    Style="{x:Bind helpers:BindHelpers.AccentButtonWhen(ViewModel.AccentScan), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="ArrowSync" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock VerticalAlignment="Center" Text="Scan" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="BtnOrganize"
                    AutomationProperties.AutomationId="BtnOrganize"
                    AutomationProperties.Name="Organize"
                    Command="{x:Bind ViewModel.PreviewOrganizeCommand}"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                    Style="{x:Bind helpers:BindHelpers.AccentButtonWhen(ViewModel.HasSelection), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="FolderArrowRight" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock VerticalAlignment="Center" Text="Organize" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="BtnReview"
                    AutomationProperties.AutomationId="BtnReview"
                    AutomationProperties.Name="Review"
                    Command="{x:Bind ViewModel.StartReviewCommand}"
                    ToolTipService.ToolTip="Review selection or this folder (swipe left reject, right keep, up skip)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="CheckmarkCircle" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock VerticalAlignment="Center" Text="Review" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="BtnNewFolder"
                    AutomationProperties.AcceleratorKey="Control+Shift+N"
                    AutomationProperties.AutomationId="BtnNewFolder"
                    AutomationProperties.HelpText="New folder in the selected folder"
                    AutomationProperties.Name="New folder"
                    Command="{x:Bind ViewModel.NewFolderCommand}"
                    ToolTipService.ToolTip="New folder (Ctrl+Shift+N)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="FolderAdd" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock VerticalAlignment="Center" Text="New folder" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="BtnUndo"
                    AutomationProperties.AcceleratorKey="Control+Z"
                    AutomationProperties.AutomationId="BtnUndo"
                    AutomationProperties.HelpText="{x:Bind ViewModel.UndoLabel, Mode=OneWay}"
                    AutomationProperties.Name="Undo"
                    Command="{x:Bind ViewModel.UndoFileOpCommand}"
                    IsEnabled="{x:Bind ViewModel.CanUndoFileOp, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.UndoToolTip, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="ArrowUndo" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock VerticalAlignment="Center" Text="Undo" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="BtnAddToRoom"
                    AutomationProperties.AutomationId="BtnAddToRoom"
                    AutomationProperties.Name="Add to room"
                    Command="{x:Bind ViewModel.AddSelectionToRoomCommand}"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="Door" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock VerticalAlignment="Center" Text="Add to room" />
                    </StackPanel>
                </Button>
                <DropDownButton
                    x:Name="BtnLibraryToolbarMore"
                    MinWidth="32"
                    MinHeight="32"
                    AutomationProperties.AutomationId="BtnLibraryToolbarMore"
                    AutomationProperties.Name="More library actions"
                    ToolTipService.ToolTip="More"
                    Visibility="Collapsed">
                    <ic:FluentIcon Icon="MoreHorizontal" IconSize="Size16" IconVariant="Regular" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <!-- Visibility toggled with tight in UpdateLibraryToolbarOverflow. -->
                            <MenuFlyoutItem
                                x:Name="MnuToolbarOrganize"
                                AutomationProperties.AutomationId="MnuToolbarOrganize"
                                Command="{x:Bind ViewModel.PreviewOrganizeCommand}"
                                IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                Text="Organize"
                                Visibility="Collapsed" />
                            <MenuFlyoutItem
                                x:Name="MnuToolbarReview"
                                AutomationProperties.AutomationId="MnuToolbarReview"
                                Command="{x:Bind ViewModel.StartReviewCommand}"
                                Text="Review"
                                ToolTipService.ToolTip="Review selection or this folder (swipe left reject, right keep, up skip)"
                                Visibility="Collapsed" />
                            <MenuFlyoutSeparator
                                x:Name="SepToolbarTight"
                                Visibility="Collapsed" />
                            <MenuFlyoutItem
                                x:Name="MnuToolbarNewFolder"
                                AutomationProperties.AutomationId="MnuToolbarNewFolder"
                                Command="{x:Bind ViewModel.NewFolderCommand}"
                                Text="New folder" />
                            <MenuFlyoutItem
                                x:Name="MnuToolbarUndo"
                                AutomationProperties.AutomationId="MnuToolbarUndo"
                                Command="{x:Bind ViewModel.UndoFileOpCommand}"
                                IsEnabled="{x:Bind ViewModel.CanUndoFileOp, Mode=OneWay}"
                                Text="Undo" />
                            <MenuFlyoutItem
                                x:Name="MnuToolbarAddToRoom"
                                AutomationProperties.AutomationId="MnuToolbarAddToRoom"
                                Command="{x:Bind ViewModel.AddSelectionToRoomCommand}"
                                IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                Text="Add to room" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            <Grid
                Grid.Row="1"
                ColumnSpacing="8"
                Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.IsBusy), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    x:Name="PrgLibrary"
                    Height="4"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="PrgLibrary"
                    AutomationProperties.Name="Library loading"
                    IsIndeterminate="True"
                    ShowPaused="False" />
                <Button
                    Grid.Column="1"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="BtnBusyCancel"
                    AutomationProperties.Name="Cancel"
                    Command="{x:Bind ViewModel.CancelBusyCommand}"
                    Content="Cancel"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.CanCancelBusy), Mode=OneWay}" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <SelectorBar
                x:Name="SelBrowseMode"
                AutomationProperties.AutomationId="SelBrowseMode"
                AutomationProperties.Name="Browse by"
                SelectionChanged="SelBrowseMode_SelectionChanged">
                <SelectorBarItem
                    x:Name="SelFolders"
                    AutomationProperties.AutomationId="SelFolders"
                    IsSelected="True"
                    Text="Folders" />
                <SelectorBarItem
                    x:Name="SelTags"
                    AutomationProperties.AutomationId="SelTags"
                    Text="Tags" />
            </SelectorBar>
            <SelectorBar
                x:Name="SelTagMatch"
                Grid.Row="1"
                AutomationProperties.AutomationId="SelTagMatch"
                AutomationProperties.Name="Tag match"
                SelectionChanged="SelTagMatch_SelectionChanged"
                Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.IsTagBrowse), Mode=OneWay}">
                <SelectorBarItem
                    x:Name="SelTagMatchAll"
                    AutomationProperties.AutomationId="SelTagMatchAll"
                    IsSelected="True"
                    Text="All" />
                <SelectorBarItem
                    x:Name="SelTagMatchAny"
                    AutomationProperties.AutomationId="SelTagMatchAny"
                    Text="Any" />
                <SelectorBarItem
                    x:Name="SelTagMatchNone"
                    AutomationProperties.AutomationId="SelTagMatchNone"
                    Text="None" />
            </SelectorBar>
            <ItemsRepeater
                x:Name="LstTagFilters"
                Grid.Row="2"
                AutomationProperties.AutomationId="LstTagFilters"
                AutomationProperties.Name="Selected tags"
                ItemsSource="{x:Bind ViewModel.SelectedFilterTags, Mode=OneWay}"
                Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowTagFilterChips), Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <helpers:ChipWrapLayout HorizontalSpacing="6" VerticalSpacing="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:TagChipItem">
                        <Button
                            MinWidth="0"
                            Padding="8,4"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                            AutomationProperties.HelpText="Remove filter"
                            Command="{x:Bind pages:LibraryPage.GetRemoveFilterTagCommand()}"
                            CommandParameter="{x:Bind}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border
                                    Width="10"
                                    Height="10"
                                    Background="{x:Bind helpers:TagColor.ChipFill(EffectiveColor), Mode=OneWay}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind Name, Mode=OneWay}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Remove" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <Grid
                Grid.Row="2"
                ColumnSpacing="4"
                Visibility="{x:Bind helpers:BindHelpers.InvertBoolToVisibility(ViewModel.IsTagBrowse), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Folders" />
                <DropDownButton
                    x:Name="BtnFolderSort"
                    Grid.Column="1"
                    MinWidth="32"
                    MinHeight="32"
                    AutomationProperties.AutomationId="BtnFolderSort"
                    AutomationProperties.HelpText="{x:Bind ViewModel.FolderSortLabel, Mode=OneWay}"
                    AutomationProperties.Name="Sort folders"
                    ToolTipService.ToolTip="{x:Bind ViewModel.FolderSortLabel, Mode=OneWay}">
                    <ic:FluentIcon Icon="ArrowSort" IconSize="Size16" IconVariant="Regular" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <RadioMenuFlyoutItem
                                AutomationProperties.AutomationId="MnuFolderSortNameAsc"
                                Command="{x:Bind ViewModel.SetFolderSortCommand}"
                                CommandParameter="NameAsc"
                                GroupName="FolderSort"
                                IsChecked="{x:Bind helpers:BindHelpers.IsFolderSort(ViewModel.FolderSort, 'NameAsc'), Mode=OneWay}"
                                Text="Name (A to Z)" />
                            <RadioMenuFlyoutItem
                                AutomationProperties.AutomationId="MnuFolderSortNameDesc"
                                Command="{x:Bind ViewModel.SetFolderSortCommand}"
                                CommandParameter="NameDesc"
                                GroupName="FolderSort"
                                IsChecked="{x:Bind helpers:BindHelpers.IsFolderSort(ViewModel.FolderSort, 'NameDesc'), Mode=OneWay}"
                                Text="Name (Z to A)" />
                            <RadioMenuFlyoutItem
                                AutomationProperties.AutomationId="MnuFolderSortMostItems"
                                Command="{x:Bind ViewModel.SetFolderSortCommand}"
                                CommandParameter="MostItems"
                                GroupName="FolderSort"
                                IsChecked="{x:Bind helpers:BindHelpers.IsFolderSort(ViewModel.FolderSort, 'MostItems'), Mode=OneWay}"
                                Text="Most items" />
                            <RadioMenuFlyoutItem
                                AutomationProperties.AutomationId="MnuFolderSortNewest"
                                Command="{x:Bind ViewModel.SetFolderSortCommand}"
                                CommandParameter="Newest"
                                GroupName="FolderSort"
                                IsChecked="{x:Bind helpers:BindHelpers.IsFolderSort(ViewModel.FolderSort, 'Newest'), Mode=OneWay}"
                                Text="Recently changed" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button
                    x:Name="BtnTreeNewFolder"
                    Grid.Column="2"
                    MinWidth="32"
                    MinHeight="32"
                    AutomationProperties.AutomationId="BtnTreeNewFolder"
                    AutomationProperties.Name="New folder"
                    Command="{x:Bind ViewModel.NewFolderCommand}"
                    ToolTipService.ToolTip="New folder (Ctrl+Shift+N)">
                    <ic:FluentIcon Icon="FolderAdd" IconSize="Size16" IconVariant="Regular" />
                </Button>
            </Grid>
            <TreeView
                x:Name="TreFolders"
                Grid.Row="3"
                AllowDrop="False"
                AutomationProperties.AutomationId="TreFolders"
                AutomationProperties.Name="Source folders"
                CanDragItems="False"
                CanReorderItems="False"
                Collapsed="TreFolders_Collapsed"
                Expanding="TreFolders_Expanding"
                ItemInvoked="TreFolders_ItemInvoked"
                ItemsSource="{x:Bind ViewModel.FolderTree, Mode=OneWay}"
                Visibility="{x:Bind helpers:BindHelpers.InvertBoolToVisibility(ViewModel.IsTagBrowse), Mode=OneWay}">
                <TreeView.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <!-- Dark: accent text on tertiary fill reads; Light: Dark* text on Dark* fill fails AA — use TextOnAccent. -->
                            <ResourceDictionary x:Key="Default">
                                <StaticResource x:Key="TreeViewItemBackgroundSelected" ResourceKey="AccentFillColorTertiaryBrush" />
                                <StaticResource x:Key="TreeViewItemBackgroundSelectedPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                                <StaticResource x:Key="TreeViewItemForegroundSelected" ResourceKey="AccentTextFillColorPrimaryBrush" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Light">
                                <StaticResource x:Key="TreeViewItemBackgroundSelected" ResourceKey="AccentFillColorDefaultBrush" />
                                <StaticResource x:Key="TreeViewItemBackgroundSelectedPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                                <StaticResource x:Key="TreeViewItemForegroundSelected" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="HighContrast">
                                <StaticResource x:Key="TreeViewItemBackgroundSelected" ResourceKey="SystemColorHighlightColorBrush" />
                                <StaticResource x:Key="TreeViewItemBackgroundSelectedPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
                                <StaticResource x:Key="TreeViewItemForegroundSelected" ResourceKey="SystemColorHighlightTextColorBrush" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </TreeView.Resources>
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="models:FolderNode">
                        <TreeViewItem
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                            IsExpanded="{x:Bind IsExpanded, Mode=OneWay}"
                            ItemsSource="{x:Bind Children, Mode=OneWay}">
                            <TreeViewItem.ContextFlyout>
                                <MenuFlyout Opening="FolderMenu_Opening">
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="MnuNewSubfolder"
                                        Command="{x:Bind pages:LibraryPage.GetNewFolderCommand()}"
                                        CommandParameter="{x:Bind}"
                                        KeyboardAcceleratorTextOverride="Ctrl+Shift+N"
                                        Text="New folder">
                                        <MenuFlyoutItem.Icon>
                                            <ic:FluentIcon Icon="FolderAdd" IconSize="Size16" IconVariant="Regular" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="MnuRenameFolder"
                                        Command="{x:Bind pages:LibraryPage.GetRenameFolderCommand()}"
                                        CommandParameter="{x:Bind}"
                                        KeyboardAcceleratorTextOverride="F2"
                                        Text="Rename">
                                        <MenuFlyoutItem.Icon>
                                            <ic:FluentIcon Icon="Rename" IconSize="Size16" IconVariant="Regular" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="MnuDeleteFolder"
                                        Command="{x:Bind pages:LibraryPage.GetDeleteFolderCommand()}"
                                        CommandParameter="{x:Bind}"
                                        KeyboardAcceleratorTextOverride="Del"
                                        Text="Delete empty folder">
                                        <MenuFlyoutItem.Icon>
                                            <ic:FluentIcon Icon="Delete" IconSize="Size16" IconVariant="Regular" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="MnuFolderInExplorer"
                                        Command="{x:Bind pages:LibraryPage.GetShowFolderInExplorerCommand()}"
                                        CommandParameter="{x:Bind}"
                                        Text="Show in File Explorer">
                                        <MenuFlyoutItem.Icon>
                                            <ic:FluentIcon Icon="FolderOpen" IconSize="Size16" IconVariant="Regular" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </TreeViewItem.ContextFlyout>
                            <Grid
                                AllowDrop="True"
                                Background="Transparent"
                                ColumnSpacing="8"
                                DragOver="FolderItem_DragOver"
                                Drop="FolderItem_Drop"
                                Tag="{x:Bind}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ic:FluentIcon
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource AccentTextFillColorSecondaryBrush}"
                                    Icon="{x:Bind helpers:FluentGlyph.FolderTreeIcon(IsRoot, IsExpanded), Mode=OneWay}"
                                    IconSize="Size16"
                                    IconVariant="Regular" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Name, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind helpers:BindHelpers.InvertBoolToVisibility(IsEditing), Mode=OneWay}" />
                                <TextBox
                                    x:Name="TxtFolderName"
                                    Grid.Column="1"
                                    x:Load="{x:Bind IsEditing, Mode=OneWay}"
                                    MinWidth="120"
                                    AutomationProperties.AutomationId="TxtFolderName"
                                    AutomationProperties.Name="Folder name"
                                    KeyDown="FolderEditor_KeyDown"
                                    Loaded="FolderEditor_Loaded"
                                    LostFocus="FolderEditor_LostFocus"
                                    Tag="{x:Bind}"
                                    Text="{x:Bind EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Border
                                    Grid.Column="2"
                                    Padding="6,0"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                    CornerRadius="8"
                                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsSelected), Mode=OneWay}">
                                    <TextBlock
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind CountText, Mode=OneWay}" />
                                </Border>
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind CountText, Mode=OneWay}"
                                    Visibility="{x:Bind helpers:BindHelpers.InvertBoolToVisibility(IsSelected), Mode=OneWay}" />
                            </Grid>
                        </TreeViewItem>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <ScrollViewer
                x:Name="TreTagsBrowse"
                Grid.Row="3"
                AutomationProperties.AutomationId="TreTagsBrowse"
                AutomationProperties.Name="Tags"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.IsTagBrowse), Mode=OneWay}">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.BrowseTags, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <helpers:ChipWrapLayout HorizontalSpacing="6" VerticalSpacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:TagChipItem">
                            <controls:TagChip
                                HorizontalAlignment="Left"
                                ApplyState="{x:Bind ApplyState, Mode=OneWay}"
                                ChipAutomationId="{x:Bind AutomationId, Mode=OneWay}"
                                Command="{x:Bind pages:LibraryPage.GetToggleFilterChipCommand()}"
                                CommandParameter="{x:Bind}"
                                Compact="True"
                                Label="{x:Bind Name, Mode=OneWay}"
                                TagColor="{x:Bind EffectiveColor, Mode=OneWay}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <Grid
            Grid.Row="1"
            Grid.Column="1"
            RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <ToggleButton
                    x:Name="TglSelectMode"
                    AutomationProperties.AutomationId="TglSelectMode"
                    AutomationProperties.Name="Select"
                    Checked="TglSelectMode_Changed"
                    IsChecked="{x:Bind ViewModel.IsSelectMode, Mode=TwoWay}"
                    Unchecked="TglSelectMode_Changed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="Multiselect" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock VerticalAlignment="Center" Text="Select" />
                    </StackPanel>
                </ToggleButton>
                <DropDownButton
                    x:Name="BtnMosaicSort"
                    MinWidth="200"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="BtnMosaicSort"
                    AutomationProperties.HelpText="{x:Bind ViewModel.SortDirectionLabel, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.SortButtonLabel, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.SortButtonLabel, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="ArrowSort" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock
                            x:Name="TxtMosaicSortLabel"
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.SortButtonLabel, Mode=OneWay}" />
                    </StackPanel>
                    <!-- Sort items mirrored in MnuMosaicSortOverflow (x:Bind can't share one flyout). -->
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <RadioMenuFlyoutItem
