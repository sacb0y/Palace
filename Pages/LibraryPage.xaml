                DoubleTapped="BrdPreviewResize_DoubleTapped"
                PointerCanceled="BrdPreviewResize_PointerCanceled"
                PointerCaptureLost="BrdPreviewResize_PointerCaptureLost"
                PointerMoved="BrdPreviewResize_PointerMoved"
