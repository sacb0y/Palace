                    Content="Retry"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowRetryDeleteRejected), Mode=OneWay}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <ic:FluentIcon Icon="RowTriple" IconSize="Size16" IconVariant="Regular" />
