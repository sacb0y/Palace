                            <Button
                                x:Name="BtnGalleryScaleFill"
                                Padding="8,4"
                                AutomationProperties.AutomationId="BtnGalleryScaleFill"
                                AutomationProperties.Name="Fill"
                                Command="{x:Bind ViewModel.OverlayGallery.SetScaleFillCommand, Mode=OneWay, FallbackValue={x:Null}}"
                                IsEnabled="{x:Bind ViewModel.OverlayGallery.CanScale, Mode=OneWay, FallbackValue=True}"
                                ToolTipService.ToolTip="Fill (Ctrl+3)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:FluentIcon Icon="ScaleFill" IconSize="Size20" IconVariant="Regular" />
                                    <TextBlock VerticalAlignment="Center" Text="Fill" />
                                </StackPanel>
                            </Button>
<Border
                                Padding="8,5"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="IcnGalleryOverlayHdr"
                                AutomationProperties.Name="HDR"
