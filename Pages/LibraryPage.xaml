<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Palace.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Palace.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Palace.Models"
    xmlns:pages="using:Palace.Pages"
    mc:Ignorable="d">

    <Grid>
    <Grid
        Padding="12,8,12,8"
        ColumnSpacing="12"
        IsHitTestVisible="{x:Bind helpers:BindHelpers.Not(ViewModel.IsGalleryOverlayOpen), Mode=OneWay}"
        RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="3" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    AutomationProperties.AutomationId="BtnAddFolder"
                    AutomationProperties.Name="Add folder"
                    Command="{x:Bind ViewModel.AddFolderCommand}"
                    Content="Add folder" />
                <Button
                    AutomationProperties.AutomationId="BtnScan"
                    Command="{x:Bind ViewModel.ScanCommand}"
                    Content="Scan"
                    IsEnabled="{x:Bind helpers:BindHelpers.Not(ViewModel.IsBusy), Mode=OneWay}" />
                <Button
                    AutomationProperties.AutomationId="BtnOrganize"
                    Command="{x:Bind ViewModel.PreviewOrganizeCommand}"
                    Content="Organize"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                <Button
                    AutomationProperties.AutomationId="BtnUndoOrganize"
                    Command="{x:Bind ViewModel.UndoOrganizeCommand}"
                    Content="Undo last organize" />
                <Button
                    AutomationProperties.AutomationId="BtnAddToRoom"
                    Command="{x:Bind ViewModel.AddSelectionToRoomCommand}"
                    Content="Add to room"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
            </StackPanel>
            <ProgressBar
                x:Name="PrgLibrary"
                Grid.Row="1"
                Height="4"
                AutomationProperties.AutomationId="PrgLibrary"
                AutomationProperties.Name="Library loading"
                IsIndeterminate="True"
                ShowPaused="False"
                Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.IsBusy), Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <SelectorBar
                x:Name="SelBrowseMode"
                AutomationProperties.AutomationId="SelBrowseMode"
                AutomationProperties.Name="Browse by"
                SelectionChanged="SelBrowseMode_SelectionChanged">
                <SelectorBarItem
                    x:Name="SelFolders"
                    AutomationProperties.AutomationId="SelFolders"
                    IsSelected="True"
                    Text="Folders" />
                <SelectorBarItem
                    x:Name="SelTags"
                    AutomationProperties.AutomationId="SelTags"
                    Text="Tags" />
            </SelectorBar>
            <TreeView
                x:Name="TreFolders"
                Grid.Row="1"
                AutomationProperties.AutomationId="TreFolders"
                AutomationProperties.Name="Source folders"
                ItemInvoked="TreFolders_ItemInvoked"
                ItemsSource="{x:Bind ViewModel.FolderTree, Mode=OneWay}"
                Visibility="{x:Bind helpers:BindHelpers.InvertBoolToVisibility(ViewModel.IsTagBrowse), Mode=OneWay}">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="models:FolderNode">
                        <TreeViewItem
                            Content="{x:Bind Name, Mode=OneWay}"
                            IsExpanded="True"
                            ItemsSource="{x:Bind Children, Mode=OneWay}" />
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <TreeView
                x:Name="TreTagsBrowse"
                Grid.Row="1"
                AutomationProperties.AutomationId="TreTagsBrowse"
                AutomationProperties.Name="Tags"
                ItemInvoked="TreTagsBrowse_ItemInvoked"
                ItemsSource="{x:Bind ViewModel.TagTree, Mode=OneWay}"
                Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.IsTagBrowse), Mode=OneWay}">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="models:TagTreeNode">
                        <TreeViewItem
                            Content="{x:Bind Name, Mode=OneWay}"
                            IsExpanded="True"
                            ItemsSource="{x:Bind Children, Mode=OneWay}" />
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

        <Grid
            Grid.Row="1"
            Grid.Column="1"
            RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <BreadcrumbBar
                x:Name="BcrPath"
                AutomationProperties.AutomationId="BcrPath"
                ItemClicked="BcrPath_ItemClicked"
                ItemsSource="{x:Bind ViewModel.Breadcrumbs, Mode=OneWay}">
                <BreadcrumbBar.ItemTemplate>
                    <DataTemplate x:DataType="models:PathCrumb">
                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                    </DataTemplate>
                </BreadcrumbBar.ItemTemplate>
            </BreadcrumbBar>
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox
                    x:Name="AsbSearch"
                    AutomationProperties.AutomationId="AsbSearch"
                    PlaceholderText="Search filename, tags, prompt, model"
                    QueryIcon="Find"
                    QuerySubmitted="AsbSearch_QuerySubmitted"
                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Slider
                    x:Name="SldRowHeight"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="SldRowHeight"
                    AutomationProperties.Name="Mosaic row height"
                    Header="Row height"
                    Maximum="280"
                    Minimum="96"
                    StepFrequency="4"
                    TickFrequency="20"
                    Value="{x:Bind ViewModel.MosaicRowHeight, Mode=TwoWay}" />
            </Grid>
            <ItemsView
                x:Name="GrdAssets"
                Grid.Row="2"
                AutomationProperties.AutomationId="GrdAssets"
                AutomationProperties.Name="Assets"
                DoubleTapped="GrdAssets_DoubleTapped"
                IsTabStop="True"
                ItemsSource="{x:Bind ViewModel.Assets, Mode=OneWay}"
                PreviewKeyDown="GrdAssets_KeyDown"
                SelectionChanged="GrdAssets_SelectionChanged"
                SelectionMode="Extended">
                <ItemsView.Layout>
                    <LinedFlowLayout
                        x:Name="MosaicLayout"
                        ItemsInfoRequested="MosaicLayout_ItemsInfoRequested"
                        ItemsStretch="Fill"
                        LineHeight="{x:Bind ViewModel.MosaicRowHeight, Mode=OneWay}"
                        LineSpacing="8"
                        MinItemSpacing="8" />
                </ItemsView.Layout>
                <ItemsView.ItemTemplate>
                    <DataTemplate x:DataType="models:AssetItem">
                        <ItemContainer
                            AutomationProperties.Name="{x:Bind FileName, Mode=OneWay}"
                            DoubleTapped="AssetItem_DoubleTapped"
                            IsDoubleTapEnabled="True"
                            ManipulationMode="None"
                            PointerPressed="AssetItem_PointerPressed"
                            RightTapped="AssetItem_RightTapped">
                            <ItemContainer.ContextFlyout>
                                <MenuFlyout Opening="AssetMenu_Opening">
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="MnuOpen"
                                        Command="{x:Bind pages:LibraryPage.GetOpenOverlayCommand()}"
                                        CommandParameter="{x:Bind}"
                                        Text="Open" />
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="MnuOpenInNewWindow"
                                        Command="{x:Bind pages:LibraryPage.GetOpenInNewWindowCommand()}"
                                        CommandParameter="{x:Bind}"
                                        Text="Open in new window" />
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="MnuShowInExplorer"
                                        Command="{x:Bind pages:LibraryPage.GetShowInExplorerCommand()}"
                                        Text="Show in File Explorer" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="MnuCopy"
                                        Command="{x:Bind pages:LibraryPage.GetCopyFilesCommand()}"
                                        Text="Copy" />
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="MnuCopyPath"
                                        Command="{x:Bind pages:LibraryPage.GetCopyPathCommand()}"
                                        Text="Copy path" />
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="MnuMoveToFolder"
                                        Command="{x:Bind pages:LibraryPage.GetMoveToFolderCommand()}"
                                        Text="Move to folder…" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="MnuAddToRoom"
                                        Command="{x:Bind pages:LibraryPage.GetAddSelectionToRoomCommand()}"
                                        Text="Add to room" />
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="MnuAddTag"
                                        Command="{x:Bind pages:LibraryPage.GetFocusAssignTagCommand()}"
                                        Text="Add tag…" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="MnuDelete"
                                        Command="{x:Bind pages:LibraryPage.GetDeleteFilesCommand()}"
                                        Text="Delete" />
                                </MenuFlyout>
                            </ItemContainer.ContextFlyout>
                            <Grid
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                DoubleTapped="AssetItem_DoubleTapped"
                                IsDoubleTapEnabled="True"
                                ManipulationMode="None">
                                <Image
                                    DataContextChanged="TileImage_DataContextChanged"
                                    DoubleTapped="AssetItem_DoubleTapped"
                                    IsDoubleTapEnabled="True"
                                    Loaded="TileImage_Loaded"
                                    ManipulationMode="None"
                                    Stretch="UniformToFill"
                                    Source="{x:Bind ThumbImage, Mode=OneWay}"
                                    Unloaded="TileImage_Unloaded" />
                                <TextBlock
                                    Margin="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsHitTestVisible="False"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Missing"
                                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsOrphan), Mode=OneWay}" />
                                <StackPanel
                                    Margin="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Spacing="4"
                                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ShowCloudTile), Mode=OneWay}">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE724;" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Online" />
                                </StackPanel>
                            </Grid>
                        </ItemContainer>
                    </DataTemplate>
                </ItemsView.ItemTemplate>
            </ItemsView>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Grid.Column="2"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Preview" />
                <Border
                    MinHeight="200"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <Grid>
                        <Image
                            x:Name="ImgPreview"
                            AutomationProperties.AutomationId="ImgPreview"
                            Stretch="Uniform"
                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.IsImagePreview), Mode=OneWay}" />
                        <MediaPlayerElement
                            x:Name="MpePreview"
                            AreTransportControlsEnabled="True"
                            AutoPlay="False"
                            AutomationProperties.AutomationId="MpePreview"
                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.IsVideoPreview), Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Select an asset"
                            Visibility="{x:Bind helpers:BindHelpers.InvertBoolToVisibility(ViewModel.HasSelection), Mode=OneWay}" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Generation" />
                <TextBlock
                    AutomationProperties.AutomationId="TxtModel"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.PreviewModel), Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Prompt" />
                <TextBlock
                    AutomationProperties.AutomationId="TxtPrompt"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.PreviewPrompt), Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Negative" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.PreviewNegative), Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Seed" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.PreviewSeed), Mode=OneWay}" />

                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Notes and rating" />
                <RatingControl
                    AutomationProperties.AutomationId="RtgAsset"
                    Caption="Rating"
                    IsEnabled="{x:Bind ViewModel.CanEditNotes, Mode=OneWay}"
                    PlaceholderValue="0"
                    Value="{x:Bind ViewModel.PreviewRating, Mode=TwoWay}" />
                <TextBox
                    AutomationProperties.AutomationId="TxtNotes"
                    AcceptsReturn="True"
                    Header="Notes"
                    IsEnabled="{x:Bind ViewModel.CanEditNotes, Mode=OneWay}"
                    Text="{x:Bind ViewModel.PreviewNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Tags" />
                <TextBlock
                    AutomationProperties.AutomationId="TxtAssignedTags"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.AssignedTagsSummary, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <ScrollViewer
                    MaxHeight="220"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        x:Name="LstTags"
                        AutomationProperties.AutomationId="LstTags"
                        AutomationProperties.Name="Assigned"
                        ItemsSource="{x:Bind ViewModel.AssignedTags, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:AssignedTagItem">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Padding="8,4"
                                        Background="{x:Bind helpers:TagColor.ChipFill(EffectiveColor), Mode=OneWay}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                        Opacity="{x:Bind helpers:TagColor.ChipOpacity(IsPartial), Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Foreground="{x:Bind helpers:TagColor.ChipInk(EffectiveColor), Mode=OneWay}"
                                                Style="{StaticResource BodyTextBlockStyle}"
                                                Text="{x:Bind Display, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Foreground="{x:Bind helpers:TagColor.ChipInk(EffectiveColor), Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind CountLabel, Mode=OneWay}"
                                                Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsPartial), Mode=OneWay}" />
                                            <TextBlock
                                                Foreground="{x:Bind helpers:TagColor.ChipInk(EffectiveColor), Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind SourceLabel, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                    <Button
                                        Grid.Column="1"
                                        MinWidth="88"
                                        MinHeight="32"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="{x:Bind RemoveAutomationId, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind RemoveAutomationName, Mode=OneWay}"
                                        Command="{x:Bind pages:LibraryPage.GetRemoveTagCommand()}"
                                        CommandParameter="{x:Bind}"
                                        Content="Remove" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Add tag" />
                <AutoSuggestBox
                    x:Name="AsbAssignTag"
                    AutomationProperties.AutomationId="AsbAssignTag"
                    AutomationProperties.Name="Tag to assign"
                    ItemsSource="{x:Bind ViewModel.TagSuggestions, Mode=OneWay}"
                    PlaceholderText="Type to find or create a tag"
                    QueryIcon="Find"
                    QuerySubmitted="AsbAssignTag_QuerySubmitted"
                    SuggestionChosen="AsbAssignTag_SuggestionChosen"
                    TextChanged="AsbAssignTag_TextChanged"
                    Text="{x:Bind ViewModel.TagQuery, Mode=OneWay}"
                    TextMemberPath="Display"
                    UpdateTextOnSelect="True">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="models:TagPickItem">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="12"
                                    Height="12"
                                    VerticalAlignment="Center"
                                    Background="{x:Bind helpers:TagColor.ChipFill(EffectiveColor), Mode=OneWay}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Display, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
                <TextBlock
                    AutomationProperties.AutomationId="TxtTagSuggestions"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.TagSuggestionsSummary, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <Button
                    AutomationProperties.AutomationId="BtnAssignTag"
                    Click="BtnAssignTag_Click"
                    Content="Assign tag"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                <TextBox
                    AutomationProperties.AutomationId="TxtNewTag"
                    Header="Quick new tag (ungrouped)"
                    Text="{x:Bind ViewModel.NewTagName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    AutomationProperties.AutomationId="BtnCreateTag"
                    Command="{x:Bind ViewModel.CreateAndAssignTagCommand}"
                    Content="Create and assign"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />

                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Prompt suggestions" />
                <ListView
                    x:Name="LstSuggestions"
                    AutomationProperties.AutomationId="LstSuggestions"
                    ItemsSource="{x:Bind ViewModel.Suggestions, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PromptSuggestion">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind Token, Mode=OneWay}" />
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.Name="Accept suggestion"
                                    Command="{x:Bind pages:LibraryPage.GetAcceptSuggestionCommand()}"
                                    CommandParameter="{x:Bind}"
                                    Content="Add" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    Spacing="8"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowOrganizePanel), Mode=OneWay}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Organize preview" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="From" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="To" />
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Status" />
                    </Grid>
                    <ListView
                        x:Name="LstOrganizePreview"
                        MaxHeight="240"
                        AutomationProperties.AutomationId="LstOrganizePreview"
                        ItemsSource="{x:Bind ViewModel.OrganizePreview, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:OrganizePreviewItem">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind OldPath, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind NewPath, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Status, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button
                        AutomationProperties.AutomationId="BtnApplyOrganize"
                        Command="{x:Bind ViewModel.ApplyOrganizeCommand}"
                        Content="Apply organize" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <InfoBar
            Grid.Row="2"
            Grid.ColumnSpan="3"
            AutomationProperties.AutomationId="InfStatus"
            IsOpen="{x:Bind ViewModel.ShowInfo, Mode=TwoWay}"
            Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}"
            Severity="Informational" />
        <TextBlock
            x:Name="TxtStatus"
            Grid.Row="3"
            Grid.ColumnSpan="3"
            AutomationProperties.AutomationId="TxtStatus"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
    </Grid>

        <Grid
            x:Name="GrdGalleryOverlay"
            AutomationProperties.AutomationId="GrdGalleryOverlay"
            AutomationProperties.Name="Gallery overlay"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            Canvas.ZIndex="1"
            IsTabStop="True"
            PointerPressed="GalleryOverlay_BackdropPressed"
            PreviewKeyDown="GalleryOverlay_PreviewKeyDown"
            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.IsGalleryOverlayOpen), Mode=OneWay}">
            <Grid>
                <Image
                    Stretch="Uniform"
                    Source="{x:Bind pages:LibraryPage.FileToFullImage(ViewModel.OverlayGallery.CurrentPath), Mode=OneWay, FallbackValue={x:Null}}"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.IsImage), Mode=OneWay, FallbackValue=Collapsed}" />
                <MediaPlayerElement
                    x:Name="MpeOverlay"
                    AreTransportControlsEnabled="True"
                    AutoPlay="False"
                    AutomationProperties.AutomationId="MpeGalleryOverlay"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.IsVideo), Mode=OneWay, FallbackValue=Collapsed}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Missing"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.IsMissing), Mode=OneWay, FallbackValue=Collapsed}" />

                <Button
                    x:Name="BtnGalleryPrev"
                    MinWidth="48"
                    MinHeight="48"
                    Margin="16,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="BtnGalleryPrev"
                    AutomationProperties.Name="Previous"
                    Command="{x:Bind ViewModel.OverlayGallery.GoPreviousCommand, Mode=OneWay, FallbackValue={x:Null}}"
                    IsEnabled="{x:Bind ViewModel.OverlayGallery.CanGoPrevious, Mode=OneWay, FallbackValue=False}"
                    ToolTipService.ToolTip="Previous">
                    <SymbolIcon Symbol="Back" />
                </Button>
                <Button
                    x:Name="BtnGalleryNext"
                    MinWidth="48"
                    MinHeight="48"
                    Margin="0,0,16,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="BtnGalleryNext"
                    AutomationProperties.Name="Next"
                    Command="{x:Bind ViewModel.OverlayGallery.GoNextCommand, Mode=OneWay, FallbackValue={x:Null}}"
                    IsEnabled="{x:Bind ViewModel.OverlayGallery.CanGoNext, Mode=OneWay, FallbackValue=False}"
                    ToolTipService.ToolTip="Next">
                    <SymbolIcon Symbol="Forward" />
                </Button>
                <Button
                    x:Name="BtnGalleryClose"
                    MinWidth="48"
                    MinHeight="48"
                    Margin="0,16,16,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    AutomationProperties.AutomationId="BtnGalleryClose"
                    AutomationProperties.Name="Close"
                    Command="{x:Bind ViewModel.CloseOverlayCommand}"
                    ToolTipService.ToolTip="Close">
                    <SymbolIcon Symbol="Cancel" />
                </Button>
            </Grid>

            <Border
                Margin="24,0,24,24"
                Padding="16,12"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <StackPanel Spacing="8">
                    <TextBlock
                        AutomationProperties.AutomationId="TxtGalleryOverlayTitle"
                        AutomationProperties.Name="Gallery title"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.OverlayGallery.Title, Mode=OneWay, FallbackValue=''}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        AutomationProperties.AutomationId="TxtGalleryOverlayPosition"
                        AutomationProperties.Name="Gallery position"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.OverlayGallery.PositionLabel, Mode=OneWay, FallbackValue=''}" />
                    <ItemsControl
                        x:Name="LstGalleryOverlayTags"
                        AutomationProperties.AutomationId="LstGalleryOverlayTags"
                        AutomationProperties.Name="Tags"
                        ItemsSource="{x:Bind ViewModel.OverlayGallery.Tags, Mode=OneWay, FallbackValue={x:Null}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:AssignedTagItem">
                                <Border
                                    Padding="8,4"
                                    Background="{x:Bind helpers:TagColor.ChipFill(EffectiveColor), Mode=OneWay}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    Opacity="{x:Bind helpers:TagColor.ChipOpacity(IsPartial), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            Foreground="{x:Bind helpers:TagColor.ChipInk(EffectiveColor), Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind TagName, Mode=OneWay}" />
                                        <TextBlock
                                            Foreground="{x:Bind helpers:TagColor.ChipInk(EffectiveColor), Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind CountLabel, Mode=OneWay}"
                                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsPartial), Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
