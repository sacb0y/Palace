                            Style="{StaticResource ViewerOverlayCloseButtonStyle}"
                            ToolTipService.ToolTip="Close (Esc)">
                            <ic:FluentIcon Icon="Dismiss" IconSize="Size16" IconVariant="Regular" />
                        </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    Spacing="0">
                <Border
                    x:Name="BrdReviewChrome"
                    MaxWidth="720"
                    MinWidth="280"
                    Margin="16,8,16,12"
                    Padding="12,10"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="BrdReviewChrome"
                    Background="#E01C1C1C"
                    BorderBrush="#1AFFFFFF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowReviewChrome), Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Name="TxtReviewProgress"
                            HorizontalAlignment="Center"
                            AutomationProperties.AutomationId="TxtReviewProgress"
                            AutomationProperties.LiveSetting="Polite"
                            AutomationProperties.Name="Review progress"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.ReviewProgressText, Mode=OneWay}" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowReviewDecideButtons), Mode=OneWay}">
                                <Button
                                    x:Name="BtnReviewReject"
                                    Padding="10,6"
                                    AutomationProperties.AutomationId="BtnReviewReject"
                                    AutomationProperties.Name="Reject — move to _rejected (X)"
                                    Command="{x:Bind ViewModel.ReviewRejectCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanReviewDecide, Mode=OneWay}"
                                    ToolTipService.ToolTip="Reject (X) — move to _rejected">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="X" />
                                    </Button.KeyboardAccelerators>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ic:FluentIcon Icon="Dismiss" IconSize="Size16" IconVariant="Regular" />
                                        <TextBlock VerticalAlignment="Center" Text="Reject" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="BtnReviewSkip"
                                    Padding="10,6"
                                    AutomationProperties.AutomationId="BtnReviewSkip"
                                    AutomationProperties.Name="Skip — leave undecided (S)"
                                    Command="{x:Bind ViewModel.ReviewSkipCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanReviewDecide, Mode=OneWay}"
                                    ToolTipService.ToolTip="Skip (S) — leave undecided">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="S" />
                                    </Button.KeyboardAccelerators>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ic:FluentIcon Icon="ArrowUp" IconSize="Size16" IconVariant="Regular" />
                                        <TextBlock VerticalAlignment="Center" Text="Skip" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="BtnReviewKeep"
                                    Padding="10,6"
                                    AutomationProperties.AutomationId="BtnReviewKeep"
                                    AutomationProperties.Name="Keep (K)"
                                    Command="{x:Bind ViewModel.ReviewKeepCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanReviewDecide, Mode=OneWay}"
                                    ToolTipService.ToolTip="Keep (K)">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="K" />
                                    </Button.KeyboardAccelerators>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ic:FluentIcon Icon="Checkmark" IconSize="Size16" IconVariant="Regular" />
                                        <TextBlock VerticalAlignment="Center" Text="Keep" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Button
                                x:Name="BtnReviewUndo"
                                Padding="10,6"
                                AutomationProperties.AutomationId="BtnReviewUndo"
                                AutomationProperties.Name="Undo last review decision (Ctrl+Z)"
                                Command="{x:Bind ViewModel.ReviewUndoCommand}"
                                IsEnabled="{x:Bind ViewModel.CanReviewUndo, Mode=OneWay}"
                                ToolTipService.ToolTip="Undo (Ctrl+Z)"
                                Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowReviewUndoButton), Mode=OneWay}">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Z" Modifiers="Control" />
                                </Button.KeyboardAccelerators>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:FluentIcon Icon="ArrowUndo" IconSize="Size16" IconVariant="Regular" />
                                    <TextBlock VerticalAlignment="Center" Text="Undo" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel
                            HorizontalAlignment="Stretch"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowReviewEndCard), Mode=OneWay}">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    x:Name="TxtReviewEndTitle"
                                    AutomationProperties.AutomationId="TxtReviewEndTitle"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.ReviewEndTitle, Mode=OneWay}" />
                                <TextBlock
                                    x:Name="TxtReviewEndStats"
                                    AutomationProperties.AutomationId="TxtReviewEndStats"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ReviewEndStats, Mode=OneWay}" />
                            </StackPanel>
                            <Button
                                x:Name="BtnReviewSkipped"
                                AutomationProperties.AutomationId="BtnReviewSkipped"
                                AutomationProperties.Name="{x:Bind ViewModel.ReviewSkippedLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ReviewSkippedCommand}"
                                Content="{x:Bind ViewModel.ReviewSkippedLabel, Mode=OneWay}"
                                Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowReviewSkipped), Mode=OneWay}" />
                            <Button
                                x:Name="BtnReviewDeleteRejected"
                                AutomationProperties.AutomationId="BtnReviewDeleteRejected"
                                AutomationProperties.Name="{x:Bind ViewModel.ReviewDeleteRejectedLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.DeleteRejectedFromReviewCommand}"
                                Foreground="#FF99A4"
                                Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowReviewDeleteRejected), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:FluentIcon Icon="Delete" IconSize="Size16" IconVariant="Regular" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="#FF99A4"
                                        Text="{x:Bind ViewModel.ReviewDeleteRejectedLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="BtnReviewDone"
                                AutomationProperties.AutomationId="BtnReviewDone"
                                AutomationProperties.Name="Done"
                                Command="{x:Bind ViewModel.EndReviewCommand}"
                                Content="Done"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border
                    x:Name="BrdGifScrub"
                    MaxWidth="640"
                    MinWidth="280"
                    Margin="16,8,16,0"
                    Padding="10,6"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="BrdGifScrub"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.CanScrubGif), Mode=OneWay, FallbackValue=Collapsed}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="BtnGifPause"
                            Padding="8,4"
                            AutomationProperties.AutomationId="BtnGifPause"
                            AutomationProperties.Name="Pause GIF"
                            Command="{x:Bind ViewModel.OverlayGallery.ToggleGifPlayCommand, Mode=OneWay, FallbackValue={x:Null}}"
                            ToolTipService.ToolTip="Pause"
                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.GifPlaying), Mode=OneWay, FallbackValue=Collapsed}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="Pause" IconSize="Size16" IconVariant="Regular" />
                                <TextBlock VerticalAlignment="Center" Text="Pause" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="BtnGifPlay"
                            Padding="8,4"
                            AutomationProperties.AutomationId="BtnGifPlay"
                            AutomationProperties.Name="Play GIF"
                            Command="{x:Bind ViewModel.OverlayGallery.ToggleGifPlayCommand, Mode=OneWay, FallbackValue={x:Null}}"
                            ToolTipService.ToolTip="Play"
                            Visibility="{x:Bind helpers:BindHelpers.InvertBoolToVisibility(ViewModel.OverlayGallery.GifPlaying), Mode=OneWay, FallbackValue=Collapsed}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="Play" IconSize="Size16" IconVariant="Regular" />
                                <TextBlock VerticalAlignment="Center" Text="Play" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="BtnGifPrevFrame"
                            Grid.Column="1"
                            Padding="8,4"
                            AutomationProperties.AutomationId="BtnGifPrevFrame"
                            AutomationProperties.Name="Previous frame"
                            Command="{x:Bind ViewModel.OverlayGallery.GifPreviousFrameCommand, Mode=OneWay, FallbackValue={x:Null}}"
                            ToolTipService.ToolTip="Previous frame">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="PreviousFrame" IconSize="Size16" IconVariant="Regular" />
                                <TextBlock VerticalAlignment="Center" Text="Prev frame" />
                            </StackPanel>
                        </Button>
                        <Slider
                            x:Name="SldGifFrame"
                            Grid.Column="2"
                            MinWidth="120"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="SldGifFrame"
                            AutomationProperties.Name="GIF frame"
                            Maximum="{x:Bind ViewModel.OverlayGallery.GifFrameMaximum, Mode=OneWay, FallbackValue=0}"
                            Minimum="0"
                            SnapsTo="StepValues"
                            StepFrequency="1"
                            TickPlacement="None"
                            Value="{x:Bind ViewModel.OverlayGallery.GifFrameIndex, Mode=TwoWay, FallbackValue=0}" />
                        <Button
                            x:Name="BtnGifNextFrame"
                            Grid.Column="3"
                            Padding="8,4"
                            AutomationProperties.AutomationId="BtnGifNextFrame"
                            AutomationProperties.Name="Next frame"
                            Command="{x:Bind ViewModel.OverlayGallery.GifNextFrameCommand, Mode=OneWay, FallbackValue={x:Null}}"
                            ToolTipService.ToolTip="Next frame">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="NextFrame" IconSize="Size16" IconVariant="Regular" />
                                <TextBlock VerticalAlignment="Center" Text="Next frame" />
                            </StackPanel>
                        </Button>
                        <TextBlock
                            x:Name="TxtGifFrame"
                            Grid.Column="4"
                            MinWidth="48"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="TxtGifFrame"
                            AutomationProperties.Name="GIF frame"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.OverlayGallery.GifFrameLabel, Mode=OneWay, FallbackValue=''}" />
                    </Grid>
                </Border>
                </StackPanel>

            </Grid>
        </Grid>
    </Grid>
</Page>
