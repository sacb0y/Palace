<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Palace.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Palace.Helpers"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Palace.Models"
    xmlns:pages="using:Palace.Pages"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSettingsSearch_Invoked" />
        <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="FocusSettingsSearch_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <!--
          Selection chrome is on the swatch only (IsSelected across groups).
          GridViews use SelectionMode=Single so UIA/keyboard Select fires
          SelectionChanged (same pattern as LstSettingsNav) and applies the
          background; other groups' SelectedItem are cleared in code-behind.
          Gooey tiles: 96x54, CornerRadius 6. Recent + +Custom. Remove uses shared
          ViewerOverlayButtonStyle (24 DIP plate; style from App.xaml merge).
        -->
        <DataTemplate x:Key="ShellPresetTile" x:DataType="models:ShellPresetItem">
            <!--
              ToolTipOrNull: empty ToolTipText → null (no dark empty square on
              packaged presets). Recent / +Custom keep name+date / Add tips.
            -->
            <StackPanel
                Width="104"
                Padding="4,4,4,2"
                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                AutomationProperties.HelpText="{x:Bind AutomationHelpText}"
                AutomationProperties.Name="{x:Bind AutomationName}"
                Spacing="4"
                ToolTipService.ToolTip="{x:Bind helpers:BindHelpers.ToolTipOrNull(ToolTipText), Mode=OneWay}">
                <StackPanel.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Click="ShellRecentCustomRemoveMenu_Click"
                            IsEnabled="{x:Bind ShowRemoveChrome}"
                            Tag="{x:Bind}"
                            Text="Remove from recent" />
                        <MenuFlyoutItem
                            Click="ShellRecentCustomLocateMenu_Click"
                            IsEnabled="{x:Bind ShowLocateChrome, Mode=OneWay}"
                            Tag="{x:Bind}"
                            Text="Locate…" />
                    </MenuFlyout>
                </StackPanel.ContextFlyout>
                <Grid Width="96" Height="54">
                    <Border
                        Background="{x:Bind Swatch, Mode=OneWay}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Opacity="{x:Bind helpers:BindHelpers.BrokenTileOpacity(IsBroken), Mode=OneWay}" />
                    <ic:FluentIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Icon="Add"
                        IconSize="Size20"
                        IconVariant="Regular"
                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsAddCustom)}" />
                    <ic:FluentIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Icon="Warning"
                        IconSize="Size20"
                        IconVariant="Regular"
                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsBroken), Mode=OneWay}" />
                    <Border
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="2"
                        CornerRadius="6"
                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsSelected), Mode=OneWay}" />
                    <Border
                        Width="18"
                        Height="18"
                        Margin="4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="9"
                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsSelected), Mode=OneWay}">
                        <ic:FluentIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Icon="Checkmark"
                            IconSize="Size12"
                            IconVariant="Filled" />
                    </Border>
                    <Button
                        Width="24"
                        Height="24"
                        MinWidth="24"
                        MinHeight="24"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="{x:Bind RemoveAutomationId}"
                        AutomationProperties.Name="{x:Bind RemoveAutomationName}"
                        Click="ShellRecentCustomRemove_Click"
                        Style="{StaticResource ViewerOverlayButtonStyle}"
                        Tag="{x:Bind}"
                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ShowRemoveChrome)}">
                        <ic:FluentIcon
                            Foreground="{ThemeResource ViewerOverlayButtonGlyphBrush}"
                            Icon="Dismiss"
                            IconSize="Size16"
                            IconVariant="Regular" />
                    </Button>
                    <HyperlinkButton
                        Margin="0,0,0,2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="{x:Bind LocateAutomationId}"
                        AutomationProperties.Name="{x:Bind LocateAutomationName}"
                        Click="ShellRecentCustomLocate_Click"
                        Content="Locate"
                        Tag="{x:Bind}"
                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ShowLocateChrome), Mode=OneWay}" />
                </Grid>
                <TextBlock
                    Padding="2,0"
                    Opacity="{x:Bind helpers:BindHelpers.BrokenTileOpacity(IsBroken), Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Name, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <!-- Two-pane Settings shell: left ~180px section list, content + search on the right. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Padding="8,16,8,16"
            Background="Transparent"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0"
            AutomationProperties.LandmarkType="Navigation"
            AutomationProperties.Name="Settings sections">
            <ListView
                x:Name="LstSettingsNav"
                AutomationProperties.AutomationId="LstSettingsNav"
                AutomationProperties.Name="Settings sections"
                IsItemClickEnabled="False"
                ItemContainerStyle="{StaticResource PalaceSettingsNavItemStyle}"
                SelectionChanged="LstSettingsNav_SelectionChanged"
                SelectionMode="Single">
                <!-- Accent selection pill (scoped — follows BrandAccent / system accent). -->
                <ListView.Resources>
                    <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="AccentFillColorDefaultBrush" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                    <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                    <StaticResource x:Key="ListViewItemForegroundSelectedPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                    <StaticResource x:Key="ListViewItemForegroundSelectedPressed" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                </ListView.Resources>
                <ListView.Items>
                    <ListViewItem
                        x:Name="NavAppearance"
                        AutomationProperties.AutomationId="BtnSettingsNav_Appearance"
                        AutomationProperties.Name="Appearance"
                        Tag="appearance">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:FluentIcon Icon="PaintBrush" IconSize="Size16" IconVariant="Regular" />
                            <TextBlock VerticalAlignment="Center" Text="Appearance" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem
                        x:Name="NavLibrary"
                        AutomationProperties.AutomationId="BtnSettingsNav_Library"
                        AutomationProperties.Name="Library and Folders"
                        Tag="library">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:FluentIcon Icon="Folder" IconSize="Size16" IconVariant="Regular" />
                            <TextBlock VerticalAlignment="Center" Text="Library &amp; Folders" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem
                        x:Name="NavViewer"
                        AutomationProperties.AutomationId="BtnSettingsNav_Viewer"
                        AutomationProperties.Name="Viewer"
                        Tag="viewer">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:FluentIcon Icon="Image" IconSize="Size16" IconVariant="Regular" />
                            <TextBlock VerticalAlignment="Center" Text="Viewer" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem
                        x:Name="NavTags"
                        AutomationProperties.AutomationId="BtnSettingsNav_Tags"
                        AutomationProperties.Name="Tags and Rooms"
                        Tag="tags">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:FluentIcon Icon="Tag" IconSize="Size16" IconVariant="Regular" />
                            <TextBlock VerticalAlignment="Center" Text="Tags &amp; Rooms" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem
                        x:Name="NavInput"
                        AutomationProperties.AutomationId="BtnSettingsNav_Input"
                        AutomationProperties.Name="Input"
                        Tag="input">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:FluentIcon Icon="Keyboard" IconSize="Size16" IconVariant="Regular" />
                            <TextBlock VerticalAlignment="Center" Text="Input" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem
                        x:Name="NavPerformance"
                        AutomationProperties.AutomationId="BtnSettingsNav_Performance"
                        AutomationProperties.Name="Performance"
                        Tag="performance">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:FluentIcon Icon="Database" IconSize="Size16" IconVariant="Regular" />
                            <TextBlock VerticalAlignment="Center" Text="Performance" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem
                        x:Name="NavAbout"
                        AutomationProperties.AutomationId="BtnSettingsNav_About"
                        AutomationProperties.Name="About"
                        Tag="about">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:FluentIcon Icon="Info" IconSize="Size16" IconVariant="Regular" />
                            <TextBlock VerticalAlignment="Center" Text="About" />
                        </StackPanel>
                    </ListViewItem>
                </ListView.Items>
            </ListView>
        </Border>

        <Grid Grid.Column="1" Padding="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBox
                x:Name="TxtSettingsSearch"
                Margin="0,0,0,12"
                AutomationProperties.AutomationId="TxtSettingsSearch"
                AutomationProperties.LandmarkType="Search"
                AutomationProperties.Name="Search settings"
                KeyDown="TxtSettingsSearch_KeyDown"
                PlaceholderText="Search settings"
                TextChanged="TxtSettingsSearch_TextChanged" />

            <ScrollViewer
                x:Name="ScrSettingsContent"
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                AutomationProperties.LandmarkType="Main"
                AutomationProperties.Name="Settings content">
                <StackPanel
                    x:Name="PnlSettingsContent"
                    HorizontalAlignment="Left"
                    Spacing="0">

                    <!-- Appearance -->
                    <StackPanel x:Name="PnlSection_appearance" Spacing="0">
                        <TextBlock
                            Style="{StaticResource PalaceSettingsGroupHeaderStyle}"
                            AutomationProperties.HeadingLevel="Level1"
                            Text="Appearance" />
                        <controls:SettingsCard
                            x:Name="CardTheme"
                            AutomationProperties.AutomationId="CardTheme"
                            AutomationProperties.HelpText="System, Light, or Dark"
                            Description="System, Light, or Dark"
                            Header="Theme"
                            Style="{StaticResource PalaceSettingsCardStyle}">
                            <ComboBox
                                x:Name="CmbTheme"
                                MinWidth="180"
                                AutomationProperties.AutomationId="CmbTheme"
                                ItemsSource="{x:Bind ViewModel.ThemeOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="CardAccent"
                            AutomationProperties.AutomationId="CardAccent"
                            Description="Follow Windows or Palace pink. Applies immediately."
                            Header="Accent color"
                            Style="{StaticResource PalaceSettingsCardStyle}">
                            <ComboBox
                                x:Name="CmbAccent"
                                MinWidth="180"
                                AutomationProperties.AutomationId="CmbAccent"
                                AutomationProperties.HelpText="Applies immediately"
                                ItemsSource="{x:Bind ViewModel.AccentOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedAccent, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="CardDensity"
                            AutomationProperties.AutomationId="CardDensity"
                            AutomationProperties.HelpText="Comfortable or Compact spacing for Settings cards"
                            Description="Comfortable or Compact spacing for Settings cards"
                            Header="Density"
                            Style="{StaticResource PalaceSettingsCardStyle}">
                            <ComboBox
                                x:Name="CmbDensity"
                                MinWidth="180"
                                AutomationProperties.AutomationId="CmbDensity"
                                ItemsSource="{x:Bind ViewModel.DensityOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedDensity, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="CardAnimations"
                            AutomationProperties.AutomationId="CardAnimations"
                            Description="Motion in chrome and overlays. Honored as Settings polish lands."
                            Header="Animations"
                            Style="{StaticResource PalaceSettingsCardStyle}">
                            <ToggleSwitch
                                x:Name="TglAnimations"
                                AutomationProperties.AutomationId="TglAnimations"
                                AutomationProperties.Name="Animations"
                                IsOn="{x:Bind ViewModel.AnimationsEnabled, Mode=TwoWay}"
                                OffContent="Off"
                                OnContent="On" />
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="CardBackground"
                            AutomationProperties.AutomationId="CardBackground"
                            ContentAlignment="Vertical"
                            Description="Presets sit behind chrome. Blur softens image backgrounds."
                            Header="Background"
                            Style="{StaticResource PalaceSettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <!--
                                  Order (Isiac): centered 16:9 preview → Darkness/Blur →
                                  thumbnail grid. Mock nav + card overlay the glass host;
                                  thumbs stay sharp (never blurred/darkened).
                                -->
                                <StackPanel HorizontalAlignment="Center" Spacing="6">
                                    <Grid
                                        x:Name="GrdShellPreview"
                                        Width="498"
                                        Height="280"
                                        HorizontalAlignment="Center"
                                        AutomationProperties.AutomationId="GrdShellPreview"
                                        AutomationProperties.Name="Background preview">
                                        <Border
                                            x:Name="BrdShellPreviewClip"
                                            CornerRadius="8"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                            <Grid>
                                                <Border x:Name="BrdShellPreviewGradient" />
                                                <Image
                                                    x:Name="ImgShellPreviewWallpaper"
                                                    Stretch="UniformToFill" />
                                                <Border x:Name="BrdShellPreviewGlass" />
                                                <Border x:Name="BrdShellPreviewDim" />
                                                <!-- Mock chrome over the composition layer -->
                                                <Grid IsHitTestVisible="False">
                                                    <Border
                                                        Width="48"
                                                        HorizontalAlignment="Left"
                                                        Background="#99000000" />
                                                    <Border
                                                        Margin="64,28,28,28"
                                                        Background="#E01C1C1C"
                                                        BorderBrush="#1AFFFFFF"
                                                        BorderThickness="1"
                                                        CornerRadius="8" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <!-- Selected background name — was above Color tint and crowded the toggle. -->
                                    <TextBlock
                                        x:Name="TxtShellWallpaper"
                                        HorizontalAlignment="Center"
                                        AutomationProperties.AutomationId="TxtShellWallpaper"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.WallpaperLabel, Mode=OneWay}"
                                        TextAlignment="Center" />
                                </StackPanel>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider
                                        x:Name="SldShellDarkness"
                                        Grid.Column="0"
                                        AutomationProperties.AutomationId="SldShellDarkness"
                                        AutomationProperties.Name="Darkness"
                                        Header="Darkness"
                                        IsEnabled="{x:Bind ViewModel.DarknessEnabled, Mode=OneWay}"
                                        Maximum="90"
                                        Minimum="0"
                                        StepFrequency="1"
                                        TickFrequency="10"
                                        TickPlacement="None"
                                        Value="{x:Bind ViewModel.Darkness, Mode=TwoWay}" />
                                    <NumberBox
                                        x:Name="NbShellDarkness"
                                        Grid.Column="1"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.AutomationId="NbShellDarkness"
                                        AutomationProperties.Name="Darkness percent"
                                        IsEnabled="{x:Bind ViewModel.DarknessEnabled, Mode=OneWay}"
                                        LargeChange="10"
                                        Maximum="90"
                                        Minimum="0"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Hidden"
                                        Value="{x:Bind ViewModel.Darkness, Mode=TwoWay}" />
                                    <HyperlinkButton
                                        Grid.Column="2"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.AutomationId="BtnResetShellDarkness"
                                        AutomationProperties.Name="Reset darkness"
                                        Command="{x:Bind ViewModel.ResetDarknessCommand}"
                                        Content="Reset"
                                        IsEnabled="{x:Bind ViewModel.DarknessEnabled, Mode=OneWay}" />
                                </Grid>
                                <TextBlock
                                    x:Name="TxtShellDarkness"
                                    AutomationProperties.AutomationId="TxtShellDarkness"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.DarknessLabel, Mode=OneWay}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider
                                        x:Name="SldShellBlur"
                                        Grid.Column="0"
                                        AutomationProperties.AutomationId="SldShellBlur"
                                        AutomationProperties.Name="Blur"
                                        Header="Blur"
                                        IsEnabled="{x:Bind ViewModel.BlurEnabled, Mode=OneWay}"
                                        Maximum="40"
                                        Minimum="0"
                                        StepFrequency="1"
                                        TickFrequency="5"
                                        TickPlacement="None"
                                        Value="{x:Bind ViewModel.Blur, Mode=TwoWay}" />
                                    <NumberBox
                                        x:Name="NbShellBlur"
                                        Grid.Column="1"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.AutomationId="NbShellBlur"
                                        AutomationProperties.Name="Blur pixels"
                                        IsEnabled="{x:Bind ViewModel.BlurEnabled, Mode=OneWay}"
                                        LargeChange="5"
                                        Maximum="40"
                                        Minimum="0"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Hidden"
                                        Value="{x:Bind ViewModel.Blur, Mode=TwoWay}" />
                                    <HyperlinkButton
                                        Grid.Column="2"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.AutomationId="BtnResetShellBlur"
                                        AutomationProperties.Name="Reset blur"
                                        Command="{x:Bind ViewModel.ResetBlurCommand}"
                                        Content="Reset"
                                        IsEnabled="{x:Bind ViewModel.BlurEnabled, Mode=OneWay}" />
                                </Grid>
                                <TextBlock
                                    x:Name="TxtShellBlur"
                                    AutomationProperties.AutomationId="TxtShellBlur"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.BlurLabel, Mode=OneWay}" />
                                <StackPanel
                                    x:Name="GrdShellPresets"
                                    AutomationProperties.AutomationId="GrdShellPresets"
                                    AutomationProperties.Name="Background"
                                    Spacing="8">
                                    <GridView
                                        x:Name="GrdShellPresetsChrome"
                                        AutomationProperties.AutomationId="GrdShellPresetsChrome"
                                        AutomationProperties.Name="Chrome backgrounds"
                                        IsItemClickEnabled="True"
                                        IsTabStop="True"
                                        ItemClick="ShellPreset_ItemClick"
                                        ItemTemplate="{StaticResource ShellPresetTile}"
                                        ItemsSource="{x:Bind ViewModel.ChromeBackgroundPresets, Mode=OneWay}"
                                        KeyDown="ShellPresetGrid_KeyDown"
                                        SelectionChanged="ShellPreset_SelectionChanged"
                                        SelectionMode="Single"
                                        SingleSelectionFollowsFocus="False" />
                                    <TextBlock
                                        AutomationProperties.AutomationId="TxtShellPresetGroup_Vivid"
                                        Style="{StaticResource PalaceSettingsGroupHeaderStyle}"
                                        Text="Vivid" />
                                    <GridView
                                        x:Name="GrdShellPresetsVivid"
                                        AutomationProperties.AutomationId="GrdShellPresetsVivid"
                                        AutomationProperties.Name="Vivid backgrounds"
                                        IsItemClickEnabled="True"
                                        IsTabStop="True"
                                        ItemClick="ShellPreset_ItemClick"
                                        ItemTemplate="{StaticResource ShellPresetTile}"
                                        ItemsSource="{x:Bind ViewModel.VividBackgroundPresets, Mode=OneWay}"
                                        KeyDown="ShellPresetGrid_KeyDown"
                                        SelectionChanged="ShellPreset_SelectionChanged"
                                        SelectionMode="Single"
                                        SingleSelectionFollowsFocus="False" />
                                    <TextBlock
                                        AutomationProperties.AutomationId="TxtShellPresetGroup_Creator"
                                        Style="{StaticResource PalaceSettingsGroupHeaderStyle}"
                                        Text="Creator" />
                                    <GridView
                                        x:Name="GrdShellPresetsCreator"
                                        AutomationProperties.AutomationId="GrdShellPresetsCreator"
                                        AutomationProperties.Name="Creator backgrounds"
                                        IsItemClickEnabled="True"
                                        IsTabStop="True"
                                        ItemClick="ShellPreset_ItemClick"
                                        ItemTemplate="{StaticResource ShellPresetTile}"
                                        ItemsSource="{x:Bind ViewModel.CreatorBackgroundPresets, Mode=OneWay}"
                                        KeyDown="ShellPresetGrid_KeyDown"
                                        SelectionChanged="ShellPreset_SelectionChanged"
                                        SelectionMode="Single"
                                        SingleSelectionFollowsFocus="False" />
                                    <Border
                                        Height="1"
                                        Margin="0,8,0,4"
                                        Background="{ThemeResource CardStrokeColorDefaultBrush}"
                                        AutomationProperties.AutomationId="BrdShellPresetDivider" />
                                    <TextBlock
                                        AutomationProperties.AutomationId="TxtShellPresetGroup_Recent"
                                        Style="{StaticResource PalaceSettingsGroupHeaderStyle}"
                                        Text="Recent" />
                                    <GridView
                                        x:Name="GrdShellPresetsCustom"
                                        AutomationProperties.AutomationId="GrdShellPresetsCustom"
                                        AutomationProperties.Name="Recent custom backgrounds"
                                        IsItemClickEnabled="True"
                                        IsTabStop="True"
                                        ItemClick="ShellPreset_ItemClick"
                                        ItemTemplate="{StaticResource ShellPresetTile}"
                                        ItemsSource="{x:Bind ViewModel.CustomBackgroundPresets, Mode=OneWay}"
                                        KeyDown="ShellPresetGrid_KeyDown"
                                        SelectionChanged="ShellPreset_SelectionChanged"
                                        SelectionMode="Single"
                                        SingleSelectionFollowsFocus="False" />
                                    <TextBlock
                                        AutomationProperties.AutomationId="TxtShellCustomEmptyCaption"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Custom images you add appear here (up to five). Palace keeps its own copy."
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowCustomEmptyCaption), Mode=OneWay}" />
                                </StackPanel>
                                <InfoBar
                                    x:Name="InfShellCustomBroken"
                                    AutomationProperties.AutomationId="InfShellCustomBroken"
                                    IsClosable="True"
                                    IsOpen="{x:Bind ViewModel.ShowCustomBrokenWarning, Mode=TwoWay}"
                                    Message="{x:Bind ViewModel.CustomBrokenWarningMessage, Mode=OneWay}"
                                    Severity="Warning" />
                                <InfoBar
                                    x:Name="InfShellRecentUndo"
                                    AutomationProperties.AutomationId="InfShellRecentUndo"
                                    GotFocus="InfShellRecentUndo_FocusEntered"
                                    IsOpen="{x:Bind ViewModel.ShowRecentCustomUndoToast, Mode=TwoWay}"
                                    LostFocus="InfShellRecentUndo_FocusExited"
                                    Message="{x:Bind ViewModel.RecentCustomUndoMessage, Mode=OneWay}"
                                    PointerEntered="InfShellRecentUndo_PointerEntered"
                                    PointerExited="InfShellRecentUndo_PointerExited"
                                    Severity="Informational">
                                    <InfoBar.ActionButton>
                                        <Button
                                            AutomationProperties.AutomationId="BtnShellRecentUndo"
                                            Command="{x:Bind ViewModel.UndoRecentCustomRemoveCommand}"
                                            Content="Undo" />
                                    </InfoBar.ActionButton>
                                </InfoBar>
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowCustomWallpaperActions), Mode=OneWay}">
                                    <HyperlinkButton
                                        AutomationProperties.AutomationId="BtnPickWallpaper"
                                        AutomationProperties.Name="Change image"
                                        Command="{x:Bind ViewModel.PickWallpaperCommand}"
                                        Content="Change image…" />
                                    <Button
                                        AutomationProperties.AutomationId="BtnClearWallpaper"
                                        AutomationProperties.Name="Use default gradient"
                                        Command="{x:Bind ViewModel.ClearWallpaperCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ic:FluentIcon Icon="Dismiss" IconSize="Size16" IconVariant="Regular" />
                                            <TextBlock VerticalAlignment="Center" Text="Use default" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <!-- Header + toggle side-by-side — ToggleSwitch Header stacked over OffContent. -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="TxtShellTintLabel"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="Color tint" />
                                    <ToggleSwitch
                                        x:Name="TglShellTint"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="TglShellTint"
                                        AutomationProperties.Name="Color tint"
                                        IsOn="{x:Bind ViewModel.TintEnabled, Mode=TwoWay}"
                                        OffContent="Off"
                                        OnContent="On" />
                                </Grid>
                                <ColorPicker
                                    x:Name="PkrShellTint"
                                    AutomationProperties.AutomationId="PkrShellTint"
                                    AutomationProperties.Name="Wallpaper tint"
                                    IsAlphaEnabled="True"
                                    IsHexInputVisible="True"
                                    ColorChanged="PkrShellTint_ColorChanged"
                                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.TintEnabled), Mode=OneWay}" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </StackPanel>

                    <!-- Library & Folders -->
                    <StackPanel x:Name="PnlSection_library" Spacing="0" Visibility="Collapsed">
                        <TextBlock
                            Style="{StaticResource PalaceSettingsGroupHeaderStyle}"
                            AutomationProperties.HeadingLevel="Level1"
                            Text="Library &amp; Folders" />
                        <!--
                          Watched folders: Expander with per-path Open / Remove + Add folder.
                          UI tests seed SourceFolder rows via CatalogService — never the GUI picker.
                          Empty-state caption lives inside the expander Items (not below all cards).
                        -->
                        <controls:SettingsExpander
                            x:Name="CardWatchedFolders"
                            AutomationProperties.AutomationId="CardWatchedFolders"
                            AutomationProperties.HelpText="Folders Palace indexes for this project"
                            Description="Folders Palace indexes for this project"
                            Header="Watched folders"
                            IsExpanded="True"
                            Style="{StaticResource PalaceSettingsExpanderStyle}">
                            <controls:SettingsExpander.Content>
                                <Button
                                    AutomationProperties.AutomationId="BtnAddSource"
                                    AutomationProperties.Name="Add folder"
                                    Command="{x:Bind ViewModel.AddSourceCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ic:FluentIcon Icon="FolderAdd" IconSize="Size16" IconVariant="Regular" />
                                        <TextBlock VerticalAlignment="Center" Text="Add folder" />
                                    </StackPanel>
                                </Button>
                            </controls:SettingsExpander.Content>
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard
                                    ContentAlignment="Vertical"
                                    Style="{StaticResource PalaceSettingsCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            x:Name="TxtWatchedFoldersEmpty"
                                            AutomationProperties.AutomationId="TxtWatchedFoldersEmpty"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="No watched folders yet."
                                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowWatchedFoldersEmpty), Mode=OneWay}" />
                                        <ItemsControl
                                            x:Name="LstSources"
                                            AutomationProperties.AutomationId="LstSources"
                                            ItemsSource="{x:Bind ViewModel.Sources, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:SourceFolderItem">
                                                    <Grid
                                                        Margin="0,0,0,4"
                                                        AutomationProperties.AutomationId="{x:Bind CardAutomationId, Mode=OneWay}"
                                                        ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button
                                                            Grid.Column="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            AutomationProperties.AutomationId="{x:Bind SelectAutomationId, Mode=OneWay}"
                                                            AutomationProperties.Name="{x:Bind SelectAutomationName, Mode=OneWay}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Command="{x:Bind pages:SettingsPage.GetSelectSourceCommand()}"
                                                            CommandParameter="{x:Bind}"
                                                            Padding="0">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock
                                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                    Text="{x:Bind Path, Mode=OneWay}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="{x:Bind KindCaption, Mode=OneWay}" />
                                                            </StackPanel>
                                                        </Button>
                                                        <StackPanel
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal"
                                                            Spacing="8">
                                                            <Button
                                                                AutomationProperties.AutomationId="{x:Bind OpenAutomationId, Mode=OneWay}"
                                                                AutomationProperties.Name="{x:Bind OpenAutomationName, Mode=OneWay}"
                                                                Command="{x:Bind pages:SettingsPage.GetOpenSourceCommand()}"
                                                                CommandParameter="{x:Bind}"
                                                                ToolTipService.ToolTip="Open in File Explorer">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <ic:FluentIcon Icon="FolderOpen" IconSize="Size16" IconVariant="Regular" />
                                                                    <TextBlock VerticalAlignment="Center" Text="Open" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button
                                                                AutomationProperties.AutomationId="{x:Bind RemoveAutomationId, Mode=OneWay}"
                                                                AutomationProperties.Name="{x:Bind RemoveAutomationName, Mode=OneWay}"
                                                                Command="{x:Bind pages:SettingsPage.GetRemoveSourceCommand()}"
                                                                CommandParameter="{x:Bind}"
                                                                ToolTipService.ToolTip="Remove from library">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <ic:FluentIcon Icon="FolderArrowLeft" IconSize="Size16" IconVariant="Regular" />
                                                                    <TextBlock VerticalAlignment="Center" Text="Remove" />
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>
                        <controls:SettingsExpander
                            x:Name="CardSelectedFolder"
                            AutomationProperties.AutomationId="CardSelectedFolder"
                            Description="Templates and destination for the selected watched folder"
                            Header="Selected folder"
                            Style="{StaticResource PalaceSettingsExpanderStyle}">
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard
                                    Header="Auto-organize new files"
                                    Style="{StaticResource PalaceSettingsCardStyle}">
                                    <ToggleSwitch
                                        x:Name="TglAutoOrganize"
                                        AutomationProperties.AutomationId="TglAutoOrganize"
                                        IsOn="{x:Bind ViewModel.SelectedSource.AutoOrganizeNewFiles, Mode=TwoWay, FallbackValue=False}"
                                        OffContent="Off"
                                        OnContent="On" />
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    Header="Folder template"
                                    Style="{StaticResource PalaceSettingsCardStyle}">
                                    <TextBox
                                        x:Name="TxtSourceFolderTemplate"
                                        MinWidth="220"
                                        AutomationProperties.AutomationId="TxtSourceFolderTemplate"
                                        Text="{x:Bind ViewModel.SelectedSource.FolderTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" />
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    Header="Filename template"
                                    Style="{StaticResource PalaceSettingsCardStyle}">
                                    <TextBox
                                        x:Name="TxtSourceFileTemplate"
                                        MinWidth="220"
                                        AutomationProperties.AutomationId="TxtSourceFileTemplate"
                                        Text="{x:Bind ViewModel.SelectedSource.FileTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" />
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    Header="New-file destination"
                                    Style="{StaticResource PalaceSettingsCardStyle}">
                                    <ComboBox
                                        x:Name="CmbDestinationPolicy"
                                        MinWidth="240"
                                        AutomationProperties.AutomationId="CmbDestinationPolicy"
                                        SelectedIndex="{x:Bind ViewModel.SelectedSource.DestinationPolicyIndex, Mode=TwoWay, FallbackValue=0}">
                                        <ComboBoxItem Content="Organize inside the source folder" />
                                        <ComboBoxItem Content="Organize into the saved destination" />
                                    </ComboBox>
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    ContentAlignment="Vertical"
                                    Header="Saved destination"
                                    Style="{StaticResource PalaceSettingsCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBox
                                            x:Name="TxtDestinationPath"
                                            AutomationProperties.AutomationId="TxtDestinationPath"
                                            IsReadOnly="True"
                                            Text="{x:Bind ViewModel.SelectedSource.DestinationPath, Mode=OneWay, FallbackValue=''}" />
                                        <Button
                                            AutomationProperties.AutomationId="BtnPickSourceDestination"
                                            AutomationProperties.Name="Pick auto-organize destination"
                                            Command="{x:Bind ViewModel.PickDestinationCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ic:FluentIcon Icon="FolderOpen" IconSize="Size16" IconVariant="Regular" />
                                                <TextBlock VerticalAlignment="Center" Text="Pick auto-organize destination" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>
                        <controls:SettingsExpander
                            x:Name="CardScanning"
                            AutomationProperties.AutomationId="CardScanning"
                            Description="How Palace discovers new files in watched folders"
                            Header="Scanning"
                            Style="{StaticResource PalaceSettingsExpanderStyle}">
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard
                                    Description="Index Created, Changed, and Renamed files automatically"
                                    Header="Watch for changes"
                                    Style="{StaticResource PalaceSettingsCardStyle}">
                                    <ToggleSwitch
                                        x:Name="TglWatchForChanges"
                                        AutomationProperties.AutomationId="TglWatchForChanges"
                                        AutomationProperties.Name="Watch for changes"
                                        IsOn="{x:Bind ViewModel.WatchForChanges, Mode=TwoWay}"
                                        OffContent="Off"
                                        OnContent="On" />
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    Description="Walk every watched folder now"
                                    Header="Scan library"
                                    Style="{StaticResource PalaceSettingsCardStyle}">
                                    <Button
                                        AutomationProperties.AutomationId="BtnScanLibrary"
                                        AutomationProperties.Name="Scan library"
                                        Command="{x:Bind ViewModel.ScanLibraryCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ic:FluentIcon Icon="ArrowSync" IconSize="Size16" IconVariant="Regular" />
                                            <TextBlock VerticalAlignment="Center" Text="Scan now" />
                                        </StackPanel>
                                    </Button>
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>
                        <controls:SettingsExpander
                            x:Name="CardThumbnailCache"
                            AutomationProperties.AutomationId="CardThumbnailCache"
                            Description="Mosaic JPEGs. Optional size limit and folder live under Performance."
                            Header="Thumbnail cache"
                            Style="{StaticResource PalaceSettingsExpanderStyle}">
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard
                                    Description="When off, mosaic builds thumbs on demand as tiles appear"
                                    Header="Build thumbnails while scanning"
                                    Style="{StaticResource PalaceSettingsCardStyle}">
                                    <ToggleSwitch
                                        x:Name="TglGenerateThumbsOnScan"
                                        AutomationProperties.AutomationId="TglGenerateThumbsOnScan"
                                        AutomationProperties.Name="Build thumbnails while scanning"
                                        IsOn="{x:Bind ViewModel.GenerateThumbsOnScan, Mode=TwoWay}"
                                        OffContent="Off"
                                        OnContent="On" />
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>
                        <controls:SettingsExpander
                            x:Name="CardFormats"
                            AutomationProperties.AutomationId="CardFormats"
                            Description="Which kinds Palace indexes. Leave room for 3D and audio."
                            Header="Formats"
                            Style="{StaticResource PalaceSettingsExpanderStyle}">
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard
                                    Description="{x:Bind ViewModel.ImagesFormatsCaption, Mode=OneWay}"
                                    Header="Images"
                                    Style="{StaticResource PalaceSettingsCardStyle}">
                                    <ToggleSwitch
                                        x:Name="TglIndexImages"
                                        AutomationProperties.AutomationId="TglIndexImages"
                                        AutomationProperties.Name="Index images"
                                        IsOn="{x:Bind ViewModel.IndexImages, Mode=TwoWay}"
                                        OffContent="Off"
                                        OnContent="On" />
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    Description="{x:Bind ViewModel.VideoFormatsCaption, Mode=OneWay}"
                                    Header="Video"
                                    Style="{StaticResource PalaceSettingsCardStyle}">
                                    <ToggleSwitch
                                        x:Name="TglIndexVideo"
                                        AutomationProperties.AutomationId="TglIndexVideo"
                                        AutomationProperties.Name="Index video"
                                        IsOn="{x:Bind ViewModel.IndexVideo, Mode=TwoWay}"
                                        OffContent="Off"
                                        OnContent="On" />
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    x:Name="CardFormats3dPlaceholder"
                                    AutomationProperties.AutomationId="CardFormats3dPlaceholder"
                                    Description="{x:Bind ViewModel.FormatsPlaceholderCaption, Mode=OneWay}"
                                    Header="3D"
                                    IsEnabled="False"
                                    Style="{StaticResource PalaceSettingsCardStyle}" />
                                <controls:SettingsCard
                                    x:Name="CardFormatsAudioPlaceholder"
                                    AutomationProperties.AutomationId="CardFormatsAudioPlaceholder"
                                    Description="{x:Bind ViewModel.FormatsPlaceholderCaption, Mode=OneWay}"
                                    Header="Audio"
                                    IsEnabled="False"
                                    Style="{StaticResource PalaceSettingsCardStyle}" />
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>
                        <controls:SettingsExpander
                            x:Name="CardCloudAccounts"
                            AutomationProperties.AutomationId="CardCloudAccounts"
                            Description="Public-client app IDs stay on this device"
                            Header="Cloud accounts"
                            Style="{StaticResource PalaceSettingsExpanderStyle}">
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard
                                    Header="OAuth redirect URI"
                                    Style="{StaticResource PalaceSettingsCardStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox
                                            x:Name="TxtCloudRedirectUri"
                                            MinWidth="220"
                                            AutomationProperties.AutomationId="TxtCloudRedirectUri"
                                            IsReadOnly="True"
                                            Text="{x:Bind ViewModel.RedirectUri, Mode=OneWay}" />
                                        <Button
                                            AutomationProperties.AutomationId="BtnCopyRedirectUri"
                                            AutomationProperties.Name="Copy redirect URI"
                                            Command="{x:Bind ViewModel.CopyRedirectUriCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ic:FluentIcon Icon="Copy" IconSize="Size16" IconVariant="Regular" />
                                                <TextBlock VerticalAlignment="Center" Text="Copy" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    ContentAlignment="Vertical"
                                    Header="OneDrive"
                                    Style="{StaticResource PalaceSettingsCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBox
                                            x:Name="TxtOneDriveClientId"
                                            AutomationProperties.AutomationId="TxtOneDriveClientId"
                                            Header="Application (client) ID"
                                            Text="{x:Bind ViewModel.OneDriveClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            x:Name="TxtOneDriveStatus"
                                            AutomationProperties.AutomationId="TxtOneDriveStatus"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind ViewModel.OneDriveStatus, Mode=OneWay}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                AutomationProperties.AutomationId="BtnConnectOneDrive"
                                                AutomationProperties.Name="Connect OneDrive"
                                                Command="{x:Bind ViewModel.ConnectOneDriveCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <ic:FluentIcon Icon="Cloud" IconSize="Size16" IconVariant="Regular" />
                                                    <TextBlock VerticalAlignment="Center" Text="Connect OneDrive" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                AutomationProperties.AutomationId="BtnDisconnectOneDrive"
                                                AutomationProperties.Name="Disconnect OneDrive"
                                                Command="{x:Bind ViewModel.DisconnectOneDriveCommand}"
                                                IsEnabled="{x:Bind ViewModel.IsOneDriveConnected, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <ic:FluentIcon Icon="PlugDisconnected" IconSize="Size16" IconVariant="Regular" />
                                                    <TextBlock VerticalAlignment="Center" Text="Disconnect" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                AutomationProperties.AutomationId="BtnAddOneDriveFolder"
                                                AutomationProperties.Name="Add OneDrive folder"
                                                Command="{x:Bind ViewModel.AddOneDriveFolderCommand}"
                                                IsEnabled="{x:Bind ViewModel.IsOneDriveConnected, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <ic:FluentIcon Icon="FolderAdd" IconSize="Size16" IconVariant="Regular" />
                                                    <TextBlock VerticalAlignment="Center" Text="Add OneDrive folder" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    ContentAlignment="Vertical"
                                    Header="Dropbox"
                                    Style="{StaticResource PalaceSettingsCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBox
                                            x:Name="TxtDropboxAppKey"
                                            AutomationProperties.AutomationId="TxtDropboxAppKey"
                                            Header="App key"
                                            Text="{x:Bind ViewModel.DropboxAppKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            x:Name="TxtDropboxStatus"
                                            AutomationProperties.AutomationId="TxtDropboxStatus"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind ViewModel.DropboxStatus, Mode=OneWay}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                AutomationProperties.AutomationId="BtnConnectDropbox"
                                                AutomationProperties.Name="Connect Dropbox"
                                                Command="{x:Bind ViewModel.ConnectDropboxCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <ic:FluentIcon Icon="Cloud" IconSize="Size16" IconVariant="Regular" />
                                                    <TextBlock VerticalAlignment="Center" Text="Connect Dropbox" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                AutomationProperties.AutomationId="BtnDisconnectDropbox"
                                                AutomationProperties.Name="Disconnect Dropbox"
                                                Command="{x:Bind ViewModel.DisconnectDropboxCommand}"
                                                IsEnabled="{x:Bind ViewModel.IsDropboxConnected, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <ic:FluentIcon Icon="PlugDisconnected" IconSize="Size16" IconVariant="Regular" />
                                                    <TextBlock VerticalAlignment="Center" Text="Disconnect" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                AutomationProperties.AutomationId="BtnAddDropboxFolder"
                                                AutomationProperties.Name="Add Dropbox folder"
                                                Command="{x:Bind ViewModel.AddDropboxFolderCommand}"
                                                IsEnabled="{x:Bind ViewModel.IsDropboxConnected, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <ic:FluentIcon Icon="FolderAdd" IconSize="Size16" IconVariant="Regular" />
                                                    <TextBlock VerticalAlignment="Center" Text="Add Dropbox folder" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>
                        <TextBlock
                            AutomationProperties.AutomationId="TxtSettingsStatus"
                            Margin="0,8,0,0"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Viewer -->
                    <StackPanel x:Name="PnlSection_viewer" Spacing="0" Visibility="Collapsed">
                        <TextBlock
                            Style="{StaticResource PalaceSettingsGroupHeaderStyle}"
                            AutomationProperties.HeadingLevel="Level1"
                            Text="Viewer" />
                        <controls:SettingsCard
                            x:Name="CardDefaultZoom"
                            AutomationProperties.AutomationId="CardDefaultZoom"
                            Description="Scale when the overlay or gallery window opens"
                            Header="Default zoom"
                            Style="{StaticResource PalaceSettingsCardStyle}">
                            <ComboBox
                                x:Name="CmbDefaultZoom"
                                MinWidth="140"
                                AutomationProperties.AutomationId="CmbDefaultZoom"
                                AutomationProperties.Name="Default zoom"
                                ItemsSource="{x:Bind ViewModel.ZoomOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedDefaultZoom, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="CardKeepZoomBetweenImages"
                            AutomationProperties.AutomationId="CardKeepZoomBetweenImages"
                            Description="{x:Bind ViewModel.KeepZoomBetweenImagesCaption, Mode=OneWay}"
                            Header="Keep zoom between images"
                            Style="{StaticResource PalaceSettingsCardStyle}">
                            <ToggleSwitch
                                x:Name="TglKeepZoomBetweenImages"
                                AutomationProperties.AutomationId="TglKeepZoomBetweenImages"
                                AutomationProperties.Name="Keep zoom between images"
                                IsOn="{x:Bind ViewModel.KeepZoomBetweenImages, Mode=TwoWay}"
                                OffContent="Off"
                                OnContent="On" />
                        </controls:SettingsCard>
                        <controls:SettingsExpander
                            x:Name="CardHdr"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="CardHdr"
                            Description="Peak override for HDR displays; SDR stills tonemap automatically"
                            Header="HDR and tonemap"
                            Style="{StaticResource PalaceSettingsExpanderStyle}">
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard
                                    x:Name="CardHdrPeak"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.AutomationId="CardHdrPeak"
                                    Description="One app-wide clip for HDR present. 203 nits is paper white."
                                    Header="Override HDR peak brightness"
                                    Style="{StaticResource PalaceSettingsCardStyle}">
                                    <ToggleSwitch
                                        x:Name="TglHdrPeakOverride"
                                        AutomationProperties.AutomationId="TglHdrPeakOverride"
                                        AutomationProperties.Name="Override HDR peak brightness"
                                        IsOn="{x:Bind ViewModel.PeakOverrideEnabled, Mode=TwoWay}"
                                        OffContent="Off"
                                        OnContent="On" />
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    x:Name="CardHdrPeakNits"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.AutomationId="CardHdrPeakNits"
                                    Header="Peak nits"
                                    Style="{StaticResource PalaceSettingsCardStyle}"
                                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.PeakOverrideEnabled), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Slider
                                            x:Name="SldHdrPeakNits"
                                            MinWidth="180"
                                            AutomationProperties.AutomationId="SldHdrPeakNits"
                                            AutomationProperties.Name="Peak nits"
                                            Maximum="4000"
                                            Minimum="80"
                                            StepFrequency="10"
                                            TickFrequency="400"
                                            TickPlacement="None"
                                            Value="{x:Bind ViewModel.PeakOverrideNits, Mode=TwoWay}" />
                                        <TextBlock
                                            x:Name="TxtHdrPeakNits"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="TxtHdrPeakNits"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.PeakOverrideLabel, Mode=OneWay}" />
                                    </StackPanel>
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    x:Name="CardHdrTonemap"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.AutomationId="CardHdrTonemap"
                                    Description="{x:Bind ViewModel.SdrTonemapCaption, Mode=OneWay}"
                                    Header="SDR tonemap"
                                    IsEnabled="False"
                                    Style="{StaticResource PalaceSettingsCardStyle}" />
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>
                        <controls:SettingsCard
                            x:Name="CardShowDetails"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="CardShowDetails"
                            Description="Open the Details card with the overlay. Toggle anytime with I / Ctrl+D."
                            Header="Show Details by default"
                            Style="{StaticResource PalaceSettingsCardStyle}">
                            <ToggleSwitch
                                x:Name="TglShowDetails"
                                AutomationProperties.AutomationId="TglShowDetails"
                                AutomationProperties.Name="Show Details by default"
                                IsOn="{x:Bind ViewModel.ShowDetailsByDefault, Mode=TwoWay}"
                                OffContent="Off"
                                OnContent="On" />
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="CardSlideshow"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="CardSlideshow"
                            Description="{x:Bind ViewModel.SlideshowPlaceholderCaption, Mode=OneWay}"
                            Header="Slideshow"
                            IsEnabled="False"
                            Style="{StaticResource PalaceSettingsCardStyle}" />
                        <controls:SettingsCard
                            x:Name="CardLoopVideo"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="CardLoopVideo"
                            Description="Replay video when it reaches the end"
                            Header="Loop video"
                            Style="{StaticResource PalaceSettingsCardStyle}">
                            <ToggleSwitch
                                x:Name="TglLoopVideo"
                                AutomationProperties.AutomationId="TglLoopVideo"
                                AutomationProperties.Name="Loop video"
                                IsOn="{x:Bind ViewModel.LoopVideo, Mode=TwoWay}"
                                OffContent="Off"
                                OnContent="On" />
                        </controls:SettingsCard>
                    </StackPanel>

                    <!-- Tags & Rooms -->
                    <StackPanel x:Name="PnlSection_tags" Spacing="0" Visibility="Collapsed">
                        <TextBlock
                            Style="{StaticResource PalaceSettingsGroupHeaderStyle}"
                            AutomationProperties.HeadingLevel="Level1"
                            Text="Tags &amp; Rooms" />
                        <controls:SettingsCard
                            x:Name="CardTagPortable"
                            AutomationProperties.AutomationId="CardTagPortable"
                            Description="Export writes portable JSON. Import merges by name."
                            Header="Export / import tags"
                            Style="{StaticResource PalaceSettingsCardStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="BtnExportTags"
                                    AutomationProperties.Name="Export tags"
                                    Command="{x:Bind ViewModel.ExportTagsCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ic:FluentIcon Icon="ArrowExport" IconSize="Size16" IconVariant="Regular" />
                                        <TextBlock VerticalAlignment="Center" Text="Export tags" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    AutomationProperties.AutomationId="BtnImportTags"
                                    AutomationProperties.Name="Import tags"
                                    Command="{x:Bind ViewModel.ImportTagsCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ic:FluentIcon Icon="ArrowImport" IconSize="Size16" IconVariant="Regular" />
                                        <TextBlock VerticalAlignment="Center" Text="Import tags" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="CardRoomsPlaceholder"
                            AutomationProperties.AutomationId="CardRoomsPlaceholder"
                            Description="Rooms settings land in a later Settings update."
                            Header="Rooms"
                            IsEnabled="False"
                            Style="{StaticResource PalaceSettingsCardStyle}" />
                    </StackPanel>

                    <!-- Input -->
                    <StackPanel x:Name="PnlSection_input" Spacing="0" Visibility="Collapsed">
                        <TextBlock
                            Style="{StaticResource PalaceSettingsGroupHeaderStyle}"
                            AutomationProperties.HeadingLevel="Level1"
                            Text="Input" />
                        <controls:SettingsCard
                            x:Name="CardShortcuts"
                            AutomationProperties.AutomationId="CardShortcuts"
                            ContentAlignment="Vertical"
                            Description="Read-only. Overlay and gallery shortcuts."
                            Header="Shortcuts"
                            Style="{StaticResource PalaceSettingsCardStyle}">
                            <ItemsControl
                                x:Name="LstShortcuts"
                                AutomationProperties.AutomationId="LstShortcuts"
                                ItemsSource="{x:Bind ViewModel.ShortcutHints, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="helpers:ShortcutHint">
                                        <Grid
                                            Margin="0,4,0,4"
                                            AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                                            AutomationProperties.Name="{x:Bind Line, Mode=OneTime}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ItemsControl ItemsSource="{x:Bind KeyParts, Mode=OneTime}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border Style="{StaticResource PalaceShortcutKeyChipStyle}">
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Text="{x:Bind}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Action, Mode=OneTime}"
                                                TextWrapping="WrapWholeWords" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="CardTouchGestures"
                            AutomationProperties.AutomationId="CardTouchGestures"
                            Description="Pinch and pan with touch, pen, or trackpad. Mouse left-drag pan stays on when this is off."
                            Header="Touch gestures"
                            Style="{StaticResource PalaceSettingsCardStyle}">
                            <ToggleSwitch
                                x:Name="TglTouchGestures"
                                AutomationProperties.AutomationId="TglTouchGestures"
                                AutomationProperties.Name="Touch gestures"
                                IsOn="{x:Bind ViewModel.TouchGesturesEnabled, Mode=TwoWay}"
                                OffContent="Off"
                                OnContent="On" />
                        </controls:SettingsCard>
                    </StackPanel>

                    <!-- Performance & Storage -->
                    <StackPanel x:Name="PnlSection_performance" Spacing="0" Visibility="Collapsed">
                        <TextBlock
                            Style="{StaticResource PalaceSettingsGroupHeaderStyle}"
                            AutomationProperties.HeadingLevel="Level1"
                            Text="Performance" />
                        <controls:SettingsExpander
                            x:Name="CardMediaCache"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="CardMediaCache"
                            Description="{x:Bind ViewModel.MediaCacheUsageLabel, Mode=OneWay}"
                            Header="Media cache"
                            IsExpanded="True"
                            Style="{StaticResource PalaceSettingsExpanderStyle}">
                            <ToggleSwitch
                                x:Name="TglMediaCache"
                                AutomationProperties.AutomationId="TglMediaCache"
                                AutomationProperties.Name="Enable media cache"
                                IsOn="{x:Bind ViewModel.MediaCacheEnabled, Mode=TwoWay}"
                                OffContent="Off"
                                OnContent="On" />
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Description="Optional derived thumbs/preview cache. Never recalls online-only originals."
                                    Header="Size limit"
                                    Style="{StaticResource PalaceSettingsCardStyle}"
                                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.MediaCacheEnabled), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Slider
                                            x:Name="SldMediaCacheMaxMb"
                                            MinWidth="180"
                                            AutomationProperties.AutomationId="SldMediaCacheMaxMb"
                                            AutomationProperties.Name="Max cache size"
                                            Maximum="32768"
                                            Minimum="256"
                                            StepFrequency="256"
                                            TickFrequency="2048"
                                            TickPlacement="None"
                                            Value="{x:Bind ViewModel.MediaCacheMaxMb, Mode=TwoWay}" />
                                        <TextBlock
                                            x:Name="TxtMediaCacheMaxMb"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="TxtMediaCacheMaxMb"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.MediaCacheMaxLabel, Mode=OneWay}" />
                                    </StackPanel>
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    ContentAlignment="Vertical"
                                    Header="Cache folder"
                                    Style="{StaticResource PalaceSettingsCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            x:Name="TxtMediaCacheUsage"
                                            AutomationProperties.AutomationId="TxtMediaCacheUsage"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind ViewModel.MediaCacheUsageLabel, Mode=OneWay}" />
                                        <TextBlock
                                            x:Name="TxtMediaCachePath"
                                            AutomationProperties.AutomationId="TxtMediaCachePath"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind ViewModel.MediaCachePathLabel, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                AutomationProperties.AutomationId="BtnPickCacheFolder"
                                                AutomationProperties.Name="Choose cache folder"
                                                Command="{x:Bind ViewModel.PickCacheFolderCommand}"
                                                IsEnabled="{x:Bind ViewModel.MediaCacheEnabled, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <ic:FluentIcon Icon="FolderOpen" IconSize="Size16" IconVariant="Regular" />
                                                    <TextBlock VerticalAlignment="Center" Text="Choose cache folder" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                AutomationProperties.AutomationId="BtnResetCacheFolder"
                                                AutomationProperties.Name="Reset to default cache folder"
                                                Command="{x:Bind ViewModel.ResetCacheFolderCommand}"
                                                IsEnabled="{x:Bind ViewModel.HasCustomCacheFolder, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <ic:FluentIcon Icon="ArrowUndo" IconSize="Size16" IconVariant="Regular" />
                                                    <TextBlock VerticalAlignment="Center" Text="Reset to default" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                AutomationProperties.AutomationId="BtnClearCache"
                                                AutomationProperties.Name="Clear cache"
                                                Command="{x:Bind ViewModel.ClearCacheCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <ic:FluentIcon Icon="Delete" IconSize="Size16" IconVariant="Regular" />
                                                    <TextBlock VerticalAlignment="Center" Text="Clear cache" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>
                        <controls:SettingsCard
                            x:Name="CardCatalogPath"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="CardCatalogPath"
                            ContentAlignment="Vertical"
                            Description="Durable palace.db outside package LocalState"
                            Header="Catalog location"
                            Style="{StaticResource PalaceSettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    x:Name="TxtCatalogPath"
                                    AutomationProperties.AutomationId="TxtCatalogPath"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind ViewModel.CatalogPathLabel, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="TxtCatalogRestartHint"
                                    AutomationProperties.AutomationId="TxtCatalogRestartHint"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.CatalogRestartHint, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(ViewModel.CatalogRestartHint), Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        AutomationProperties.AutomationId="BtnPickCatalogFolder"
                                        AutomationProperties.Name="Choose catalog folder"
                                        Command="{x:Bind ViewModel.PickCatalogFolderCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ic:FluentIcon Icon="FolderOpen" IconSize="Size16" IconVariant="Regular" />
                                            <TextBlock VerticalAlignment="Center" Text="Choose catalog folder" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        AutomationProperties.AutomationId="BtnResetCatalogFolder"
                                        AutomationProperties.Name="Reset to durable default"
                                        Command="{x:Bind ViewModel.ResetCatalogFolderCommand}"
                                        IsEnabled="{x:Bind ViewModel.CatalogUsesCustomRoot, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ic:FluentIcon Icon="ArrowUndo" IconSize="Size16" IconVariant="Regular" />
                                            <TextBlock VerticalAlignment="Center" Text="Reset to durable default" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsExpander
                            x:Name="CardGpuPreview"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="CardGpuPreview"
                            Description="Decode load for mosaic thumbs and side preview"
                            Header="GPU &amp; preview"
                            Style="{StaticResource PalaceSettingsExpanderStyle}">
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard
                                    x:Name="CardThumbConcurrency"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.AutomationId="CardThumbConcurrency"
                                    Description="{x:Bind ViewModel.ThumbConcurrencyCaption, Mode=OneWay}"
                                    Header="Thumbnail decode"
                                    Style="{StaticResource PalaceSettingsCardStyle}">
                                    <ComboBox
                                        x:Name="CmbThumbConcurrency"
                                        MinWidth="140"
                                        AutomationProperties.AutomationId="CmbThumbConcurrency"
                                        AutomationProperties.Name="Thumbnail decode concurrency"
                                        ItemsSource="{x:Bind ViewModel.ThumbConcurrencyOptions, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedThumbConcurrency, Mode=TwoWay}" />
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    x:Name="CardPreviewQuality"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.AutomationId="CardPreviewQuality"
                                    Description="{x:Bind ViewModel.PreviewQualityCaption, Mode=OneWay}"
                                    Header="Preview quality"
                                    Style="{StaticResource PalaceSettingsCardStyle}">
                                    <ComboBox
                                        x:Name="CmbPreviewQuality"
                                        MinWidth="140"
                                        AutomationProperties.AutomationId="CmbPreviewQuality"
                                        AutomationProperties.Name="Preview quality"
                                        ItemsSource="{x:Bind ViewModel.PreviewQualityOptions, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedPreviewQuality, Mode=TwoWay}" />
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>
                    </StackPanel>

                    <!-- About -->
                    <StackPanel x:Name="PnlSection_about" Spacing="0" Visibility="Collapsed">
                        <TextBlock
                            Style="{StaticResource PalaceSettingsGroupHeaderStyle}"
                            AutomationProperties.HeadingLevel="Level1"
                            Text="About" />
                        <controls:SettingsCard
                            x:Name="CardAppVersion"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="CardAppVersion"
                            ContentAlignment="Vertical"
                            Header="Version"
                            Style="{StaticResource PalaceSettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    x:Name="TxtAppVersion"
                                    AutomationProperties.AutomationId="TxtAppVersion"
                                    AutomationProperties.Name="App version"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.AppVersionText, Mode=OneWay}" />
                                <TextBlock
                                    x:Name="TxtInfancyNote"
                                    AutomationProperties.AutomationId="TxtInfancyNote"
                                    AutomationProperties.Name="Feature status"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.InfancyNoteText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                                <Button
                                    AutomationProperties.AutomationId="BtnCopyAppVersion"
                                    AutomationProperties.Name="Copy version"
                                    Command="{x:Bind ViewModel.CopyAppVersionCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ic:FluentIcon Icon="Copy" IconSize="Size16" IconVariant="Regular" />
                                        <TextBlock VerticalAlignment="Center" Text="Copy version" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="CardUpdateChannel"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="CardUpdateChannel"
                            Description="{x:Bind ViewModel.UpdateChannelCaption, Mode=OneWay}"
                            Header="Update channel"
                            Style="{StaticResource PalaceSettingsCardStyle}">
                            <TextBlock
                                x:Name="TxtUpdateChannel"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="TxtUpdateChannel"
                                AutomationProperties.Name="Update channel"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.UpdateChannelLabel, Mode=OneWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="CardLicenses"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="CardLicenses"
                            Description="Background asset attributions and third-party notices"
                            Header="Licenses"
                            Style="{StaticResource PalaceSettingsCardStyle}">
                            <Button
                                AutomationProperties.AutomationId="BtnOpenLicenses"
                                AutomationProperties.Name="Open licenses"
                                Command="{x:Bind ViewModel.OpenLicensesCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ic:FluentIcon Icon="DocumentCopy" IconSize="Size16" IconVariant="Regular" />
                                    <TextBlock VerticalAlignment="Center" Text="Open licenses" />
                                </StackPanel>
                            </Button>
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="CardLogs"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="CardLogs"
                            Description="error-log.txt in the app local folder (for bug reports)"
                            Header="Diagnostic logs"
                            Style="{StaticResource PalaceSettingsCardStyle}">
                            <Button
                                AutomationProperties.AutomationId="BtnOpenLogs"
                                AutomationProperties.Name="Open log folder"
                                Command="{x:Bind ViewModel.OpenLogsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ic:FluentIcon Icon="FolderOpen" IconSize="Size16" IconVariant="Regular" />
                                    <TextBlock VerticalAlignment="Center" Text="Open log folder" />
                                </StackPanel>
                            </Button>
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="CardExportImportSettings"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="CardExportImportSettings"
                            Description="Portable JSON for Appearance, Viewer, Performance, and related prefs. Not catalog or cloud sign-in."
                            Header="Export / import settings"
                            Style="{StaticResource PalaceSettingsCardStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="BtnExportSettings"
                                    AutomationProperties.Name="Export settings"
                                    Command="{x:Bind ViewModel.ExportSettingsCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ic:FluentIcon Icon="ArrowExport" IconSize="Size16" IconVariant="Regular" />
                                        <TextBlock VerticalAlignment="Center" Text="Export settings" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    AutomationProperties.AutomationId="BtnImportSettings"
                                    AutomationProperties.Name="Import settings"
                                    Command="{x:Bind ViewModel.ImportSettingsCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ic:FluentIcon Icon="ArrowImport" IconSize="Size16" IconVariant="Regular" />
                                        <TextBlock VerticalAlignment="Center" Text="Import settings" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="CardExportCatalog"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="CardExportCatalog"
                            Description="Copy palace.db to a folder you choose"
                            Header="Export catalog copy"
                            Style="{StaticResource PalaceSettingsCardStyle}">
                            <Button
                                AutomationProperties.AutomationId="BtnExportCatalogCopy"
                                AutomationProperties.Name="Export catalog copy"
                                Command="{x:Bind ViewModel.ExportCatalogCopyCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ic:FluentIcon Icon="Save" IconSize="Size16" IconVariant="Regular" />
                                    <TextBlock VerticalAlignment="Center" Text="Export catalog copy" />
                                </StackPanel>
                            </Button>
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="CardGlobalReset"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="CardGlobalReset"
                            Description="Restore app preferences to defaults. Catalog and watched folders stay."
                            Header="Reset all settings"
                            Style="{StaticResource PalaceSettingsCardStyle}">
                            <Button
                                AutomationProperties.AutomationId="BtnGlobalReset"
                                AutomationProperties.Name="Reset all settings"
                                Command="{x:Bind ViewModel.GlobalResetCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ic:FluentIcon Icon="ArrowUndo" IconSize="Size16" IconVariant="Regular" />
                                    <TextBlock VerticalAlignment="Center" Text="Reset all settings" />
                                </StackPanel>
                            </Button>
                        </controls:SettingsCard>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
