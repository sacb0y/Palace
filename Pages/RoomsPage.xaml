<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Palace.Pages.RoomsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Palace.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Palace.Models"
    xmlns:pages="using:Palace.Pages"
    mc:Ignorable="d">

    <Grid Padding="16" ColumnSpacing="16" RowSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Rooms" />

        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListView
                x:Name="LstRooms"
                AutomationProperties.AutomationId="LstRooms"
                AutomationProperties.Name="Rooms"
                DisplayMemberPath="Name"
                ItemsSource="{x:Bind ViewModel.Rooms, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedRoom, Mode=TwoWay}" />
            <TextBox
                x:Name="TxtRoomName"
                Grid.Row="1"
                AutomationProperties.AutomationId="TxtRoomName"
                Header="Room name"
                Text="{x:Bind ViewModel.NewRoomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button
                    AutomationProperties.AutomationId="BtnNewRoom"
                    Command="{x:Bind ViewModel.CreateRoomCommand}"
                    Content="New room" />
                <Button
                    AutomationProperties.AutomationId="BtnRenameRoom"
                    Command="{x:Bind ViewModel.RenameRoomCommand}"
                    Content="Rename" />
                <Button
                    AutomationProperties.AutomationId="BtnDeleteRoom"
                    Command="{x:Bind ViewModel.DeleteRoomCommand}"
                    Content="Delete" />
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="1"
            Grid.Column="1"
            RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox
                    x:Name="TxtSectionName"
                    MinWidth="200"
                    AutomationProperties.AutomationId="TxtSectionName"
                    Header="New section"
                    Text="{x:Bind ViewModel.NewSectionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="BtnAddSection"
                    Command="{x:Bind ViewModel.AddSectionCommand}"
                    Content="Add section" />
                <Button
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="BtnRemovePin"
                    Command="{x:Bind ViewModel.RemovePinCommand}"
                    Content="Remove pin" />
            </StackPanel>
            <ListView
                x:Name="LstRoomSections"
                Grid.Row="1"
                AutomationProperties.AutomationId="LstRoomSections"
                ItemsSource="{x:Bind ViewModel.Sections, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:RoomSection">
                        <StackPanel Margin="0,0,0,16" Spacing="8">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Title, Mode=OneWay}" />
                            <GridView
                                AllowDrop="True"
                                CanDragItems="True"
                                CanReorderItems="True"
                                ItemsSource="{x:Bind Items, Mode=OneWay}"
                                SelectionMode="Single">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="models:AssetItem">
                                        <Grid Width="140" Height="180">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                CornerRadius="{StaticResource ControlCornerRadius}">
                                                <Image
                                                    Stretch="UniformToFill"
                                                    Source="{x:Bind pages:LibraryPage.FileToImage(ThumbPath), Mode=OneWay}" />
                                            </Border>
                                            <StackPanel Grid.Row="1" Spacing="4">
                                                <TextBlock
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind FileName, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <Button
                                                    AutomationProperties.Name="Remove pin"
                                                    Command="{x:Bind pages:RoomsPage.GetRemovePinCommand()}"
                                                    CommandParameter="{x:Bind}"
                                                    Content="Remove" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <TextBlock
            Grid.Row="2"
            Grid.ColumnSpan="2"
            AutomationProperties.AutomationId="TxtRoomsStatus"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
    </Grid>
</Page>
