<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Palace.Pages.TagsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Palace.Helpers"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Palace.Controls"
    xmlns:models="using:Palace.Models"
    xmlns:pages="using:Palace.Pages"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
    <Grid
        Padding="16"
        ColumnSpacing="16"
        IsHitTestVisible="{x:Bind helpers:BindHelpers.Not(ViewModel.IsGalleryOverlayOpen), Mode=OneWay}"
        RowSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Tags" />
        <ProgressBar
            x:Name="PrgTags"
            Grid.Column="2"
            Height="4"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="PrgTags"
            AutomationProperties.Name="Tags loading"
            IsIndeterminate="True"
            ShowPaused="False"
            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.IsBusy), Mode=OneWay}" />

        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <AutoSuggestBox
                x:Name="AsbTagSearch"
                AutomationProperties.AutomationId="AsbTagSearch"
                PlaceholderText="Search tags or groups"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ScrollViewer
                Grid.Row="1"
                AutomationProperties.AutomationId="SelTagScope"
                AutomationProperties.Name="Tag scope"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl
                    x:Name="RepTagBoard"
                    AutomationProperties.AutomationId="RepTagBoard"
                    AutomationProperties.Name="Tag groups"
                    ItemsSource="{x:Bind ViewModel.Board, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:TagBoardGroup">
                            <Button
                                Margin="0,0,0,4"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="{x:Bind helpers:BindHelpers.SelectedBorder(IsExpanded), Mode=OneWay}"
                                Click="TagGroupHeader_Click"
                                Tag="{x:Bind}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border
                                        Width="12"
                                        Height="12"
                                        Background="{x:Bind helpers:TagColor.ChipFill(Color), Mode=OneWay}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2" />
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind CountLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="TxtTagChildrenHeader"
                AutomationProperties.AutomationId="TxtTagChildrenHeader"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.ChildrenHeader, Mode=OneWay}" />
            <ScrollViewer
                Grid.Row="1"
                AutomationProperties.AutomationId="RepTagChildren"
                AutomationProperties.Name="Tags in selected group"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl
                    ItemsSource="{x:Bind ViewModel.SelectedBoard.Letters, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:TagLetterSection">
                            <StackPanel Margin="0,0,0,8" Spacing="6">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Header, Mode=OneWay}" />
                                <ItemsRepeater
                                    HorizontalAlignment="Left"
                                    ItemsSource="{x:Bind Chips, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <helpers:ChipWrapLayout
                                            HorizontalSpacing="6"
                                            VerticalSpacing="6" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:TagChipItem">
                                            <Button
                                                MinWidth="0"
                                                MinHeight="0"
                                                Padding="0"
                                                HorizontalAlignment="Left"
                                                HorizontalContentAlignment="Left"
                                                VerticalAlignment="Top"
                                                Background="{ThemeResource ControlFillColorTransparentBrush}"
                                                BorderThickness="0"
                                                AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                                Click="TagChip_Click"
                                                Tag="{x:Bind}">
                                                <Button.ContextFlyout>
                                                    <MenuFlyout Opening="TagChipMenu_Opening">
                                                        <MenuFlyoutItem
                                                            AutomationProperties.AutomationId="MnuFilterTag"
                                                            Command="{x:Bind pages:TagsPage.GetFilterChipCommand()}"
                                                            CommandParameter="{x:Bind}"
                                                            Text="Filter in Library">
                                                            <MenuFlyoutItem.Icon>
                                                                <ic:FluentIcon Icon="Filter" IconSize="Size16" IconVariant="Regular" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem
                                                            Command="{x:Bind pages:TagsPage.GetStarChipCommand()}"
                                                            CommandParameter="{x:Bind}"
                                                            Text="Add to starred"
                                                            Visibility="{x:Bind helpers:BindHelpers.InvertBoolToVisibility(IsStarred), Mode=OneWay}">
                                                            <MenuFlyoutItem.Icon>
                                                                <ic:FluentIcon Icon="Star" IconSize="Size16" IconVariant="Regular" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem
                                                            Command="{x:Bind pages:TagsPage.GetStarChipCommand()}"
                                                            CommandParameter="{x:Bind}"
                                                            Text="Remove from starred"
                                                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsStarred), Mode=OneWay}">
                                                            <MenuFlyoutItem.Icon>
                                                                <ic:FluentIcon Icon="Star" IconSize="Size16" IconVariant="Regular" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem
                                                            AutomationProperties.AutomationId="MnuRenameTag"
                                                            Command="{x:Bind pages:TagsPage.GetRenameChipCommand()}"
                                                            CommandParameter="{x:Bind}"
                                                            Text="Rename">
                                                            <MenuFlyoutItem.Icon>
                                                                <ic:FluentIcon Icon="Rename" IconSize="Size16" IconVariant="Regular" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSubItem
                                                            Tag="add"
                                                            Text="Add to group">
                                                            <MenuFlyoutSubItem.Icon>
                                                                <ic:FluentIcon Icon="FolderAdd" IconSize="Size16" IconVariant="Regular" />
                                                            </MenuFlyoutSubItem.Icon>
                                                            <MenuFlyoutItem IsEnabled="False" Text="No other groups" />
                                                        </MenuFlyoutSubItem>
                                                        <MenuFlyoutSubItem
                                                            Tag="move"
                                                            Text="Move to group"
                                                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(CanRemoveFromGroup), Mode=OneWay}">
                                                            <MenuFlyoutSubItem.Icon>
                                                                <ic:FluentIcon Icon="FolderArrowRight" IconSize="Size16" IconVariant="Regular" />
                                                            </MenuFlyoutSubItem.Icon>
                                                            <MenuFlyoutItem IsEnabled="False" Text="No other groups" />
                                                        </MenuFlyoutSubItem>
                                                        <MenuFlyoutItem
                                                            Command="{x:Bind pages:TagsPage.GetRemoveChipFromGroupCommand()}"
                                                            CommandParameter="{x:Bind}"
                                                            Text="Remove from this group"
                                                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(CanRemoveFromGroup), Mode=OneWay}">
                                                            <MenuFlyoutItem.Icon>
                                                                <ic:FluentIcon Icon="Folder" IconSize="Size16" IconVariant="Regular" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem
                                                            Command="{x:Bind pages:TagsPage.GetDeleteChipCommand()}"
                                                            CommandParameter="{x:Bind}"
                                                            Text="Delete tag">
                                                            <MenuFlyoutItem.Icon>
                                                                <ic:FluentIcon Icon="Delete" IconSize="Size16" IconVariant="Regular" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.ContextFlyout>
                                                <Border
                                                    Padding="10,4"
                                                    Background="{x:Bind helpers:TagColor.ChipFill(EffectiveColor), Mode=OneWay}"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Foreground="{x:Bind helpers:TagColor.ChipInk(EffectiveColor), Mode=OneWay}"
                                                            Text="{x:Bind Name, Mode=OneWay}"
                                                            TextWrapping="NoWrap" />
                                                        <ic:FluentIcon
                                                            VerticalAlignment="Center"
                                                            Foreground="{x:Bind helpers:TagColor.ChipInk(EffectiveColor), Mode=OneWay}"
                                                            Icon="Star"
                                                            IconSize="Size12"
                                                            IconVariant="Regular"
                                                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsStarred), Mode=OneWay}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Foreground="{x:Bind helpers:TagColor.ChipInk(EffectiveColor), Mode=OneWay}"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="On"
                                                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsFilterSelected), Mode=OneWay}" />
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBox
                x:Name="TxtNewTagName"
                Grid.Row="2"
                AcceptsReturn="True"
                AutomationProperties.AutomationId="TxtNewTagName"
                Header="New tag"
                PlaceholderText="character, clothing, shot"
                Text="{x:Bind ViewModel.NewTagName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
            <StackPanel Grid.Row="3" Spacing="8">
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    AutomationProperties.AutomationId="BtnCreateUngroupedTag"
                    Command="{x:Bind ViewModel.CreateUngroupedCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="Add" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock VerticalAlignment="Center" Text="Create ungrouped" />
                    </StackPanel>
                </Button>
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    AutomationProperties.AutomationId="BtnCreateChildTag"
                    Command="{x:Bind ViewModel.CreateChildCommand}"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="Organization" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock VerticalAlignment="Center" Text="Nest under selected" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ToggleButton
                    x:Name="TglTagSelectMode"
                    AutomationProperties.AutomationId="TglTagSelectMode"
                    AutomationProperties.Name="Select"
                    IsChecked="{x:Bind ViewModel.IsSelectMode, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="Multiselect" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock VerticalAlignment="Center" Text="Select" />
                    </StackPanel>
                </ToggleButton>
                <TextBlock
                    x:Name="TxtTagSelectionCount"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="TxtTagSelectionCount"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" />
            </StackPanel>
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="TxtTagAssetCount"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="TxtTagAssetCount"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.AssetCountLabel, Mode=OneWay}" />
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ic:FluentIcon
                        VerticalAlignment="Center"
                        Icon="ArrowSort"
                        IconSize="Size16"
                        IconVariant="Regular" />
                    <ComboBox
                        x:Name="CmbTagMosaicSort"
                        MinWidth="168"
                        AutomationProperties.AutomationId="CmbTagMosaicSort"
                        AutomationProperties.Name="Sort"
                        Header="Sort"
                        ItemsSource="{x:Bind ViewModel.SortLabels, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.MosaicSortIndex, Mode=OneWay}"
                        SelectionChanged="CmbTagMosaicSort_SelectionChanged" />
                </StackPanel>
            </Grid>
            <ScrollViewer
                x:Name="GrdTagAssets"
                Grid.Row="2"
                AutomationProperties.AutomationId="GrdTagAssets"
                AutomationProperties.Name="Tagged images"
                IsHoldingEnabled="True"
                IsTabStop="True"
                PreviewKeyDown="GrdTagAssets_KeyDown"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl
                    x:Name="RepTagMosaic"
                    AutomationProperties.AutomationId="RepTagMosaic"
                    AutomationProperties.Name="Tag path groups"
                    ItemsSource="{x:Bind ViewModel.MosaicGroups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:TagMosaicSection">
                            <StackPanel Margin="0,0,0,16" Spacing="8">
                                <TextBlock
                                    AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind CountLabel, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <ItemsRepeater ItemsSource="{x:Bind Assets, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            ItemsStretch="Fill"
                                            MinColumnSpacing="8"
                                            MinItemHeight="140"
                                            MinItemWidth="148"
                                            MinRowSpacing="8" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:AssetItem">
                                            <Grid
                                                Width="148"
                                                Height="140"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                AutomationProperties.Name="{x:Bind FileName, Mode=OneWay}"
                                                DoubleTapped="TagAsset_DoubleTapped"
                                                GotFocus="TagAsset_GotFocus"
                                                IsDoubleTapEnabled="True"
                                                IsHoldingEnabled="True"
                                                IsTabStop="True"
                                                Holding="GrdTagAssets_RangeHolding"
                                                PointerPressed="TagAsset_RangePressed"
                                                RightTapped="TagAsset_RightTapped"
                                                Tag="{x:Bind Id, Mode=OneWay}"
                                                Tapped="TagAsset_Tapped"
                                                UseSystemFocusVisuals="True">
                                                <Grid.ContextFlyout>
                                                    <MenuFlyout Opening="TagAssetMenu_Opening">
                                                        <MenuFlyoutItem
                                                            AutomationProperties.AutomationId="MnuTagOpen"
                                                            Command="{x:Bind pages:TagsPage.GetOpenAssetCommand()}"
                                                            CommandParameter="{x:Bind}"
                                                            Text="Open">
                                                            <MenuFlyoutItem.Icon>
                                                                <ic:FluentIcon Icon="Open" IconSize="Size16" IconVariant="Regular" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Grid.ContextFlyout>
                                                <Image
                                                    DataContextChanged="TagTileImage_DataContextChanged"
                                                    DoubleTapped="TagAsset_DoubleTapped"
                                                    IsDoubleTapEnabled="True"
                                                    Loaded="TagTileImage_Loaded"
                                                    Source="{x:Bind ThumbImage, Mode=OneWay}"
                                                    Stretch="UniformToFill"
                                                    Tag="{x:Bind Id, Mode=OneWay}"
                                                    Unloaded="TagTileImage_Unloaded" />
                                                <StackPanel
                                                    Margin="8"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsHitTestVisible="False"
                                                    Spacing="4"
                                                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ShowCloudTile), Mode=OneWay}">
                                                    <ic:FluentIcon
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Icon="{x:Bind helpers:FluentGlyph.Placeholder(Kind), Mode=OneWay}"
                                                        IconSize="Size32"
                                                        IconVariant="Regular" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="Online" />
                                                </StackPanel>
                                                <StackPanel
                                                    Margin="6"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    IsHitTestVisible="False"
                                                    Orientation="Horizontal"
                                                    Spacing="4">
                                                    <Border
                                                        Padding="4"
                                                        AutomationProperties.AutomationId="{x:Bind VideoBadgeAutomationId, Mode=OneWay}"
                                                        AutomationProperties.Name="Video"
                                                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                                        CornerRadius="4"
                                                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ShowVideoBadge), Mode=OneWay}">
                                                        <ic:FluentIcon
                                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                            Icon="Video"
                                                            IconSize="Size16"
                                                            IconVariant="Regular" />
                                                    </Border>
                                                    <Border
                                                        Padding="4"
                                                        AutomationProperties.AutomationId="{x:Bind GifBadgeAutomationId, Mode=OneWay}"
                                                        AutomationProperties.Name="GIF"
                                                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                                        CornerRadius="4"
                                                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ShowGifBadge), Mode=OneWay}">
                                                        <ic:FluentIcon
                                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                            Icon="Gif"
                                                            IconSize="Size16"
                                                            IconVariant="Regular" />
                                                    </Border>
                                                    <Border
                                                        Padding="8,5"
                                                        AutomationProperties.AutomationId="{x:Bind HdrBadgeAutomationId, Mode=OneWay}"
                                                        AutomationProperties.Name="HDR"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="4"
                                                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ShowHdrBadge), Mode=OneWay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <ic:FluentIcon
                                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                                Icon="Hdr"
                                                                IconSize="Size24"
                                                                IconVariant="Regular" />
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Text="HDR" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <Border
                                                    Margin="6"
                                                    Padding="4"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    AutomationProperties.AutomationId="{x:Bind CloudBadgeAutomationId, Mode=OneWay}"
                                                    AutomationProperties.Name="Cloud"
                                                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                                    CornerRadius="4"
                                                    IsHitTestVisible="False"
                                                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ShowCloudBadge), Mode=OneWay}">
                                                    <ic:FluentIcon
                                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                        Icon="Cloud"
                                                        IconSize="Size16"
                                                        IconVariant="Regular" />
                                                </Border>
                                                <Border
                                                    Margin="6"
                                                    Padding="2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="4"
                                                    IsHitTestVisible="False"
                                                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsSelected), Mode=OneWay}">
                                                    <ic:FluentIcon
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                        Icon="Checkmark"
                                                        IconSize="Size16"
                                                        IconVariant="Regular" />
                                                </Border>
                                                <Border
                                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                    BorderThickness="2"
                                                    IsHitTestVisible="False"
                                                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsSelected), Mode=OneWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Grid.Column="3"
            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowDetails), Mode=OneWay}">
            <StackPanel x:Name="FlyTagDetails" Spacing="12">
                <TextBox
                    x:Name="TxtRenameTag"
                    AutomationProperties.AutomationId="TxtRenameTag"
                    Header="Name"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                    Text="{x:Bind ViewModel.SelectedName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <NumberBox
                    x:Name="NbTagPriority"
                    AutomationProperties.AutomationId="NbTagPriority"
                    Header="Priority"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                    Minimum="0"
                    SpinButtonPlacementMode="Inline"
                    Value="{x:Bind ViewModel.SelectedPriority, Mode=TwoWay}" />
                <Button
                    AutomationProperties.AutomationId="BtnSaveTag"
                    Command="{x:Bind ViewModel.SaveRenameCommand}"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="Save" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock VerticalAlignment="Center" Text="Save name" />
                    </StackPanel>
                </Button>
                <ToggleSwitch
                    x:Name="TglStarTag"
                    AutomationProperties.AutomationId="TglStarTag"
                    Header="Starred"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                    IsOn="{x:Bind ViewModel.SelectedIsStarred, Mode=OneWay}"
                    Toggled="TglStarTag_Toggled" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        AutomationProperties.AutomationId="BtnTagMoveUp"
                        Command="{x:Bind ViewModel.MoveUpCommand}"
                        IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:FluentIcon Icon="ArrowUp" IconSize="Size16" IconVariant="Regular" />
                            <TextBlock VerticalAlignment="Center" Text="Move up" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.AutomationId="BtnTagMoveDown"
                        Command="{x:Bind ViewModel.MoveDownCommand}"
                        IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:FluentIcon Icon="ArrowDown" IconSize="Size16" IconVariant="Regular" />
                            <TextBlock VerticalAlignment="Center" Text="Move down" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button
                    AutomationProperties.AutomationId="BtnDeleteTag"
                    Command="{x:Bind ViewModel.DeleteTagCommand}"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="Delete" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock VerticalAlignment="Center" Text="Delete tag" />
                    </StackPanel>
                </Button>

                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Color" />
                <TextBlock
                    x:Name="TxtTagColorSource"
                    AutomationProperties.AutomationId="TxtTagColorSource"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.SelectedColorLabel, Mode=OneWay}" />
                <Button
                    x:Name="BtnTagColor"
                    AutomationProperties.AutomationId="BtnTagColor"
                    AutomationProperties.Name="Tag color"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            Width="16"
                            Height="16"
                            Background="{x:Bind helpers:TagColor.ChipFill(ViewModel.SelectedEffectiveColor), Mode=OneWay}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlCornerRadius}" />
                        <TextBlock Text="Choose color" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Closed="TagColorFlyout_Closed" Opening="TagColorFlyout_Opening">
                            <StackPanel Spacing="12">
                                <ColorPicker
                                    x:Name="PkrTagColor"
                                    AutomationProperties.AutomationId="PkrTagColor"
                                    AutomationProperties.Name="Tag color picker"
                                    IsAlphaEnabled="True"
                                    IsHexInputVisible="True"
                                    ColorChanged="PkrTagColor_ColorChanged" />
                                <Button
                                    x:Name="BtnClearTagColor"
                                    AutomationProperties.AutomationId="BtnClearTagColor"
                                    Click="BtnClearTagColor_Click"
                                    Content="Clear color"
                                    IsEnabled="{x:Bind ViewModel.HasCustomColor, Mode=OneWay}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Groups this tag belongs to" />
                <ListView
                    x:Name="LstTagGroups"
                    AutomationProperties.AutomationId="LstTagGroups"
                    Header="Memberships"
                    ItemsSource="{x:Bind ViewModel.ParentGroups, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:TagGroupPick">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Name, Mode=OneWay}" />
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.Name="Remove from group"
                                    Command="{x:Bind pages:TagsPage.GetRemoveGroupCommand()}"
                                    CommandParameter="{x:Bind}"
                                    Content="Remove" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ComboBox
                    x:Name="CmbAddGroup"
                    AutomationProperties.AutomationId="CmbAddGroup"
                    DisplayMemberPath="Name"
                    Header="Add to another group"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.AvailableGroups, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedAvailableGroup, Mode=TwoWay}" />
                <Button
                    AutomationProperties.AutomationId="BtnAddGroup"
                    Command="{x:Bind ViewModel.AddToGroupCommand}"
                    Content="Add to group"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />

                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Implicit tags" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="When this tag is assigned, these tags are applied too. Removing this tag does not remove an implied tag that was also assigned directly."
                    TextWrapping="Wrap" />
                <TextBlock
                    AutomationProperties.AutomationId="TxtImpliedTags"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.ImpliedTagsSummary, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <ListView
                    x:Name="LstImpliedTags"
                    AutomationProperties.AutomationId="LstImpliedTags"
                    Header="Also applied"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.ImpliedTags, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:TagGroupPick">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Name, Mode=OneWay}" />
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.Name="Remove implicit tag"
                                    Command="{x:Bind pages:TagsPage.GetRemoveImpliedCommand()}"
                                    CommandParameter="{x:Bind}"
                                    Content="Remove" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <AutoSuggestBox
                    x:Name="AsbAddImplied"
                    AutomationProperties.AutomationId="AsbAddImplied"
                    Header="Add implicit tag"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.ImpliedSuggestions, Mode=OneWay}"
                    PlaceholderText="Type a tag name"
                    QuerySubmitted="AsbAddImplied_QuerySubmitted"
                    SuggestionChosen="AsbAddImplied_SuggestionChosen"
                    TextChanged="AsbAddImplied_TextChanged"
                    Text="{x:Bind ViewModel.ImpliedQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextMemberPath="Name"
                    UpdateTextOnSelect="True">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="models:TagGroupPick">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
                <Button
                    AutomationProperties.AutomationId="BtnAddImplied"
                    Command="{x:Bind ViewModel.AddImpliedCommand}"
                    Content="Add implicit tag"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />

                <ToggleSwitch
                    x:Name="TglIncludeNested"
                    AutomationProperties.AutomationId="TglIncludeNested"
                    Header="Include nested tags when organizing"
                    IsOn="{x:Bind ViewModel.IncludeNested, Mode=TwoWay}" />
                <Button
                    AutomationProperties.AutomationId="BtnOrganizeByTag"
                    Command="{x:Bind ViewModel.PreviewOrganizeCommand}"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="FolderArrowRight" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock VerticalAlignment="Center" Text="Organize images into a folder" />
                    </StackPanel>
                </Button>

                <StackPanel
                    Spacing="8"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.ShowOrganizePanel), Mode=OneWay}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Organize preview" />
                    <ListView
                        x:Name="LstTagOrganizePreview"
                        MaxHeight="240"
                        AutomationProperties.AutomationId="LstTagOrganizePreview"
                        ItemsSource="{x:Bind ViewModel.OrganizePreview, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:OrganizePreviewItem">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind FileName, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind NewPath, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Status, Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button
                        AutomationProperties.AutomationId="BtnApplyTagOrganize"
                        Command="{x:Bind ViewModel.ApplyOrganizeCommand}"
                        Content="Apply organize" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Spacing="4">
            <TextBlock
                x:Name="TxtBackfillStatus"
                AutomationProperties.AutomationId="TxtBackfillStatus"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.BackfillStatus, Mode=OneWay}" />
            <TextBlock
                x:Name="TxtTagsStatus"
                AutomationProperties.AutomationId="TxtTagsStatus"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        </StackPanel>
    </Grid>

        <Grid
            x:Name="GrdGalleryOverlay"
            AutomationProperties.AutomationId="GrdGalleryOverlay"
            AutomationProperties.Name="Gallery overlay"
            Canvas.ZIndex="1"
            IsTabStop="True"
            PreviewKeyDown="GalleryOverlay_PreviewKeyDown"
            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.IsGalleryOverlayOpen), Mode=OneWay}">
            <Grid
                x:Name="GrdGalleryBackdrop"
                AutomationProperties.AutomationId="GrdGalleryBackdrop"
                PointerPressed="GalleryOverlay_BackdropPressed">
                <Grid Background="{StaticResource GalleryOverlayBackdropBrush}" />
                <Border
                    Background="{ThemeResource SmokeFillColorDefaultBrush}"
                    IsHitTestVisible="False"
                    Opacity="0.28" />
            </Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <controls:GalleryStillSurface
                        x:Name="SrfOverlayStill"
                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.IsImage), Mode=OneWay, FallbackValue=Collapsed}" />
                    <MediaPlayerElement
                        x:Name="MpeOverlay"
                        AreTransportControlsEnabled="True"
                        AutoPlay="False"
                        AutomationProperties.AutomationId="MpeGalleryOverlay"
                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.IsVideo), Mode=OneWay, FallbackValue=Collapsed}" />
                    <Button
                        x:Name="BtnGalleryPlay"
                        MinWidth="72"
                        MinHeight="72"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="BtnGalleryPlay"
                        AutomationProperties.Name="Play"
                        Click="BtnGalleryPlay_Click"
                        ToolTipService.ToolTip="Play"
                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.IsVideo), Mode=OneWay, FallbackValue=Collapsed}">
                        <ic:FluentIcon Icon="Play" IconSize="Size32" IconVariant="Regular" />
                    </Button>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Missing"
                        Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.IsMissing), Mode=OneWay, FallbackValue=Collapsed}" />
                    <StackPanel
                        Margin="16,16,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Spacing="8">
                        <Border
                            Padding="6,4"
                            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource OverlayCornerRadius}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ToggleButton
                                x:Name="BtnGalleryImageInfo"
                                Padding="8,4"
                                AutomationProperties.AutomationId="BtnGalleryImageInfo"
                                AutomationProperties.Name="Image information"
                                IsChecked="{x:Bind ViewModel.OverlayGallery.ShowImageInfo, Mode=TwoWay, FallbackValue=False}"
                                ToolTipService.ToolTip="Image information (Ctrl+D)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:FluentIcon Icon="Info" IconSize="Size16" IconVariant="Regular" />
                                    <TextBlock VerticalAlignment="Center" Text="Info" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton
                                x:Name="BtnGalleryDetails"
                                Padding="8,4"
                                AutomationProperties.AutomationId="BtnGalleryDetails"
                                AutomationProperties.Name="Details"
                                IsChecked="{x:Bind ViewModel.OverlayGallery.ShowDetails, Mode=TwoWay, FallbackValue=False}"
                                ToolTipService.ToolTip="Details (Ctrl+I)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:FluentIcon Icon="TextDescription" IconSize="Size16" IconVariant="Regular" />
                                    <TextBlock VerticalAlignment="Center" Text="Details" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton
                                x:Name="BtnGalleryLoop"
                                Padding="8,4"
                                AutomationProperties.AutomationId="BtnGalleryLoop"
                                AutomationProperties.Name="Loop video"
                                IsChecked="{x:Bind ViewModel.OverlayGallery.LoopVideo, Mode=TwoWay, FallbackValue=True}"
                                ToolTipService.ToolTip="Loop video"
                                Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.IsVideo), Mode=OneWay, FallbackValue=Collapsed}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:FluentIcon Icon="ArrowRepeatAll" IconSize="Size16" IconVariant="Regular" />
                                    <TextBlock VerticalAlignment="Center" Text="Loop" />
                                </StackPanel>
                            </ToggleButton>
                            <Button
                                x:Name="BtnGalleryScaleActual"
                                Padding="8,4"
                                AutomationProperties.AutomationId="BtnGalleryScaleActual"
                                AutomationProperties.Name="Actual size"
                                Command="{x:Bind ViewModel.OverlayGallery.SetScaleActualCommand, Mode=OneWay, FallbackValue={x:Null}}"
                                IsEnabled="{x:Bind ViewModel.OverlayGallery.CanScale, Mode=OneWay, FallbackValue=True}"
                                ToolTipService.ToolTip="1:1 (Ctrl+1)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:FluentIcon Icon="RatioOneToOne" IconSize="Size16" IconVariant="Regular" />
                                    <TextBlock VerticalAlignment="Center" Text="1:1" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="BtnGalleryScaleFit"
                                Padding="8,4"
                                AutomationProperties.AutomationId="BtnGalleryScaleFit"
                                AutomationProperties.Name="Fit"
                                Command="{x:Bind ViewModel.OverlayGallery.SetScaleFitCommand, Mode=OneWay, FallbackValue={x:Null}}"
                                IsEnabled="{x:Bind ViewModel.OverlayGallery.CanScale, Mode=OneWay, FallbackValue=True}"
                                ToolTipService.ToolTip="Fit (Ctrl+2)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:FluentIcon Icon="ArrowFit" IconSize="Size16" IconVariant="Regular" />
                                    <TextBlock VerticalAlignment="Center" Text="Fit" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="BtnGalleryScaleFill"
                                Padding="8,4"
                                AutomationProperties.AutomationId="BtnGalleryScaleFill"
                                AutomationProperties.Name="Fill"
                                Command="{x:Bind ViewModel.OverlayGallery.SetScaleFillCommand, Mode=OneWay, FallbackValue={x:Null}}"
                                IsEnabled="{x:Bind ViewModel.OverlayGallery.CanScale, Mode=OneWay, FallbackValue=True}"
                                ToolTipService.ToolTip="Fill (Ctrl+3)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:FluentIcon Icon="ArrowMaximize" IconSize="Size16" IconVariant="Regular" />
                                    <TextBlock VerticalAlignment="Center" Text="Fill" />
                                </StackPanel>
                            </Button>
<Border
                                Padding="8,5"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="IcnGalleryOverlayHdr"
                                AutomationProperties.Name="HDR"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="4"
                                IsHitTestVisible="False"
                                Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.ShowHdrBadge), Mode=OneWay, FallbackValue=Collapsed}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ic:FluentIcon
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Icon="Hdr"
                                        IconSize="Size24"
                                        IconVariant="Regular" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="HDR" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </Border>
                        <Border
                            x:Name="BrdGalleryImageInfo"
                            MaxWidth="360"
                            Padding="10,6"
                            AutomationProperties.AutomationId="BrdGalleryImageInfo"
                            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource OverlayCornerRadius}"
                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.ShowImageInfo), Mode=OneWay, FallbackValue=Collapsed}">
                            <TextBlock
                                AutomationProperties.AutomationId="TxtGalleryImageInfo"
                                AutomationProperties.Name="Image information"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.OverlayGallery.ImageInfoText, Mode=OneWay, FallbackValue=''}"
                                TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                    <Button
                        x:Name="BtnGalleryPrev"
                        MinWidth="48"
                        MinHeight="48"
                        Margin="16,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="BtnGalleryPrev"
                        AutomationProperties.Name="Previous"
                        Command="{x:Bind ViewModel.OverlayGallery.GoPreviousCommand, Mode=OneWay, FallbackValue={x:Null}}"
                        IsEnabled="{x:Bind ViewModel.OverlayGallery.CanGoPrevious, Mode=OneWay, FallbackValue=False}"
                        ToolTipService.ToolTip="Previous">
                        <ic:FluentIcon Icon="ChevronLeft" IconSize="Size20" IconVariant="Regular" />
                    </Button>
                    <Button
                        x:Name="BtnGalleryNext"
                        MinWidth="48"
                        MinHeight="48"
                        Margin="0,0,16,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="BtnGalleryNext"
                        AutomationProperties.Name="Next"
                        Command="{x:Bind ViewModel.OverlayGallery.GoNextCommand, Mode=OneWay, FallbackValue={x:Null}}"
                        IsEnabled="{x:Bind ViewModel.OverlayGallery.CanGoNext, Mode=OneWay, FallbackValue=False}"
                        ToolTipService.ToolTip="Next">
                        <ic:FluentIcon Icon="ChevronRight" IconSize="Size20" IconVariant="Regular" />
                    </Button>
                    <Button
                        x:Name="BtnGalleryClose"
                        MinWidth="48"
                        MinHeight="48"
                        Margin="0,16,16,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="BtnGalleryClose"
                        AutomationProperties.Name="Close"
                        Command="{x:Bind ViewModel.CloseOverlayCommand}"
                        ToolTipService.ToolTip="Close">
                        <ic:FluentIcon Icon="Dismiss" IconSize="Size20" IconVariant="Regular" />
                    </Button>
                </Grid>
                <Border
                    x:Name="BrdGalleryOverlayInfo"
                    Grid.Row="1"
                    MaxWidth="920"
                    MinWidth="280"
                    Margin="16,8,16,12"
                    Padding="10,6"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="BrdGalleryOverlayInfo"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.ShowDetails), Mode=OneWay, FallbackValue=Collapsed}">
                    <StackPanel Spacing="4">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                MaxWidth="280"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="TxtGalleryOverlayTitle"
                                AutomationProperties.Name="Gallery title"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.OverlayGallery.Title, Mode=OneWay, FallbackValue=''}"
                                TextTrimming="CharacterEllipsis" />
                            <ItemsRepeater
                                x:Name="LstGalleryOverlayTags"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="LstGalleryOverlayTags"
                                AutomationProperties.Name="Tags"
                                ItemsSource="{x:Bind ViewModel.OverlayGallery.Tags, Mode=OneWay, FallbackValue={x:Null}}">
                                <ItemsRepeater.Layout>
                                    <helpers:ChipWrapLayout HorizontalSpacing="6" VerticalSpacing="4" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:AssignedTagItem">
                                        <Border
                                            MinWidth="0"
                                            Padding="6,2"
                                            HorizontalAlignment="Left"
                                            Background="{x:Bind helpers:TagColor.ChipFill(EffectiveColor), Mode=OneWay}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            Opacity="{x:Bind ChromeOpacity, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ChipTooltip, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock
                                                    Foreground="{x:Bind helpers:TagColor.ChipInk(EffectiveColor), Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind TagName, Mode=OneWay}" />
                                                <TextBlock
                                                    Foreground="{x:Bind helpers:TagColor.ChipInk(EffectiveColor), Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind CountLabel, Mode=OneWay}"
                                                    Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(IsPartial), Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                AutomationProperties.AutomationId="TxtGalleryOverlayPosition"
                                AutomationProperties.Name="Gallery position"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.OverlayGallery.PositionLabel, Mode=OneWay, FallbackValue=''}" />
                            <TextBlock
                                AutomationProperties.AutomationId="TxtGalleryOverlayDetails"
                                AutomationProperties.Name="Image details"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.OverlayGallery.DetailsText, Mode=OneWay, FallbackValue=''}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(ViewModel.OverlayGallery.DetailsText), Mode=OneWay, FallbackValue=Collapsed}" />
                            <TextBlock
                                AutomationProperties.AutomationId="TxtGalleryOverlayHdr"
                                AutomationProperties.Name="HDR status"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.OverlayGallery.HdrStatus, Mode=OneWay, FallbackValue=''}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind helpers:BindHelpers.StringToVisibility(ViewModel.OverlayGallery.HdrStatus), Mode=OneWay, FallbackValue=Collapsed}" />
                        </StackPanel>
                        <StackPanel
                            AutomationProperties.AutomationId="PnlOverlayGeneration"
                            Spacing="4"
                            Visibility="{x:Bind helpers:BindHelpers.BoolToVisibility(ViewModel.OverlayGallery.ShowGeneration), Mode=OneWay, FallbackValue=Collapsed}">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Generation" />
                            <TextBlock
                                AutomationProperties.AutomationId="TxtOverlayModel"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.OverlayGallery.PreviewModel), Mode=OneWay, FallbackValue=''}"
                                TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Prompt" />
                            <ScrollViewer
                                AutomationProperties.AutomationId="ScrOverlayPrompt"
                                MaxHeight="120"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <TextBlock
                                    AutomationProperties.AutomationId="TxtOverlayPrompt"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.OverlayGallery.PreviewPrompt), Mode=OneWay, FallbackValue=''}"
                                    TextWrapping="Wrap" />
                            </ScrollViewer>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Negative" />
                            <ScrollViewer
                                AutomationProperties.AutomationId="ScrOverlayNegative"
                                MaxHeight="80"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.OverlayGallery.PreviewNegative), Mode=OneWay, FallbackValue=''}"
                                    TextWrapping="Wrap" />
                            </ScrollViewer>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Seed" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind helpers:BindHelpers.OrDash(ViewModel.OverlayGallery.PreviewSeed), Mode=OneWay, FallbackValue=''}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
