<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Palace.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="using:Palace.Resources">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <res:RoomTemplates />
            </ResourceDictionary.MergedDictionaries>
            <AcrylicBrush
                x:Key="GalleryOverlayBackdropBrush"
                FallbackColor="{ThemeResource SmokeFillColorDefault}"
                TintColor="{ThemeResource SolidBackgroundFillColorBase}"
                TintLuminosityOpacity="0.55"
                TintOpacity="0.35" />
            <!-- Wallpaper lives in MainWindow; do not paint a solid content sheet. -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
