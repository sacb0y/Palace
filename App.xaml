<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Palace.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:res="using:Palace.Resources">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                  App ThemeDictionaries must live inside XamlControlsResources.MergedDictionaries
                  or WinUI will ignore SystemAccentColor / Accent*Brush overrides (mui-xaml #4279 / #6394).
                  Use controls: prefix so nested ResourceDictionary stays in the presentation xmlns.
                -->
                <controls:XamlControlsResources>
                    <controls:XamlControlsResources.MergedDictionaries>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <!-- Dark: Default + Dark (WASDK 2.x may resolve either key). -->
                                <ResourceDictionary x:Key="Default">
                                    <AcrylicBrush
                                        x:Key="PalacePaneFillBrush"
                                        FallbackColor="#FF2C2C2C"
                                        TintColor="{ThemeResource SystemAccentColorDark3}"
                                        TintLuminosityOpacity="0.85"
                                        TintOpacity="0.08" />
                                    <AcrylicBrush
                                        x:Key="GalleryOverlayBackdropBrush"
                                        FallbackColor="{ThemeResource SmokeFillColorDefault}"
                                        TintColor="{ThemeResource SolidBackgroundFillColorBase}"
                                        TintLuminosityOpacity="0.55"
                                        TintOpacity="0.35" />
                                    <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="PalacePaneFillBrush" />
                                    <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="PalacePaneFillBrush" />
                                    <!-- Uncolored tag chips: follow theme (same dictionary as pane chrome). -->
                                    <StaticResource x:Key="PalaceTagChipFillBrush" ResourceKey="ControlFillColorDefaultBrush" />
                                    <StaticResource x:Key="PalaceTagChipInkBrush" ResourceKey="TextFillColorPrimaryBrush" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Dark">
                                    <AcrylicBrush
                                        x:Key="PalacePaneFillBrush"
                                        FallbackColor="#FF2C2C2C"
                                        TintColor="{ThemeResource SystemAccentColorDark3}"
                                        TintLuminosityOpacity="0.85"
                                        TintOpacity="0.08" />
                                    <AcrylicBrush
                                        x:Key="GalleryOverlayBackdropBrush"
                                        FallbackColor="{ThemeResource SmokeFillColorDefault}"
                                        TintColor="{ThemeResource SolidBackgroundFillColorBase}"
                                        TintLuminosityOpacity="0.55"
                                        TintOpacity="0.35" />
                                    <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="PalacePaneFillBrush" />
                                    <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="PalacePaneFillBrush" />
                                    <StaticResource x:Key="PalaceTagChipFillBrush" ResourceKey="ControlFillColorDefaultBrush" />
                                    <StaticResource x:Key="PalaceTagChipInkBrush" ResourceKey="TextFillColorPrimaryBrush" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Light">
                                    <AcrylicBrush
                                        x:Key="PalacePaneFillBrush"
                                        FallbackColor="#FFF3F3F3"
                                        TintColor="{ThemeResource SystemAccentColorLight3}"
                                        TintLuminosityOpacity="0.9"
                                        TintOpacity="0.08" />
                                    <AcrylicBrush
                                        x:Key="GalleryOverlayBackdropBrush"
                                        FallbackColor="{ThemeResource SmokeFillColorDefault}"
                                        TintColor="{ThemeResource SolidBackgroundFillColorBase}"
                                        TintLuminosityOpacity="0.55"
                                        TintOpacity="0.35" />
                                    <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="PalacePaneFillBrush" />
                                    <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="PalacePaneFillBrush" />
                                    <StaticResource x:Key="PalaceTagChipFillBrush" ResourceKey="ControlFillColorDefaultBrush" />
                                    <StaticResource x:Key="PalaceTagChipInkBrush" ResourceKey="TextFillColorPrimaryBrush" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="HighContrast">
                                    <StaticResource x:Key="PalacePaneFillBrush" ResourceKey="SystemColorWindowColorBrush" />
                                    <SolidColorBrush x:Key="GalleryOverlayBackdropBrush" Color="{ThemeResource SystemColorWindowColor}" />
                                    <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="SystemColorWindowColorBrush" />
                                    <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="SystemColorWindowColorBrush" />
                                    <StaticResource x:Key="PalaceTagChipFillBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
                                    <StaticResource x:Key="PalaceTagChipInkBrush" ResourceKey="SystemColorButtonTextColorBrush" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                        <res:RoomTemplates />
                    </controls:XamlControlsResources.MergedDictionaries>
                </controls:XamlControlsResources>
            </ResourceDictionary.MergedDictionaries>
            <!-- Wallpaper lives in MainWindow; do not paint a solid content sheet. -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
