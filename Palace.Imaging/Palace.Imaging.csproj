    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Palace.Imaging</RootNamespace>
    <Description>Pure HDR normalize / analyze / tonemap library (no WinUI). P1 of the HDR imaging rewrite.</Description>
