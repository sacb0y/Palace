<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="Palace.Resources.SettingsStyles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <!--
      Compact SettingsCard chrome (Gooey Settings restructure):
      fill #E01C1C1C, 1px #1AFFFFFF border, radius 8. HighContrast keeps ThemeResource.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="PalaceSettingsCardBackgroundBrush" Color="#E01C1C1C" />
            <SolidColorBrush x:Key="PalaceSettingsCardBorderBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="PalaceSettingsNavSelectedBrush" Color="#33FFFFFF" />
            <!-- ~70% pink wash — Release pixel-scans must see this on expander headers. -->
            <SolidColorBrush x:Key="PalaceSettingsSearchHighlightBrush" Color="#B3E05A8C" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PalaceSettingsCardBackgroundBrush" Color="#E01C1C1C" />
            <SolidColorBrush x:Key="PalaceSettingsCardBorderBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="PalaceSettingsNavSelectedBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="PalaceSettingsSearchHighlightBrush" Color="#B3E05A8C" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PalaceSettingsCardBackgroundBrush" Color="#E0F3F3F3" />
            <SolidColorBrush x:Key="PalaceSettingsCardBorderBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="PalaceSettingsNavSelectedBrush" Color="#22000000" />
            <SolidColorBrush x:Key="PalaceSettingsSearchHighlightBrush" Color="#B3E05A8C" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="PalaceSettingsCardBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="PalaceSettingsCardBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="PalaceSettingsNavSelectedBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="PalaceSettingsSearchHighlightBrush" ResourceKey="SystemColorHighlightColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--
      Non-theme fallback for code that cannot resolve ThemeDictionaries
      (e.g. Application.Current.Resources.TryGetValue). Prefer the theme key via
      SettingsPage.ResolveSearchHighlightBrush; never leave highlight a silent no-op.
    -->
    <SolidColorBrush x:Key="PalaceSettingsSearchHighlightBrushFallback" Color="#B3E05A8C" />

    <x:Double x:Key="PalaceSettingsNavWidth">180</x:Double>
    <x:Double x:Key="PalaceSettingsContentCap">1000</x:Double>
    <x:Double x:Key="PalaceSettingsContentCapWindow">1100</x:Double>
    <Thickness x:Key="PalaceSettingsCardSpacing">0,0,0,4</Thickness>
    <CornerRadius x:Key="PalaceSettingsCardCornerRadius">8</CornerRadius>

    <Style x:Key="PalaceSettingsCardStyle" TargetType="controls:SettingsCard">
        <Setter Property="Background" Value="{ThemeResource PalaceSettingsCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PalaceSettingsCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PalaceSettingsCardCornerRadius}" />
        <Setter Property="Margin" Value="{StaticResource PalaceSettingsCardSpacing}" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="PalaceSettingsExpanderStyle" TargetType="controls:SettingsExpander">
        <Setter Property="Background" Value="{ThemeResource PalaceSettingsCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PalaceSettingsCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PalaceSettingsCardCornerRadius}" />
        <Setter Property="Margin" Value="{StaticResource PalaceSettingsCardSpacing}" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="PalaceSettingsGroupHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,12,0,4" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="PalaceSettingsNavItemStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <!-- Pill shape for the accent selection fill. -->
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Read-only keyboard shortcut key chips (Settings → Input). -->
    <Style x:Key="PalaceShortcutKeyChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PalaceSettingsCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="24" />
    </Style>
</ResourceDictionary>
