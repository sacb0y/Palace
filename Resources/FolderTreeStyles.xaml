<?xml version="1.0" encoding="utf-8" ?>
<!--
  Folder-tree icon / count colours from Delete-rejected mockups (dr-01 / dr.py).
  Dark: exact mockup hex. Light: darker AA variants on the pane fill.
-->
<ResourceDictionary
    x:Class="Palace.Resources.FolderTreeStyles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- Dark / Default: mockup fold #E8C66A, rejected #FF99A4. -->
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="FolderTreeFolderBrush" Color="#E8C66A" />
            <SolidColorBrush x:Key="FolderTreeRejectedBrush" Color="#FF99A4" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="FolderTreeFolderBrush" Color="#E8C66A" />
            <SolidColorBrush x:Key="FolderTreeRejectedBrush" Color="#FF99A4" />
        </ResourceDictionary>
        <!-- Light: darker gold / pink so icon + count hit WCAG AA on pane #F3F3F3. -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="FolderTreeFolderBrush" Color="#7A5A10" />
            <SolidColorBrush x:Key="FolderTreeRejectedBrush" Color="#A14165" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="FolderTreeFolderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="FolderTreeRejectedBrush" ResourceKey="SystemColorHotlightColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
