<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Palace</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.0.4</Version>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);Palace.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.*" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FluentIcons.WinUI" Version="2.2.339.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.6.1" />
    <PackageReference Include="Starward.Codec" Version="0.5.2" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties
       Trim (PublishTrimmed) currently crashes on ItemsSource COM wrappers — keep Release
       untrimmed so a packaged Release binary can launch. Re-enable trim only after that
       is fixed; when trim returns, also set SelfContained + WindowsAppSDKSelfContained
       (NETSDK1102 requires self-contained for size optimize). -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

  <!--
    Starward.Codec ships libavif plus JXL/UltraHDR/VP9 natives. Palace uses
    avif.dll (HDR AVIF present) and libjxl (jxl, jxl_cms, jxl_threads,
    brotli*; BSD-3 / MIT) for built-in JPEG XL decode — drop the rest.
  -->
  <PropertyGroup>
    <_PalaceStarwardExtraNatives>uhdr.dll;lcms2.dll;VP9DecoderMFT.dll;avifdec.exe;avifenc.exe;avifgainmaputil.exe;cjxl.exe;djxl.exe;jxlinfo.exe</_PalaceStarwardExtraNatives>
  </PropertyGroup>
  <Target Name="PalaceStripStarwardExtras" AfterTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <_PalaceExtra Include="$(_PalaceStarwardExtraNatives)" />
      <_PalaceDrop Include="$(OutDir)%(_PalaceExtra.Identity)" />
    </ItemGroup>
    <Delete Files="@(_PalaceDrop)" ContinueOnError="true" />
  </Target>
  <Target Name="PalaceStripStarwardFromPublish" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'uhdr.dll' OR '%(Filename)%(Extension)' == 'lcms2.dll' OR '%(Filename)%(Extension)' == 'VP9DecoderMFT.dll' OR '%(Filename)%(Extension)' == 'avifdec.exe' OR '%(Filename)%(Extension)' == 'avifenc.exe' OR '%(Filename)%(Extension)' == 'avifgainmaputil.exe' OR '%(Filename)%(Extension)' == 'cjxl.exe' OR '%(Filename)%(Extension)' == 'djxl.exe' OR '%(Filename)%(Extension)' == 'jxlinfo.exe'" />
    </ItemGroup>
  </Target>

  <!--
    Bundled slim LGPL ffmpeg.exe (static, ~thumbnail-only decoders) for codec-free
    video posters (MKV/WebM/MP4/MOV/AVI; H.264 incl. 4:4:4, HEVC, VP8/9, AV1, MPEG-4).
    Built by tools/build-ffmpeg.sh (.github/workflows/ffmpeg.yml) and published as a
    GitHub release; tools/Get-Ffmpeg.ps1 downloads the pinned asset (SHA-256 checked)
    into ThirdParty/ffmpeg on first build. Packaged as ffmpeg\* with its LGPL notice
    and source offer. Opt out with -p:PalaceBundleFfmpeg=false (shell thumbnails only).
  -->
  <PropertyGroup>
    <PalaceBundleFfmpeg Condition="'$(PalaceBundleFfmpeg)' == ''">true</PalaceBundleFfmpeg>
    <PalaceFfmpegDir>$(MSBuildThisFileDirectory)ThirdParty\ffmpeg\</PalaceFfmpegDir>
  </PropertyGroup>
  <Target Name="PalaceFetchFfmpeg" BeforeTargets="AssignTargetPaths" Condition="'$(PalaceBundleFfmpeg)' == 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)tools\Get-Ffmpeg.ps1&quot;" />
    <ItemGroup>
      <!-- Explicit Links: %(Filename) inside a target would batch over every Content item. -->
      <Content Remove="$(PalaceFfmpegDir)**" />
      <Content Include="$(PalaceFfmpegDir)bin\ffmpeg.exe" Link="ffmpeg\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="$(PalaceFfmpegDir)LICENSE.txt" Link="ffmpeg\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="$(PalaceFfmpegDir)LICENSE-dav1d.txt" Link="ffmpeg\LICENSE-dav1d.txt" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="$(PalaceFfmpegDir)SOURCE.txt" Link="ffmpeg\SOURCE.txt" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!--
    Store submission guard. The Store identity lives only in Package.appxmanifest (see the
    STORE IDENTITY block there). Building with -p:PalaceStoreSubmission=true (the Store
    upload workflow's "store_submission" input) fails while the dev placeholders remain,
    so a placeholder package can never be submitted by accident.
  -->
  <Target Name="PalaceCheckStoreIdentity" BeforeTargets="BeforeBuild" Condition="'$(PalaceStoreSubmission)' == 'true'">
    <PropertyGroup>
      <_PalaceManifestNs>&lt;Namespace Prefix='f' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;</_PalaceManifestNs>
    </PropertyGroup>
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)Package.appxmanifest" Query="/f:Package/f:Identity/@Name" Namespaces="$(_PalaceManifestNs)">
      <Output TaskParameter="Result" PropertyName="_PalaceIdentityName" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)Package.appxmanifest" Query="/f:Package/f:Identity/@Publisher" Namespaces="$(_PalaceManifestNs)">
      <Output TaskParameter="Result" PropertyName="_PalacePublisher" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)Package.appxmanifest" Query="/f:Package/f:Properties/f:PublisherDisplayName/text()" Namespaces="$(_PalaceManifestNs)">
      <Output TaskParameter="Result" PropertyName="_PalacePublisherDisplayName" />
    </XmlPeek>
    <Error Condition="'$(_PalaceIdentityName)' == 'C20A7629-6BDE-449F-958A-5AAF8BCE88F3' or '$(_PalacePublisher)' == 'CN=AppPublisher' or '$(_PalacePublisherDisplayName)' == 'AppPublisher'"
           Text="Package.appxmanifest still has placeholder Store identity (Name=$(_PalaceIdentityName), Publisher=$(_PalacePublisher), PublisherDisplayName=$(_PalacePublisherDisplayName)). Copy the reserved values from Partner Center > Product identity into the STORE IDENTITY block." />
  </Target>
</Project>
